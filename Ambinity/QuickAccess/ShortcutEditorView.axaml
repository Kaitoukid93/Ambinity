<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local = "clr-namespace:Ambinity.QuickAccess"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:DataType="local:ShortcutEditorViewModel"
             x:Class="Ambinity.QuickAccess.ShortcutEditorView">
    <Grid Margin="15" RowDefinitions="Auto,20,*,auto">
        <Grid Row="0" ColumnDefinitions="*,Auto">
            <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding ShortcutViewModel.Name}"></TextBlock>
        </Grid>
        <Grid Grid.Row="2">
            <StackPanel Spacing="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold"></TextBlock>
                    <TextBox Text="{Binding ShortcutViewModel.Name}"></TextBox>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Profile" FontSize="12" FontWeight="SemiBold"></TextBlock>
                   <ui:FAComboBox DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SelectedProfile}" ItemsSource="{Binding AvailableLightingProfiles}" HorizontalAlignment="Stretch">
                      
                   </ui:FAComboBox>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Display icon" FontSize="12" FontWeight="SemiBold"></TextBlock>
                    <Expander MaxHeight="190">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="15">
                                    <PathIcon Data="{Binding ElementName=listIcon,Path=SelectedItem,Converter={StaticResource ResourceConverter}}"></PathIcon>
                                    <TextBlock MaxWidth="200" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource ButtonForegroundDisabled}" FontWeight="SemiBold" Text="{Binding ElementName=listIcon,Path=SelectedItem}"></TextBlock>
                                </StackPanel>
                          
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <ScrollViewer IsScrollInertiaEnabled="True">
                            <ListBox x:Name="listIcon" SelectedItem="{Binding Icon}"  ItemContainerTheme="{DynamicResource _striplessListboxItem}"
                                      Theme="{DynamicResource _striplessListbox}" ItemsSource="{Binding AvailableIcons}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel></WrapPanel>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <PathIcon Width="20" Height="20" Data="{Binding .,Converter={StaticResource ResourceConverter}}"></PathIcon>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Row="3">
            <Button ToolTip.ShowDelay="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Classes="accent" Content="Apply" Command="{Binding ApplySettingsCommand}"></Button>
        </Grid>
    </Grid>
</UserControl>
