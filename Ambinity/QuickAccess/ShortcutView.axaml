<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local = "clr-namespace:Ambinity.QuickAccess"
             x:DataType="local:ShortcutViewModel"
             x:Class="Ambinity.QuickAccess.ShortcutView">
    <StackPanel Margin="5,5,5,20" Spacing="8">
        <ToggleButton Padding="0" Height="50" HorizontalAlignment="Stretch">
            <PathIcon Width="20" Data="{Binding Icon,Converter={StaticResource ResourceConverter}}"></PathIcon>
        </ToggleButton> 
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"></TextBlock>
    </StackPanel>
    
</UserControl>
