<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.QuickAccess"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ambinity="clr-namespace:Ambinity"
             x:DataType="local:QuickAccessViewModel"
             x:Class="Ambinity.QuickAccess.QuickAccessView">
    <Grid>
        <ui:Frame Name="QuickAccessFrame" IsNavigationStackEnabled="True" CacheSize="5">
            <ui:Frame.NavigationPageFactory>
                <ambinity:PageFactory />
            </ui:Frame.NavigationPageFactory>
        </ui:Frame>
        <Button Margin="15" VerticalAlignment="Top" HorizontalAlignment="Right" Classes="icon-button" Padding="5,2,5,2" Height="25"
                Command="{Binding #QuickAccessFrame.GoBack}" IsVisible="{Binding #QuickAccessFrame.CanGoBack}">
            <Grid ColumnDefinitions="Auto,8,*">
                <PathIcon  Height="10" Width="10" Data="{DynamicResource Chevron_Left}"></PathIcon>
                <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="2"
                           Text="Shortcut">
                </TextBlock>
            </Grid>


        </Button>
    </Grid>

</UserControl>