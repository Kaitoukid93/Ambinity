<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Ambinity.QuickAccess.SystemTrayFlyoutWindowView"
        xmlns:local="clr-namespace:Ambinity.QuickAccess"
        x:DataType="local:SystemTrayFlyoutWindowViewModel"
        ShowInTaskbar="false"
        CanResize="False"
        Topmost="False"
        SystemDecorations="None"
        TransparencyLevelHint="Mica"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent"
        UseLayoutRounding="False"
        Width="360"
        Height="512"
        CornerRadius="8 8 8 8"
        WindowStartupLocation="Manual"
        Title="SystemTrayFlyoutWindow">
    <ContentControl Padding="10" Content="{Binding QuickAccessViewModel}"></ContentControl>
</Window>
