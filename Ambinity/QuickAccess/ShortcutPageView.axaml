<UserControl
    x:Class="Ambinity.QuickAccess.ShortcutPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.QuickAccess"
    xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="480"
    d:DesignWidth="320"
    x:DataType="local:ShortcutPageViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="50,10,*,10,70,10,50,30,Auto">
        <Grid
            Margin="15,15,15,10"
            ColumnDefinitions="*,Auto"
            Row="0">
            <TextBlock
                FontSize="15"
                FontWeight="SemiBold"
                Text="Shortcut" />
            <Button
                Grid.Column="1"
                Height="25"
                Padding="5,2,5,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Classes="icon-button"
                Command="{Binding GoToDevicesPageCommand}"
                IsVisible="{Binding !IsInEditMode}"
                ToolTip.Tip="Device control">
                <Grid ColumnDefinitions="Auto,8,*">
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Show devices" />
                    <PathIcon
                        Grid.Column="2"
                        Width="10"
                        Height="10"
                        Data="{DynamicResource showMoreRight}" />
                </Grid>

            </Button>
        </Grid>
        <Grid Margin="10,0,10,0" Row="2">
            <ItemsControl ItemsSource="{Binding Shortcuts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
        <Grid Row="4">
            <ContentControl
                Margin="15,0"
                Content="{Binding WidgetViewModel}"
                IsVisible="{Binding !IsInEditMode}" />
        </Grid>
        <Grid
            Margin="15,0,15,0"
            VerticalAlignment="Top"
            ColumnDefinitions="Auto,10,*,10,Auto"
            IsVisible="{Binding !IsInEditMode}"
            Row="6">

            <PathIcon Data="{DynamicResource sun}" />

            <Slider
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Value="{Binding ProfileBrightness}" />

            <PathIcon Grid.Column="4" Data="{DynamicResource brightness}" />

        </Grid>
        <Grid Row="8">
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                IsVisible="{Binding !IsInEditMode}"
                Orientation="Horizontal"
                Spacing="0">
                <Button
                    Width="35"
                    Height="35"
                    Classes="icon-button"
                    Command="{Binding OpenMainWindowCommand}"
                    CommandParameter="home"
                    ToolTip.HorizontalOffset="-20"
                    ToolTip.Placement="Top"
                    ToolTip.Tip="{localize:Loc Home.TextBlock.Text}"
                    ToolTip.VerticalOffset="-10">
                    <PathIcon Width="15" Data="{DynamicResource home_3__home_house_roof_shelter}" />
                </Button>
                <Button
                    Width="35"
                    Height="35"
                    Classes="icon-button"
                    Command="{Binding OpenMainWindowCommand}"
                    CommandParameter="store"
                    ToolTip.HorizontalOffset="-20"
                    ToolTip.Placement="Top"
                    ToolTip.Tip="{localize:Loc Store.Page.Header}"
                    ToolTip.VerticalOffset="-10">
                    <PathIcon Width="15" Data="{DynamicResource onlineStore}" />
                </Button>
                <Button
                    Width="35"
                    Height="35"
                    Classes="icon-button"
                    Command="{Binding OpenMainWindowCommand}"
                    CommandParameter="devices"
                    ToolTip.HorizontalOffset="-20"
                    ToolTip.Placement="Top"
                    ToolTip.Tip="{localize:Loc DeviceSettings.Section.Header}"
                    ToolTip.VerticalOffset="-10">
                    <PathIcon Width="15" Data="{DynamicResource Device_settings}" />
                </Button>
                <Button
                    Width="35"
                    Height="35"
                    Classes="icon-button"
                    Command="{Binding OpenMainWindowCommand}"
                    CommandParameter="layout"
                    ToolTip.HorizontalOffset="-20"
                    ToolTip.Placement="Top"
                    ToolTip.Tip="{localize:Loc Layout.Page.Header}"
                    ToolTip.VerticalOffset="-10">
                    <PathIcon Width="15" Data="{DynamicResource map_rounded}" />
                </Button>
                <Button
                    Width="35"
                    Height="35"
                    Classes="icon-button"
                    Command="{Binding OpenMainWindowCommand}"
                    CommandParameter="settings"
                    ToolTip.HorizontalOffset="-20"
                    ToolTip.Placement="Top"
                    ToolTip.Tip="{localize:Loc Settings.Button.ToolTip}"
                    ToolTip.VerticalOffset="-10">
                    <PathIcon Width="15" Data="{DynamicResource General_Outline_Settings}" />
                </Button> 
                <Separator
                    Width="2"
                    Height="18"
                    Margin="2,0" />
                <Button
                    Width="35"
                    Height="35"
                    Classes="icon-button danger"
                    Command="{Binding ExitAppCommand}"
                    ToolTip.Placement="Top"
                    ToolTip.Tip="{localize:Loc Exit.TextBlock.Text}"
                    ToolTip.VerticalOffset="-10">
                    <PathIcon Width="15" Data="{DynamicResource button_power_1__power_button_on_off}" />
                </Button>


            </StackPanel>
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsVisible="{Binding !IsInEditMode}"
                Orientation="Horizontal"
                Spacing="5">
                <HyperlinkButton Content="Help" NavigateUri="http://ambino.vn" />
                <Button
                    Width="35"
                    Height="35"
                    Classes="icon-button"
                    Command="{Binding EnterEditModeCommand}"
                    ToolTip.Placement="Top"
                    ToolTip.Tip="Add or remove shortcut"
                    ToolTip.VerticalOffset="-10">
                    <PathIcon Width="15" Data="{DynamicResource application_add__application_new_add_square}" />
                </Button>
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                IsVisible="{Binding IsInEditMode}"
                Orientation="Horizontal"
                Spacing="5">

                <Button
                    Width="70"
                    Height="32"
                    Classes="icon-button"
                    Command="{Binding ExitEditModeCommand}">
                    <Grid ColumnDefinitions="Auto,8,*">
                        <PathIcon Width="15" Data="{DynamicResource check__check_form_validation_checkmark_success_add_addition_tick}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="Done" />
                    </Grid>
                </Button>
                <Button
                    Width="70"
                    Height="32"
                    Classes="icon-button"
                    Command="{Binding AddShortcutCommand}">
                    <Grid ColumnDefinitions="Auto,8,*">
                        <PathIcon Width="15" Data="{DynamicResource add_1__expand_cross_buttons_button_more_remove_plus_add_+_mathematics_math}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="Add" />
                    </Grid>

                </Button>

            </StackPanel>

        </Grid>
    </Grid>


</UserControl>
