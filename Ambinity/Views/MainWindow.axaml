<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        TransparencyLevelHint="Mica"
        ExtendClientAreaToDecorationsHint="True"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Ambinity.Views.MainWindow"
        x:DataType="views:MainWindowViewModel"
        xmlns:views="clr-namespace:Ambinity.Views"
        xmlns:dashboard="clr-namespace:Ambinity.Views.Screens.Dashboard"
        xmlns:devicecontrol="clr-namespace:Ambinity.Views.Screens.DeviceControl"
        xmlns:nonclientarea="clr-namespace:Ambinity.Views.NonClientArea"
        xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:ambinity="clr-namespace:Ambinity"
        Icon="/Assets/avalonia-logo.ico"
        Title="Ambinity">
    
        <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="Auto,Auto,*,*">
                <nonclientarea:NonClientAreaContent></nonclientarea:NonClientAreaContent>
            </Grid>
            <Button Grid.Row="1" Command="{Binding GoToSurfaceEditorCommand}" Content="Surface Editor"></Button>
            <ui:Frame Grid.Row="2" Name="RootFrame"  IsNavigationStackEnabled="False" CacheSize="0">
                <ui:Frame.NavigationPageFactory>
                    <ambinity:PageFactory/>
                </ui:Frame.NavigationPageFactory>
            </ui:Frame>
            
        </Grid>
    
    

</Window>