<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local= "clr-namespace:Ambinity.Views.AppTour"
             x:DataType="local:AppTourViewModel"
             x:Class="Ambinity.Views.AppTour.AppTourView">
    <Border IsVisible="{Binding IsRunning}"  Margin="0" CornerRadius="0">
       
        <Grid>
            <Path Data="{Binding CurrentGeometry}">
                <Path.Fill>
                    <SolidColorBrush Color="Black" Opacity="0.75"></SolidColorBrush>
                </Path.Fill>
            </Path>
            <ItemsControl ItemsSource="{Binding ApptourElements}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas></Canvas>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style x:DataType="local:AppTourElementViewModel" Selector="ItemsControl > ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="{x:Type local:AppTourElementViewModel}">
                        <local:AppTourElementView></local:AppTourElementView>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </Grid>

    </Border>
</UserControl>
