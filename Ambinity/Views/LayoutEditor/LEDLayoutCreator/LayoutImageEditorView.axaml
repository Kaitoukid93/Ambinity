<Window
    x:Class="Ambinity.Views.LayoutEditor.LEDLayoutCreator.LayoutImageEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor.LEDLayoutCreator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LayoutImageEditorView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:LayoutImageEditorViewModel"
    ExtendClientAreaToDecorationsHint="True"
    mc:Ignorable="d">
    <Grid  RowDefinitions="40,*,Auto">
        <ContentControl Margin="20" Grid.Row="1" Content="{Binding CanvasViewModel}" />
        <StackPanel
            Grid.Row="2"
            Margin="20"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Classes="accent"
                Click="Accept_Button_Click"
                Command="{Binding AcceptUserEditCommand}"
                Content="Accept" />
            <Button Click="Cancel_Button_Click" Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
