<Window
    x:Class="Ambinity.Views.LayoutEditor.LEDLayoutCreator.LEDSplitToolConfigurationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor.LEDLayoutCreator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    Title="Create new Layout"
    Width="600"
    Height="600"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:LEDSplitToolConfigurationViewModel"
    CanResize="false"
    ExtendClientAreaToDecorationsHint="True"
    mc:Ignorable="d">

    <Grid Margin="20" RowDefinitions="20,auto,20,*,auto">
        <Grid ColumnDefinitions="*,10,*" Row="1">
            <Grid Column="0">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Rows" />
                    <Grid ColumnDefinitions="70,5,*">
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="Number:" />
                        <ui:NumberBox
                            Grid.Column="1"
                            Width="200"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            SimpleNumberFormat="F2"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding RowNumber}" />
                    </Grid>
                    <Grid ColumnDefinitions="70,5,*">
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="Height:" />
                        <ui:NumberBox
                            Grid.Column="1"
                            Width="200"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            SimpleNumberFormat="F2"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding RowHeight}" />
                    </Grid>
                    <Grid ColumnDefinitions="70,5,*">
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="Gutter:" />
                        <ui:NumberBox
                            Grid.Column="1"
                            Width="200"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            SimpleNumberFormat="F2"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding RowGutter}" />
                    </Grid>
                    <Grid ColumnDefinitions="70,5,*">
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="Total:" />
                        <ui:NumberBox
                            Grid.Column="1"
                            Width="200"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            SimpleNumberFormat="F2"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding TotalHeight}" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Separator
                Grid.Column="1"
                Width="1"
                Height="150"
                Margin="0,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch" />
            <Grid Column="2">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Columns" />
                    <Grid ColumnDefinitions="70,5,*">
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="Number:" />
                        <ui:NumberBox
                            Grid.Column="1"
                            Width="200"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            SimpleNumberFormat="F2"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding ColumnNumber}" />
                    </Grid>
                    <Grid ColumnDefinitions="70,5,*">
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="Width:" />
                        <ui:NumberBox
                            Grid.Column="1"
                            Width="200"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            SimpleNumberFormat="F2"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding ColumnWidth}" />
                    </Grid>
                    <Grid ColumnDefinitions="70,5,*">
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="Gutter:" />
                        <ui:NumberBox
                            Grid.Column="1"
                            Width="200"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            SimpleNumberFormat="F2"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding ColumnGutter}" />
                    </Grid>
                    <Grid ColumnDefinitions="70,5,*">
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="Total:" />
                        <ui:NumberBox
                            Grid.Column="1"
                            Width="200"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            SimpleNumberFormat="F2"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding TotalWidth}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Row="3">
            <Viewbox>
                <ItemsControl ItemsSource="{Binding Leds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding GeometryWidth}" Height="{Binding GeometryHeight}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style x:DataType="local:LEDContainerFigureViewModel" Selector="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <PathIcon
                                    Width="{Binding Width}"
                                    Height="{Binding Height}"
                                    Data="{Binding Geometry}"
                                    Foreground="{DynamicResource AccentButtonBackground}"/>
                            </Grid>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Viewbox>
        </Grid>
        <StackPanel
            Grid.Row="4" Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Classes="accent"
                Click="Accept_Button_Click"
                Command="{Binding AcceptCommand}"
                Content="Accept" />
            <Button
                Click="Cancel_Button_Click"
                Command="{Binding CancelCommand}"
                Content="Cancel" />
        </StackPanel>
    </Grid>

</Window>
