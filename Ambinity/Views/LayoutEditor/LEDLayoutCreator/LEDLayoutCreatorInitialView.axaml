<Window
    x:Class="Ambinity.Views.LayoutEditor.LEDLayoutCreator.LEDLayoutCreatorInitialView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor.LEDLayoutCreator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Create new Layout"
    Width="480"
    Height="800"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:LEDLayoutCreatorInitialViewModel"
    CanResize="false"
    ExtendClientAreaToDecorationsHint="True"
    mc:Ignorable="d">

    <Grid Margin="20" RowDefinitions="20,*,20,auto">
        <ScrollViewer Grid.Row="1">
            <ContentControl Margin="10" Content="{Binding LayoutPropertiesViewModel}" />
        </ScrollViewer>
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Classes="accent"
                Click="Accept_Button_Click"
                Command="{Binding AcceptCommand}"
                Content="{localize:Loc Accept.Button.Content}" />
            <Button
                Click="Cancel_Button_Click"
                Command="{Binding CancelCommand}"
                Content="{localize:Loc Cancel.Button.Tooltip}" />
        </StackPanel>
    </Grid>

</Window>
