<UserControl
    x:Class="Ambinity.Views.LayoutEditor.LEDLayoutCreator.LayoutPropertiesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor.LEDLayoutCreator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:LayoutPropertiesViewModel"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Spacing="20">
            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Layout name" />
                <TextBox VerticalContentAlignment="Center" Text="{Binding LayoutName}" />
            </StackPanel>
            <Separator Height="1" Margin="2,0" />
            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Select images" />
                <TextBox VerticalContentAlignment="Center" Text="{Binding ImagePath}">
                    <TextBox.InnerRightContent>
                        <Button
                            Width="70"
                            Margin="5"
                            Padding="5"
                            Command="{Binding SelectDeviceImageCommand}"
                            Content="Browse" />
                    </TextBox.InnerRightContent>
                </TextBox>
            </StackPanel>
            <Separator Height="1" Margin="2,0" />
            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="LEDs Counts" />
                <ui:NumberBox
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="4,4,4,4"
                    Maximum="255"
                    Minimum="1"
                    SimpleNumberFormat="F2"
                    SpinButtonPlacementMode="Hidden"
                    Theme="{DynamicResource borderlessNumberBox}"
                    Value="{Binding LEDCount}" />

                <TextBlock Text="This is the actual LEDs count of your device, use [Order check] function to count it yourself" TextWrapping="Wrap" />
            </StackPanel>
            <Separator Height="1" Margin="2,0" />
            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Layout size" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Width" />
                        <ui:NumberBox
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="4,4,4,4"
                            Maximum="1000000"
                            Minimum="10"
                            SimpleNumberFormat="F2"
                            SpinButtonPlacementMode="Hidden"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding Width}" />
                        <TextBlock VerticalAlignment="Center" Text="mm" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Width" />
                        <ui:NumberBox
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="4,4,4,4"
                            Maximum="1000000"
                            Minimum="10"
                            SimpleNumberFormat="F2"
                            SpinButtonPlacementMode="Hidden"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding Height}" />
                        <TextBlock VerticalAlignment="Center" Text="mm" />
                    </StackPanel>

                </StackPanel>
                <TextBlock Text="This is the physical bounding box of your device in mm" />
            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>
