<UserControl
    x:Class="Ambinity.Views.LayoutEditor.LEDLayoutCreator.LayoutPropertiesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor.LEDLayoutCreator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:LayoutPropertiesViewModel"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Spacing="20">

            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{localize:Loc SelectImage.TextBlock.Text}" />
                <TextBox VerticalContentAlignment="Center" Text="{Binding ImagePath}">
                    <TextBox.InnerRightContent>
                        <Button
                            Width="70"
                            Margin="5"
                            Padding="5"
                            Command="{Binding SelectDeviceImageCommand}"
                            Content="{localize:Loc Browse.Button.Content}" />
                    </TextBox.InnerRightContent>
                </TextBox>

                <TextBlock Text="{localize:Loc ImageFormatGuide.TextBlock.Text}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <Image
                        Width="300"
                        RenderOptions.BitmapInterpolationMode="HighQuality"
                        Source="{Binding GetThumbnail^, FallbackValue=null}"
                        Stretch="UniformToFill" />
                    <Button
                        Margin="5"
                        Padding="5"
                        HorizontalAlignment="Right"
                        Command="{Binding EditImageCommand}"
                        Content="{localize:Loc ImageEdit.Button.Content}"
                        IsVisible="{Binding ShowEditImageButton}"
                        ToolTip.Tip="{localize:Loc ImageEdit.Button.Tooltip}" />
                </StackPanel>

            </StackPanel>
            <Separator Height="1" Margin="2,0" />
            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{localize:Loc LEDsCount.TextBlock.Text}" />
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <ui:NumberBox
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="4,4,4,4"
                        Maximum="255"
                        Minimum="1"
                        SimpleNumberFormat="F2"
                        SpinButtonPlacementMode="Hidden"
                        Theme="{DynamicResource borderlessNumberBox}"
                        Value="{Binding LEDCount}" />
                    <ui:FAComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding LEDShapes}"
                        SelectedItem="{Binding SelectedLEDShape}" />
                </StackPanel>


                <TextBlock Text="{localize:Loc LEDsCountGuide.TextBlock.Text}" TextWrapping="Wrap" />
            </StackPanel>
            <Separator Height="1" Margin="2,0" />
            <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Layout size" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Width" />
                        <ui:NumberBox
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="4,4,4,4"
                            Maximum="1000000"
                            Minimum="10"
                            SimpleNumberFormat="F2"
                            SpinButtonPlacementMode="Hidden"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="mm" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Height" />
                        <ui:NumberBox
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="4,4,4,4"
                            Maximum="1000000"
                            Minimum="10"
                            SimpleNumberFormat="F2"
                            SpinButtonPlacementMode="Hidden"
                            Theme="{DynamicResource borderlessNumberBox}"
                            Value="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="mm" />
                    </StackPanel>

                </StackPanel>
                <TextBlock Text="{localize:Loc HeightGuide.TextBlock.Text}" />
            </StackPanel>
            <Separator Height="1" Margin="2,0" />
            <TextBlock Text="{localize:Loc ExistingProject.TextBlock.Text}" />
            <Button
                Classes="accent"
                Command="{Binding SelectExistingProjectCommand}"
                Content="{localize:Loc OpenProject.Button.Content}" />
        </StackPanel>

    </Grid>
</UserControl>
