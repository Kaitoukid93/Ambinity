<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:DataType="local:LEDLayoutCreatorViewModel"
        xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor.LEDLayoutCreator"
        x:Class="Ambinity.Views.LayoutEditor.LEDLayoutCreator.LEDLayoutCreatorView"
        ExtendClientAreaToDecorationsHint="True"
        Title="Layout Creator">
 <Grid ColumnDefinitions="*,20,Auto" RowDefinitions="40,*,Auto">
  <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding CanvasViewModel}"/>
  <Grid  Column="2">
   <ContentControl Margin="10" Grid.Row ="2" Content = "{Binding LEDPropertiesViewModel}"/>
    </Grid>
  </Grid>
</Window>
