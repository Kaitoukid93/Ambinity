<Window
    x:Class="Ambinity.Views.LayoutEditor.LEDLayoutCreator.LEDLayoutCreatorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor.LEDLayoutCreator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Layout Creator"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:LEDLayoutCreatorViewModel"
    ExtendClientAreaToDecorationsHint="True"
    mc:Ignorable="d">
    <Grid  ColumnDefinitions="*,10,Auto" RowDefinitions="40,*,Auto">
        <ContentControl
            Grid.Row="1"
            Grid.Column="0"
            Content="{Binding CanvasViewModel}" />
        <Grid Column="2"  Grid.Row="1">
            <ContentControl
                Content="{Binding LEDPropertiesViewModel}" />
        </Grid>
    </Grid>
</Window>
