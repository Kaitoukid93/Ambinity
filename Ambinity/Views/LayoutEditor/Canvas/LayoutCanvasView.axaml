<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor"
             x:DataType="local:LayoutCanvasViewModel"
             x:Class="Ambinity.Views.LayoutEditor.LayoutCanvasView">
    <Grid>
        <ContentControl Content="{CompiledBinding CanvasViewModel}"></ContentControl>
        <ContentControl Margin="10"
                        Content="{Binding ToolsViewModel}">
        </ContentControl>
        <ContentControl Content="{Binding InfoBarViewModel}" Margin="10" HorizontalAlignment="Right"
                        VerticalAlignment="Top">
        </ContentControl>
    </Grid>

</UserControl>
