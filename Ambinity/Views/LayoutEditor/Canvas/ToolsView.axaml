<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor"
             xmlns:toolbarItem="clr-namespace:AmbinityCore.Models.Toolbar;assembly=AmbinityCore"
             xmlns:flyoutItem="clr-namespace:AmbinityCore.Models.Flyout;assembly=AmbinityCore"
             x:DataType="local:ToolsViewModel"
             x:Class="Ambinity.Views.LayoutEditor.ToolsView">
    <UserControl.Resources>
        <FontFamily x:Key="FrapsFont">avares://Ambinity/Assets/Fonts#fraps</FontFamily>
        <FontFamily x:Key="MinercraftoryFont">avares://Ambinity/Assets/Fonts#Minercraftory</FontFamily>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.Tool" x:DataType="toolbarItem:ButtonToolbarItem">
            <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}"></Setter>
            <Setter Property="Foreground" Value="{Binding FillColor}"></Setter>
            <Style Selector="^:disabled">
                <Setter Property="ToolTip.Tip" Value="{Binding DisabledToolTip}"></Setter>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}"></Setter>
            </Style>
        </Style>
        <Style Selector="Button.flyoutTool" x:DataType="toolbarItem:FlyoutButtonToolbarItem">
            <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}"></Setter>
            <Setter Property="Foreground" Value="{Binding FillColor}"></Setter>
            <Style Selector="^:disabled">
                <Setter Property="ToolTip.Tip" Value="{Binding DisabledToolTip}"></Setter>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}"></Setter>
            </Style>
        </Style>
        <Style Selector="FlyoutPresenter.DefaultFlyout">
            <Setter Property="Background" Value="{DynamicResource TimePickerFlyoutPresenterBackground}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>
    <FlyoutBase.AttachedFlyout>
        <Flyout Closing="PopupFlyoutBase_OnClosing" Placement="LeftEdgeAlignedBottom" HorizontalOffset="-10"
                FlyoutPresenterClasses="DefaultFlyout">
            <Grid>
                <ContentControl Focusable="True" Content="{CompiledBinding CurrentFlyoutViewModel}"></ContentControl>
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="10" Spacing="5">
                        <!-- <Grid> -->
                        <!--     <Button ToolTip.Tip="Add to Library" Padding="1" Background="Transparent" Width="30" Height="30" -->
                        <!--             Classes="icon-button"> -->
                        <!--         <PathIcon Width="15" Data="{DynamicResource plus}"></PathIcon> -->
                        <!--     </Button> -->
                        <!-- </Grid> -->
                        <Grid>
                            <Button ToolTip.Tip="Close" Padding="1" Click="Button_OnClick"
                                    Background="Transparent" Width="30" Height="30"
                                    Classes="icon-button">
                                <PathIcon Margin="1,1,0,0" Width="17" Data="{DynamicResource plus}">
                                    <PathIcon.RenderTransform>
                                        <RotateTransform Angle="45"></RotateTransform>
                                    </PathIcon.RenderTransform>
                                </PathIcon>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

        </Flyout>
    </FlyoutBase.AttachedFlyout>
    <Grid>

        <StackPanel Spacing="10" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border  CornerRadius="7" Margin="0,0,0,0" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Padding="0">
                <Border.Background>
                    <SolidColorBrush Color="Black" Opacity="0.5"></SolidColorBrush>
                </Border.Background>
                <ItemsControl ItemsSource="{Binding CanvasTools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="{x:Type toolbarItem:ToggleToolbarItem}">
                            <ToggleButton BorderThickness="0" CornerRadius="4" IsChecked="{Binding IsChecked}"
                                          Command="{Binding Command}" ToolTip.Tip="{Binding ToolTip}"
                                          Background="Transparent"
                                          Width="40" Height="40"

                                          Padding="0" Margin="5,5">
                                <PathIcon Width="18" Height="18"
                                          Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">

                                </PathIcon>
                            </ToggleButton>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type toolbarItem:ButtonToolbarItem}">
                            <Button CornerRadius="4" Classes="icon-button Tool" ToolTip.ShowOnDisabled="True"
                                    Background="Transparent" Width="40" Height="40"

                                    Command="{Binding Command}"
                                    Padding="0" Margin="5,5">
                                <PathIcon Width="18" Height="18"
                                          Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">
                                </PathIcon>
                            </Button>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type toolbarItem:SeparatorToolbarItem}">
                            <Separator Width="1" Height="35" Margin="5"></Separator>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type toolbarItem:FlyoutButtonToolbarItem}">
                            <Button ToolTip.ShowOnDisabled="True"
                                    Command="{Binding Command}" CornerRadius="4"
                                    Width="40" Height="40" Padding="0" Margin="5,5"
                                    Classes="icon-button flyoutTool">
                                <PathIcon
                                    Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">
                                </PathIcon>
                                <Button.Flyout>
                                    <ui:FAMenuFlyout VerticalOffset="-10" Placement="Top"
                                                     ItemsSource="{Binding FlyoutItems}">
                                        <ui:FAMenuFlyout.ItemTemplate>
                                            <DataTemplate DataType="{x:Type flyoutItem:FlyoutItem}">
                                                <ui:MenuFlyoutItem Click="MenuFlyoutItem_OnClick"
                                                                   Command="{Binding Command}" Text="{Binding Content}">
                                                    <ui:MenuFlyoutItem.IconSource>
                                                        <ui:PathIconSource
                                                            Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">
                                                        </ui:PathIconSource>
                                                    </ui:MenuFlyoutItem.IconSource>
                                                </ui:MenuFlyoutItem>
                                            </DataTemplate>
                                        </ui:FAMenuFlyout.ItemTemplate>
                                    </ui:FAMenuFlyout>
                                </Button.Flyout>

                            </Button>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </Border>
            <Border IsVisible="{Binding ShowDiag}" VerticalAlignment="Top"  Padding="10" CornerRadius="7">
                <Border.Background>
                    <SolidColorBrush Color="Black" Opacity="0.25"></SolidColorBrush>
                </Border.Background>
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Spacing="3">
                        <ItemsControl ItemsSource="{Binding FrameTime}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="3">

                                    </StackPanel>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Left" ColumnDefinitions="Auto,*">
                                        <TextBlock HorizontalAlignment="Left" Foreground="{DynamicResource AccentButtonBackground}" Text="FRAME TIME: " FontSize="10"
                                                   FontFamily="{DynamicResource MinercraftoryFont}">
                                        </TextBlock>
                                        <TextBlock Width="60" Grid.Column="1" HorizontalAlignment="Left" Foreground="{DynamicResource AccentButtonBackground}" Text="{Binding .,StringFormat={}{0:F5}}"
                                                   FontSize="10"
                                                   FontFamily="{DynamicResource MinercraftoryFont}">
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </Grid>
            </Border>
          
        </StackPanel>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="10">
            <Border  CornerRadius="7"
                    Margin="0,0,0,0" Padding="0">
                <Border.Background>
                    <SolidColorBrush Color="Black" Opacity="0.5"></SolidColorBrush>
                </Border.Background>
                <Button Classes="icon-button" CornerRadius="4"
                        Width="40" Height="40"
                        ToolTip.Tip="Play-Pause"
                        Command="{Binding TogglePlayPauseCommand}"
                        Padding="0" Margin="5,5">
                    <Grid>
                        <PathIcon Width="18" Height="18" IsVisible="{Binding !IsRendering}"
                                  Data="{DynamicResource playComposition}">
                        </PathIcon>
                        <PathIcon Width="18" Height="18" IsVisible="{Binding IsRendering}"
                                  Data="{DynamicResource pauseComposition}">
                        </PathIcon>
                    </Grid>
                </Button>
            </Border>
            <Border  CornerRadius="7"
                    Margin="0,0,0,0" Padding="0">
                <Border.Background>
                    <SolidColorBrush Color="Black" Opacity="0.5"></SolidColorBrush>
                </Border.Background>
                <Slider Margin="10,0,10,0" Width="160" Minimum="0" Value="{Binding Brightness}" Maximum="100"></Slider>
            </Border>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="10">
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="7"
                    Margin="0,0,0,0" Padding="0">
                <Border.Background>
                    <SolidColorBrush Color="Black" Opacity="0.5"></SolidColorBrush>
                </Border.Background>
                <ItemsControl x:Name="tools" ItemsSource="{Binding ZoneTools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="{x:Type toolbarItem:ToggleToolbarItem}">
                            <ToggleButton CornerRadius="4" IsChecked="{Binding IsChecked}"
                                          Command="{Binding Command}" ToolTip.Tip="{Binding ToolTip}"
                                          Background="Transparent"
                                          Width="40" Height="40"

                                          Padding="0" Margin="5,5">
                                <PathIcon Width="18" Height="18"
                                          Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">

                                </PathIcon>
                            </ToggleButton>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type toolbarItem:ButtonToolbarItem}">
                            <Button CornerRadius="4" Classes="icon-button Tool" ToolTip.ShowOnDisabled="True"
                                    Background="Transparent" Width="40" Height="40"

                                    Command="{Binding Command}"
                                    Padding="0" Margin="5,5">
                                <PathIcon Width="18" Height="18"
                                          Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">
                                </PathIcon>
                            </Button>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type toolbarItem:SeparatorToolbarItem}">
                            <Separator Width="1" Height="35" Margin="5"></Separator>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type toolbarItem:FlyoutButtonToolbarItem}">
                            <Button ToolTip.ShowOnDisabled="True"
                                    Command="{Binding Command}" CornerRadius="4"
                                    Width="40" Height="40" Padding="0" Margin="5,5"
                                    Classes="icon-button flyoutTool">
                                <PathIcon
                                    Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">
                                </PathIcon>
                                <Button.Flyout>
                                    <ui:FAMenuFlyout VerticalOffset="-10" Placement="Top"
                                                     ItemsSource="{Binding FlyoutItems}">
                                        <ui:FAMenuFlyout.ItemTemplate>
                                            <DataTemplate DataType="{x:Type flyoutItem:FlyoutItem}">
                                                <ui:MenuFlyoutItem Click="MenuFlyoutItem_OnClick"
                                                                   Command="{Binding Command}" Text="{Binding Content}">
                                                    <ui:MenuFlyoutItem.IconSource>
                                                        <ui:PathIconSource
                                                            Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">
                                                        </ui:PathIconSource>
                                                    </ui:MenuFlyoutItem.IconSource>
                                                </ui:MenuFlyoutItem>
                                            </DataTemplate>
                                        </ui:FAMenuFlyout.ItemTemplate>
                                    </ui:FAMenuFlyout>
                                </Button.Flyout>

                            </Button>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </Border>
            <Border VerticalAlignment="Bottom" IsVisible="{Binding  ShowLockSymbol}" Width="50" Height="50"
                   CornerRadius="7"
                    Margin="0,0,0,0" Padding="0">
                <Border.Background>
                    <SolidColorBrush Color="Black" Opacity="0.5"></SolidColorBrush>
                </Border.Background>
                <PathIcon Foreground="OrangeRed" ToolTip.Tip="Canvas is locked" Data="{DynamicResource lock}"></PathIcon>
            </Border>
        </StackPanel>

    </Grid>
</UserControl>