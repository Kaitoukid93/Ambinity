<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor"
             xmlns:toolbarItem="clr-namespace:AmbinityCore.Models.Toolbar;assembly=AmbinityCore"
             xmlns:flyoutItem="clr-namespace:AmbinityCore.Models.Flyout;assembly=AmbinityCore"
             x:DataType="local:ToolsViewModel"
             x:Class="Ambinity.Views.LayoutEditor.ToolsView">
    <UserControl.Styles>
        <Style Selector="Button.Tool" x:DataType="toolbarItem:ButtonToolbarItem">
            <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}"></Setter>
            <Setter Property="Foreground" Value="{Binding FillColor}"></Setter>
            <Style Selector="^:disabled">
                <Setter Property="ToolTip.Tip" Value="{Binding DisabledToolTip}"></Setter>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}"></Setter>
            </Style>
        </Style>
        <Style Selector="Button.flyoutTool" x:DataType="toolbarItem:FlyoutButtonToolbarItem">
            <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}"></Setter>
            <Setter Property="Foreground" Value="{Binding FillColor}"></Setter>
            <Style Selector="^:disabled">
                <Setter Property="ToolTip.Tip" Value="{Binding DisabledToolTip}"></Setter>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}"></Setter>
            </Style>
        </Style>
        <Style Selector="FlyoutPresenter.DefaultFlyout">
            <Setter Property="Background" Value="{DynamicResource TimePickerFlyoutPresenterBackground}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>
    <FlyoutBase.AttachedFlyout>
        <Flyout Closing="PopupFlyoutBase_OnClosing" Placement="LeftEdgeAlignedBottom" HorizontalOffset="-10"
                FlyoutPresenterClasses="DefaultFlyout">
            <Grid>
                <ContentControl Focusable="True" Content="{CompiledBinding CurrentFlyoutViewModel}"></ContentControl>
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="10" Spacing="5">
                        <!-- <Grid> -->
                        <!--     <Button ToolTip.Tip="Add to Library" Padding="1" Background="Transparent" Width="30" Height="30" -->
                        <!--             Classes="icon-button"> -->
                        <!--         <PathIcon Width="15" Data="{DynamicResource plus}"></PathIcon> -->
                        <!--     </Button> -->
                        <!-- </Grid> -->
                        <Grid>
                            <Button ToolTip.Tip="Close" Padding="1" Click="Button_OnClick"
                                    Background="Transparent" Width="30" Height="30"
                                    Classes="icon-button">
                                <PathIcon Margin="1,1,0,0" Width="17" Data="{DynamicResource plus}">
                                    <PathIcon.RenderTransform>
                                        <RotateTransform Angle="45"></RotateTransform>
                                    </PathIcon.RenderTransform>
                                </PathIcon>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

        </Flyout>
    </FlyoutBase.AttachedFlyout>
    <Grid>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Background="#2c2c2c" CornerRadius="7" Margin="0,0,0,0" Padding="0">
                <ItemsControl x:Name="tools" ItemsSource="{Binding ToolbarItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="{x:Type toolbarItem:ToggleToolbarItem}">
                            <ToggleButton BorderThickness="0" CornerRadius="4" IsChecked="{Binding IsChecked}"
                                          Command="{Binding Command}" ToolTip.Tip="{Binding ToolTip}"
                                          Background="Transparent"
                                          Width="40" Height="40"

                                          Padding="0" Margin="5,5">
                                <PathIcon Width="18" Height="18"
                                          Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">

                                </PathIcon>
                            </ToggleButton>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type toolbarItem:ButtonToolbarItem}">
                            <Button CornerRadius="4" Classes="icon-button Tool" ToolTip.ShowOnDisabled="True"
                                    Background="Transparent" Width="40" Height="40"
                                    BorderThickness="0"
                                    Command="{Binding Command}"
                                    Padding="0" Margin="5,5">
                                <PathIcon Width="18" Height="18"
                                          Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">
                                </PathIcon>
                            </Button>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type toolbarItem:SeparatorToolbarItem}">
                            <Separator Width="1" Height="35" Margin="5"></Separator>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type toolbarItem:FlyoutButtonToolbarItem}">
                            <Button ToolTip.ShowOnDisabled="True" BorderThickness="0"
                                    Command="{Binding Command}" CornerRadius="4"
                                     Width="40" Height="40" Padding="0" Margin="5,5"
                                    Classes="icon-button flyoutTool">
                                <PathIcon
                                    Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">
                                </PathIcon>
                                <Button.Flyout>
                                    <ui:FAMenuFlyout VerticalOffset="-10" Placement="Top"
                                                     ItemsSource="{Binding FlyoutItems}">
                                        <ui:FAMenuFlyout.ItemTemplate>
                                            <DataTemplate DataType="{x:Type flyoutItem:FlyoutItem}">
                                                <ui:MenuFlyoutItem Click="MenuFlyoutItem_OnClick"
                                                                   Command="{Binding Command}" Text="{Binding Content}">
                                                    <ui:MenuFlyoutItem.IconSource>
                                                        <ui:PathIconSource
                                                            Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">
                                                        </ui:PathIconSource>
                                                    </ui:MenuFlyoutItem.IconSource>
                                                </ui:MenuFlyoutItem>
                                            </DataTemplate>
                                        </ui:FAMenuFlyout.ItemTemplate>
                                    </ui:FAMenuFlyout>
                                </Button.Flyout>

                            </Button>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </Border>
            <Border IsVisible="{Binding  ShowLockSymbol}" Width="50" Background="#2c2c2c" CornerRadius="7"
                    Margin="0,0,0,0" Padding="0">
                <PathIcon Foreground="OrangeRed" ToolTip.Tip="Canvas is locked" Data="{DynamicResource lock}"></PathIcon>
            </Border>
        </StackPanel>

    </Grid>
</UserControl>