<UserControl
    x:Class="Ambinity.Views.LayoutEditor.Canvas.LEDLayoutCreatorCanvasView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Ambinity.Views.Draw2DCanvas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:draw2DControlLibrary="clr-namespace:Draw2DControlLibrary;assembly=Draw2DControlLibrary"
    xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor.Canvas"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:LEDLayoutCreatorCanvasViewModel"
    mc:Ignorable="d">
    <Border Margin="20,0,20,20" Classes="card">
        <Grid>
            <local:Draw2DCanvasView />
        </Grid>

    </Border>

</UserControl>
