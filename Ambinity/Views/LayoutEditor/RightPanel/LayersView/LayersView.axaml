<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local = "clr-namespace:Ambinity.Views.LayoutEditor"
             x:DataType="local:LayersViewModel"
             Focusable="True"
             x:Class="Ambinity.Views.LayoutEditor.LayersView">
    <Grid MinWidth="300" Margin="18,0,18,10" RowDefinitions="10,*">
        <ScrollViewer Grid.Row="1"  BringIntoViewOnFocusChange="True" x:Name="ScrollViewer" IsScrollInertiaEnabled="True">
            <ItemsControl Margin="0,0,0,0" ItemsSource="{Binding Layers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                       <local:LayerView></local:LayerView>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
    
</UserControl>
