<UserControl
    x:Class="Ambinity.Views.LayoutEditor.DeviceLayoutRightPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.Views.LayoutEditor"
    xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:DeviceLayoutRightPanelViewModel"
    Focusable="True"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="FlyoutPresenter.DefaultFlyout">
            <Setter Property="Background" Value="{DynamicResource TimePickerFlyoutPresenterBackground}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>
    <FlyoutBase.AttachedFlyout>
        <Flyout
            Closing="PopupFlyoutBase_OnClosing"
            FlyoutPresenterClasses="DefaultFlyout"
            HorizontalOffset="-10"
            Placement="LeftEdgeAlignedBottom">
            <Grid>
                <ContentControl Content="{CompiledBinding FlyoutViewModel}" Focusable="True" />
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel
                        Margin="10"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="5">
                        <!-- <Grid> -->
                        <!--  <Button ToolTip.Tip="Add to Library" Padding="1" Background="Transparent" Width="30" Height="30"  -->
                        <!--  Classes="icon-button">  -->
                        <!--         <PathIcon Width="15" Data="{DynamicResource plus}"></PathIcon> -->
                        <!--     </Button> -->
                        <!-- </Grid> -->
                        <Grid>
                            <Button
                                Width="30"
                                Height="30"
                                Padding="1"
                                Background="Transparent"
                                Classes="icon-button"
                                Click="Button_OnClick"
                                ToolTip.Tip="Close">
                                <PathIcon
                                    Width="17"
                                    Margin="1,1,0,0"
                                    Data="{DynamicResource plus}">
                                    <PathIcon.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </PathIcon.RenderTransform>
                                </PathIcon>
                            </Button>

                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

        </Flyout>
    </FlyoutBase.AttachedFlyout>
    <Grid>
        <Grid RowDefinitions="Auto,20,Auto,*">
            <ContentControl Content="{Binding PropertiesViewModel}" IsVisible="{Binding !IsLocked}" />
            <Separator
                Grid.Row="1"
                Margin="18,0"
                IsVisible="{Binding !IsLocked}" />
            <Grid
                Grid.Row="2"
                Margin="20,0,20,10"
                ColumnDefinitions="*,Auto"
                IsVisible="{Binding !IsLocked}">
                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="5">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="Device Layout" />
                    <!-- <Grid>
                        <Button Click="InfoButton_OnClick" x:Name="infoButton" Background="Transparent"
                                BorderThickness="0" Classes="icon-button-small" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <PathIcon Width="15" Height="15" Data="{DynamicResource infoCircle}"></PathIcon>
                        </Button>
                        <ui:TeachingTip IsLightDismissEnabled="True" x:Name="infotip"
                                        HeroContentPlacement="Auto"
                                        Target="{Binding ElementName=infoButton}">
                            <ui:TeachingTip.HeroContent>
                                <Border CornerRadius="7,7,0,0" Background="{Binding #infotip.Background}"
                                        Padding="10">
                                    <mdxaml:MarkdownScrollViewer xml:space="preserve">
##### **Device Layout**

 * **What even is Device Layout?**
 Device layout is the model Ambinity use to calculate the color based on position and shape.
 * **Why do I need a custom Device Layout**
 It's fine if you just use the default layout, but Ambinity will not be able to calculate the color precisely. Hence the default model will
not represent a 1:1 color to the actual device

Request custom layout at [Ambino-Layout](https://ambino.vn)
                                                </mdxaml:MarkdownScrollViewer>
                                </Border>
                            </ui:TeachingTip.HeroContent>
                        </ui:TeachingTip>
                    </Grid>-->
                </StackPanel>

                <Grid Column="1">
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="5">
                        <Grid>
                            <Button
                                x:Name="ShowLibraryButton"
                                Width="30"
                                Height="30"
                                Padding="1"
                                Background="Transparent"
                                Classes="icon-button"
                                Command="{Binding OpenLibraryCommand}"
                                ToolTip.Tip="{localize:Loc ShowLibrary.Button.ToolTip}">
                                <PathIcon Width="15" Data="{DynamicResource collection}" />
                            </Button>
                        </Grid>
                        <Grid>
                            <Button
                                Width="30"
                                Height="30"
                                Padding="1"
                                Background="Transparent"
                                Classes="icon-button"
                                Command="{Binding OpenLayoutCreatorCommand}"
                                ToolTip.Tip="Create Custom Layout">
                                <PathIcon Width="15" Data="{DynamicResource AddToCollection}" />
                            </Button>
                        </Grid>
                    </StackPanel>

                </Grid>
            </Grid>
            <ContentControl
                Grid.Row="3"
                Width="300"
                Margin="0,0,0,20"
                VerticalAlignment="Top"
                Content="{Binding PropertiesViewModel.DetailViewModel}" />
        </Grid>
        <Border Width="350" IsVisible="{Binding IsLocked}">

            <StackPanel
                Margin="20"
                VerticalAlignment="Center"
                Spacing="20">
                <PathIcon
                    Width="100"
                    Height="100"
                    Data="{DynamicResource lock}" />
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="DarkOrange"
                    Text="Properties panel is locked during rendering. Please stop the profile to change device's properties"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

        </Border>
    </Grid>
</UserControl>
