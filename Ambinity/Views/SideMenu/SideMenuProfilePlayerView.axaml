<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.SideMenu"
             x:DataType="local:SideMenuProfilePlayerViewModel"
             x:Class="Ambinity.Views.SideMenu.SideMenuProfilePlayerView">
    <Button ToolTip.Tip="Edit this profile" Command="{Binding GoToProfileEditorCommand}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Classes="icon-button" BorderThickness="0"
            Background="Transparent" Margin="10,0,0,10">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="40" Height="40" Classes="card" HorizontalAlignment="Left" VerticalAlignment="Top">
                <PathIcon Data="{Binding CurrentPlayingProfile.Icon,Converter={StaticResource ResourceConverter}}"></PathIcon>
            </Border>
            <Grid Column="1">
                <StackPanel Margin="10,0" Spacing="2">
                    <TextBlock HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="100"
                               Text="{Binding CurrentPlayingProfile.Name}">
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Left" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="100"
                               Foreground="{DynamicResource ButtonForegroundDisabled}" Text="{Binding CurrentPlayingProfile.Category.Name,FallbackValue=Last played}">
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Column="2">
                <Lottie IsVisible="{Binding IsPlaying}" Margin="5" HorizontalAlignment="Right" Path="/Assets/rendering.json" Width="30" Height="30"></Lottie>
            </Grid>

        </Grid>
    </Button>

</UserControl>