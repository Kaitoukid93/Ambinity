<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.SideMenu"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:DataType="local:SideMenuProfileViewModel"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             x:Class="Ambinity.Views.SideMenu.SideMenuProfileView">
    <UserControl.Resources>
        <MenuFlyout x:Key="ProfileMenuFlyout" Placement="Bottom">
            <MenuItem Command="{Binding OpenPropertiesEditorCommand}" Header="Edit properties">
                <MenuItem.Icon>
                    <PathIcon Width="15" Height="15" Data="{DynamicResource generalSettings}"></PathIcon>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="-" />
            <MenuItem Command="{Binding ExportCommand}" Header="Export">
                <MenuItem.Icon>
                    <PathIcon Width="15" Height="15" Data="{DynamicResource Export}"></PathIcon>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding DuplicateCommand}" Header="Duplicate">
                <MenuItem.Icon>
                    <PathIcon Width="15" Height="15" Data="{DynamicResource duplicate}"></PathIcon>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="-" />
            <MenuItem Command="{Binding SelfDeleteCommand}" Header="Delete">
                <MenuItem.Icon>
                    <PathIcon Width="15" Height="15" Data="{DynamicResource delete}"></PathIcon>
                </MenuItem.Icon>
            </MenuItem>
        </MenuFlyout>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector=":is(Button).properties-button">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Button).isSelected-button">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector=":is(PathIcon).playing-grid">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid#ItemGrid:pointerover :is(Button).properties-button">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Grid#ItemGrid:pointerover :is(Grid).playing-grid">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid#ItemGrid.flyout-open :is(Button).properties-button">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector=":is(TextBlock).playing-foreGround">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector=":is(PathIcon).playing-fill">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>
    <Grid Background="Transparent"
          x:Name="ItemGrid"
          ContextFlyout="{DynamicResource ProfileMenuFlyout}"
          ColumnDefinitions="Auto,*,10,Auto">
        <!-- <PathIcon Width="15" Height="15" Margin="0,0,7,0" -->
        <!--           Classes.playing-fill="{CompiledBinding IsPlaying}" -->
        <!--           Data="{Binding Icon,Converter={StaticResource ResourceConverter}}"> -->
        <!-- </PathIcon> -->

        <Image Width="20" Margin="0,0,7,0" RenderOptions.BitmapInterpolationMode="HighQuality"
               Source="{Binding GetThumbnail^,FallbackValue=null}">
        </Image>
        <TextBlock TextTrimming="CharacterEllipsis" Grid.Column="1" Padding="0 6,0,6"
                   FontWeight="SemiBold"
                   FontSize="13"
                   Classes.playing-foreGround="{CompiledBinding IsPlaying}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Text="{CompiledBinding Content, FallbackValue='New Category'}">
        </TextBlock>
        <Grid HorizontalAlignment="Right" Grid.Column="3" Margin="0,1,5,0" Classes="playing-grid">
            <PathIcon Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding IsPlaying}" Width="13"
                      Height="13"
                      Data="{DynamicResource 'pauseComposition'}">
            </PathIcon>
        </Grid>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0">
            <Button Classes="properties-button icon-button icon-button-small"
                    Classes.isSelected-button="{Binding IsSelected}"
                    Flyout="{StaticResource ProfileMenuFlyout}"
                    ToolTip.Tip="Settings"
                    HorizontalAlignment="Right"
                    Margin="0 0 0 0">
                <PathIcon Width="13" Height="13"
                          Data="{DynamicResource generalSettings}">
                </PathIcon>
            </Button>
            <Button Classes="properties-button icon-button icon-button-small"
                    Click="Button_OnClick"
                    x:Name="PlayButton"
                    Classes.isSelected-button="{Binding IsSelected}"
                    Command="{CompiledBinding TogglePlayPauseProfileCommand}"
                    ToolTip.Tip="Play/Pause profile"
                    HorizontalAlignment="Right"
                    Margin="0 0 0 0">
                <Panel>
                    <PathIcon IsVisible="{Binding !IsPlaying}" Width="13" Height="13"
                              Data="{DynamicResource 'playComposition'}">
                    </PathIcon>
                    <PathIcon IsVisible="{Binding IsPlaying}" Width="13" Height="13"
                              Data="{DynamicResource 'pauseComposition'}">
                    </PathIcon>
                </Panel>
            </Button>

        </StackPanel>


    </Grid>
</UserControl>