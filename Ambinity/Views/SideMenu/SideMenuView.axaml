<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.SideMenu"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:DataType="local:SideMenuViewModel"
             x:Class="Ambinity.Views.SideMenu.SideMenuView">
    <Grid RowDefinitions="*,Auto">
        <StackPanel>
            <ListBox Margin="10,10"
                     Width="200"
                     SelectedItem="{CompiledBinding SelectedScreen}"
                     ItemsSource="{Binding ScreenMenuItems}">
                <ListBox.DataTemplates>
                    <DataTemplate DataType="{x:Type local:SideMenuScreenViewModel}">
                        <local:SideMenuScreenView></local:SideMenuScreenView>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
            <ui:NavigationViewItemSeparator Margin="10,0,10,0"></ui:NavigationViewItemSeparator>


            <ItemsControl Margin="10,5,5,10" ItemsSource="{Binding ProfileCategorymenuItems}">
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="{x:Type local:SideMenuProfileCategoryViewModel}">
                        <local:SideMenuProfileCategoryView></local:SideMenuProfileCategoryView>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>

        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="5">
            <Grid ColumnDefinitions="auto,*">
                <TextBlock Margin="20,0,5,0" Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Now Playing"></TextBlock>
                <Separator Margin="0,3,0,0" Grid.Column="1"></Separator>
            </Grid>
            
            <ContentControl Content="{Binding ProfilePlayerViewModel}"></ContentControl>
        </StackPanel>

    </Grid>


</UserControl>