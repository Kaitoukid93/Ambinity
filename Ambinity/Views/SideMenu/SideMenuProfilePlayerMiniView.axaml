<UserControl
    x:Class="Ambinity.Views.SideMenu.SideMenuProfilePlayerMiniView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.Views.SideMenu"
    xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:SideMenuProfilePlayerMiniViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector=":is(Button).play-button">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid#ContainerGrid:pointerover :is(Button).play-button">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Grid>
            <Button
                x:Name="ProfileButton"
                Margin="10,10,8,10"
                Padding="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Classes="icon-button"
                Click="ProfileButton_OnClick"
                Command="{CompiledBinding GoToProfileEditorCommand}"
                CornerRadius="5"
                ToolTip.Tip="{localize:Loc EditProfile.Button.ToolTip}">
                <Border
                    Width="180"
                    Height="60"
                    Padding="0"
                    BorderThickness="0"
                    Classes="card"
                    ClipToBounds="True"
                    CornerRadius="2">
                    <Grid ColumnDefinitions="Auto,*" Name="ContainerGrid" Background="Transparent">
                        <Button
                            x:Name="PlayButton"
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Margin="10,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Classes="icon-button"
                            Click="PlayButton_OnClick"
                            Command="{Binding PlayButtonCommand}"
                            CornerRadius="30"
                            ToolTip.Tip="{Binding PlayButtonToolTip}">
                            <PathIcon
                                Width="20"
                                Height="20"
                                Data="{Binding PlayButtonIcon, Converter={StaticResource ResourceConverter}}" />
                        </Button>
                        <Grid Column="1" RowDefinitions="Auto,*">
                            <TextBlock
                                MaxWidth="180"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Classes="generalBold"
                                Margin="0,10,0,0"
                                FontSize="14"
                                Text="{Binding CurrentPlayingProfile.Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{Binding CurrentPlayingProfile.Name}" />
                            <TextBlock
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Classes="smallBoldSecondary"
                                FontSize="12"
                                Text="{Binding CurrentPlayingProfileDescription}" />
                        </Grid>
                    </Grid>

                </Border>
            </Button>
        </Grid>
    </Grid>
</UserControl>
