<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.SideMenu"
             x:DataType="local:SideMenuScreenViewModel"
             x:Class="Ambinity.Views.SideMenu.SideMenuScreenView">
    <Grid ColumnDefinitions="Auto,*">
        <PathIcon Width="18" Height="18" Margin="0,0,5,0"
                  Data="{Binding Icon,Converter={StaticResource ResourceConverter}}">
        </PathIcon>
        <TextBlock Grid.Column="1" Margin="5,0,0,0" Text="{Binding Content}"></TextBlock>
    </Grid>
</UserControl>