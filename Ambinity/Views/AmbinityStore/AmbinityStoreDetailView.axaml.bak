<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1000"
             xmlns:local="clr-namespace:Ambinity.Views.AmbinityStore"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:gif="clr-namespace:Avalonia.Gif;assembly=Avalonia.Gif"
             x:DataType="local:AmbinityStoreDetailViewModel"
             x:Class="Ambinity.Views.AmbinityStore.AmbinityStoreDetailView">
    <UserControl.Styles>
        <Style Selector=":is(Grid).gifImage">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button#playButton:pointerover :is(Grid).gifImage">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>
    <Border Padding="0">
        <StackPanel Spacing="10">
            <Border Margin="10"  Padding="0">
                <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                    <Grid>
                        <Border ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120"
                                Height="120"
                                CornerRadius="2">
                            <Image Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Source="{ Binding Item.GetThumbnail^}">
                            </Image>
                        </Border>
                    </Grid>
                    <Grid Column="2">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Item.OnlineItemData.Name}" FontSize="15"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold">
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Author : "
                                           FontSize="12">
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}"
                                           Text="{Binding Item.OnlineItemData.Owner}"
                                           FontSize="12">
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}"
                                           Text="Version : " FontSize="12">
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}"
                                           Text="{Binding Item.OnlineItemData.Version}"
                                           FontSize="12">
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,20,0,0" Orientation="Horizontal" Spacing="5">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}"
                                           VerticalAlignment="Center" Margin="0,0,0,1"
                                           Text="Category :" FontSize="12">
                                </TextBlock>
                                <HyperlinkButton Padding="5,0">
                                    <TextBlock Text="{Binding Item.OnlineItemData.Type }" Margin="0,0,0,1"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentButtonBackground}">
                                    </TextBlock>
                                </HyperlinkButton>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}"
                                           VerticalAlignment="Center" Margin="0,0,0,1"
                                           Text="Tags :" FontSize="12">
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Item.OnlineItemData.Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel></WrapPanel>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>
                                            <HyperlinkButton Padding="5,0">
                                                <TextBlock Text="{Binding }" Margin="0,0,0,1" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ButtonForegroundDisabled}">
                                                </TextBlock>
                                            </HyperlinkButton>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid Column="4">
                        <ui:ProgressRing Grid.Column="1" IsVisible="{CompiledBinding Item.IsDownloading}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top" IsIndeterminate="True" />
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" ColumnDefinitions="Auto,10,*">
                            <Border Padding="10,0" IsVisible="{Binding Item.IsLocalExisted}" Classes="chip" Height="30">
                                <Grid ColumnDefinitions="Auto,8,*">
                                    <PathIcon Foreground="{DynamicResource AccentButtonBackground}" Width="13"
                                              Height="13" Data="{DynamicResource checkBold}">
                                    </PathIcon>
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentButtonBackground}" Text="Installed"
                                               FontWeight="SemiBold" Grid.Column="2">
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Button Grid.Column="2" Classes="accent" VerticalAlignment="Bottom"
                                    IsVisible="{Binding !Item.IsLocalExisted}"
                                    Command="{CompiledBinding Item.DownloadItemCommand}" HorizontalAlignment="Right">
                                <Grid ColumnDefinitions="Auto,8,*">
                                    <PathIcon Width="15" Height="15" Data="{DynamicResource Import}"></PathIcon>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Install" FontSize="13"
                                               FontWeight="SemiBold">
                                    </TextBlock>
                                </Grid>
                            </Button>
                            <Button Grid.Column="2" Command="{CompiledBinding Item.DownloadItemCommand}"
                                    IsVisible="{Binding Item.IsLocalExisted}"
                                    HorizontalAlignment="Right">
                                <Grid ColumnDefinitions="Auto,8,*">
                                    <PathIcon Width="13" Height="13" Data="{DynamicResource download}"></PathIcon>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Reinstall"
                                               FontSize="13"
                                               FontWeight="SemiBold">
                                    </TextBlock>
                                </Grid>

                            </Button>
                        </Grid>

                    </Grid>
                </Grid>
            </Border>
            <ScrollViewer Margin="0,10,0,10" MaxHeight="560" Padding="0,0,10,10" VerticalAlignment="Bottom"
                          IsScrollInertiaEnabled="True">

                <StackPanel Margin="10,0" Spacing="10">
                    <TextBlock Text="{Binding Item.OnlineItemData.Description}"></TextBlock>
                    <Separator IsVisible="{Binding AvailableScreenshots.Count}" Height="1" HorizontalAlignment="Stretch" ></Separator>
                    <TextBlock IsVisible="{Binding AvailableScreenshots.Count}" FontWeight="SemiBold" FontSize="15" Text="Screenshots"></TextBlock>
                    <Border IsVisible="{Binding AvailableScreenshots.Count}" BorderBrush="{DynamicResource ButtonBorderBrush}" Height="400" CornerRadius="5"
                            BorderThickness="1">
                        <Grid>
                            <Border ClipToBounds="True" CornerRadius="2" Margin="5">
                                <Grid>
                                    <Image IsVisible="{Binding !CurrentScreenshot.IsAnimated}" Stretch="Uniform" Source="{Binding CurrentScreenshot.Image}"
                                           RenderOptions.BitmapInterpolationMode="HighQuality">
                                    </Image>
                                    <gif:GifImage IsVisible="{Binding CurrentScreenshot.IsAnimated}" Stretch="Uniform" SourceStream="{Binding CurrentScreenshot.AnimatedStream}"></gif:GifImage>
                                </Grid>
                             
                                
                            </Border>

                            <Button Padding="0" Margin="5" BorderThickness="1" Background="Transparent"
                                    HorizontalAlignment="Left" Command="{Binding PrevImageCommand}" Height="30" Width="30" CornerRadius="15">
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource ButtonBorderBrush}"
                                        Width="30" Height="30" CornerRadius="15" Margin="0" Padding="0"
                                        Classes="card">
                                    <PathIcon Margin="0,0,2,0" Width="10" Height="10"
                                              Data="{DynamicResource play_left}">
                                    </PathIcon>
                                </Border>

                            </Button>
                            <Button Command="{Binding NextImageCommand}" Padding="0" Margin="5" BorderThickness="1" Background="Transparent"
                                    HorizontalAlignment="Right" Height="30" Width="30" CornerRadius="15">
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource ButtonBorderBrush}"
                                        Width="30" Height="30" CornerRadius="15" Margin="0" Padding="0"
                                        Classes="card">
                                    <PathIcon Margin="0,0,0,0" Width="10" Height="10"
                                              Data="{DynamicResource play_right}">
                                    </PathIcon>
                                </Border>

                            </Button>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding AvailableScreenshots}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="5" Orientation="Horizontal"></StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <PathIcon IsVisible="{Binding !IsSelected}" VerticalAlignment="Center" Width="7" Data="{DynamicResource dot}"></PathIcon>
                                    <PathIcon IsVisible="{Binding IsSelected}" VerticalAlignment="Center" Width="10"
                                              Data="{DynamicResource selectedDot}">
                                    </PathIcon>
                                    
                                </Grid>
                               
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Height="1" HorizontalAlignment="Stretch" ></Separator>
                    <StackPanel Spacing="15">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="How to use">
                        </TextBlock>
                        <mdxaml:MarkdownScrollViewer Markdown="{Binding MDText}">

                        </mdxaml:MarkdownScrollViewer>
                    </StackPanel>

                    <Separator Height="1" HorizontalAlignment="Stretch"></Separator>
                    <StackPanel Spacing="15">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Additional information">
                        </TextBlock>
                        <UniformGrid Columns="4" Rows="1">
                            <Grid ColumnDefinitions="Auto,10,*" Column="0">
                                <PathIcon Margin="0,5" Foreground="{DynamicResource ButtonForegroundDisabled}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Data="{DynamicResource archive_box__box_content_banker_archive_file}"
                                          Width="15" Height="15">
                                </PathIcon>
                                <Grid Column="2" RowDefinitions="Auto,8,*">
                                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Foreground="{DynamicResource ButtonForegroundDisabled}"
                                               Text="Published by">

                                    </TextBlock>
                                    <TextBlock Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Foreground="{DynamicResource ButtonForegroundDisabled}"
                                               FontWeight="SemiBold" Text="{Binding Item.OnlineItemData.Owner}">
                                    </TextBlock>
                                </Grid>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,10,*" Column="1">
                                <PathIcon Margin="0,5" Foreground="{DynamicResource ButtonForegroundDisabled}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Data="{DynamicResource blank_calendar__blank_calendar_date_day_month_empty}"
                                          Width="15" Height="15">
                                </PathIcon>
                                <Grid Column="2" RowDefinitions="Auto,8,*">

                                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Foreground="{DynamicResource ButtonForegroundDisabled}"
                                               Text="Released date">

                                    </TextBlock>
                                    <TextBlock Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Foreground="{DynamicResource ButtonForegroundDisabled}"
                                               FontWeight="SemiBold" Text="{Binding Item.LastUpdate}">
                                    </TextBlock>

                                </Grid>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,10,*" Column="2">
                                <PathIcon Margin="0,5" Foreground="{DynamicResource ButtonForegroundDisabled}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Data="{DynamicResource bookmark_1__bookmarks_tags_favorite}" Width="15"
                                          Height="15">
                                </PathIcon>
                                <Grid Column="2" RowDefinitions="Auto,8,*">

                                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Category">

                                    </TextBlock>
                                    <TextBlock Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Foreground="{DynamicResource ButtonForegroundDisabled}"
                                               FontWeight="SemiBold" Text="{Binding Item.OnlineItemData.Type}">
                                    </TextBlock>

                                </Grid>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,10,*" Column="3">
                                <PathIcon Margin="0,5" Foreground="{DynamicResource ButtonForegroundDisabled}"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Data="{DynamicResource download_box_1__arrow_box_down_download_internet_network_server_upload}"
                                          Width="15" Height="15">
                                </PathIcon>
                                <Grid Column="2" RowDefinitions="Auto,8,*">

                                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Foreground="{DynamicResource ButtonForegroundDisabled}"
                                               Text="Approximate size">

                                    </TextBlock>
                                    <TextBlock Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Foreground="{DynamicResource ButtonForegroundDisabled}"
                                               FontWeight="SemiBold" Text="{Binding Item.FileSize}">
                                    </TextBlock>

                                </Grid>
                            </Grid>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>