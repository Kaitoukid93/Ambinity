<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        Width="800" Height="600"
        x:Class="Ambinity.Views.AmbinityStore.AmbinityStoreItemExportView"
        xmlns:local="clr-namespace:Ambinity.Views.AmbinityStore"
        xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        TransparencyLevelHint="Mica"
        RequestedThemeVariant="Dark"
        CanResize="False"
        x:DataType="local:AmbinityStoreItemExportViewModel"
        WindowStartupLocation="CenterScreen"
        Title="Item exporter">
    <Grid Margin="0,32,0,0" ColumnDefinitions="*,10,Auto">
        <Border Padding="0">
            <StackPanel Spacing="10">
                <Border Margin="10" Classes="card" Padding="10">
                    <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                        <Grid>
                            <Border ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top" Width="85"
                                    Height="85"
                                    CornerRadius="7">
                                <Image Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"
                                       Source="{Binding Thumbnail}">
                                </Image>
                            </Border>
                        </Grid>
                        <Grid Column="2">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center"
                                           FontWeight="SemiBold">
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Author : "
                                               FontSize="12">
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="{Binding Author}"
                                               FontSize="12">
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}"
                                               Text="Version : " FontSize="12">
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="{Binding Version}"
                                               FontSize="12">
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Margin="0,2,0,0" BorderThickness="1"
                                            BorderBrush="{DynamicResource AccentButtonBackground}"
                                            HorizontalAlignment="Left" Padding="5,2" Classes="chip">
                                        <TextBlock Text="{Binding Type}" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentButtonBackground}">
                                        </TextBlock>
                                    </Border>
                                    <Separator Height="16" Width="1"></Separator>
                                   <TextBlock Text="{Binding Tags}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ButtonForegroundDisabled}"></TextBlock>
                                </StackPanel>
                               
                            </StackPanel>
                        </Grid>
                        <Grid Column="4">
                            <!-- <Button Classes="accent" VerticalAlignment="Center" HorizontalAlignment="Right"> -->
                            <!--     <Grid ColumnDefinitions="Auto,8,*"> -->
                            <!--         <PathIcon Data="{DynamicResource Import}"></PathIcon> -->
                            <!--         <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Download" FontSize="13" -->
                            <!--                    FontWeight="SemiBold"> -->
                            <!--         </TextBlock> -->
                            <!--     </Grid> -->
                            <!-- </Button> -->
                        </Grid>
                    </Grid>
                </Border>
                <TabControl Padding="0">
                    <TabItem FontSize="15"  FontWeight="SemiBold" Header="Overview">
                        <ScrollViewer Margin="0,10,0,10" MaxHeight="360" VerticalAlignment="Bottom" IsScrollInertiaEnabled="True">
                            <StackPanel Margin="10,0" Spacing="10">
                                <TextBlock Text="{Binding Description}"></TextBlock>
                                <Border BorderBrush="{DynamicResource ButtonBorderBrush}" Height="250" CornerRadius="5"
                                        BorderThickness="1">
                                    <Grid>
                                        <Border ClipToBounds="True" CornerRadius="2" Margin="5">
                                            <Image Stretch="UniformToFill"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                                   Source="C:\Users\zOe\Pictures\IMG_6918.JPG">
                                            </Image>
                                        </Border>

                                        <Button Padding="0" Margin="5" BorderThickness="1" Background="Transparent"
                                                HorizontalAlignment="Left" Height="30" Width="30" CornerRadius="15">
                                            <Border BorderThickness="1"
                                                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                                                    Width="30" Height="30" CornerRadius="15" Margin="0" Padding="0"
                                                    Classes="card">
                                                <PathIcon Margin="0,0,2,0" Width="10" Height="10"
                                                          Data="{DynamicResource play_left}">
                                                </PathIcon>
                                            </Border>

                                        </Button>
                                        <Button Padding="0" Margin="5" BorderThickness="1" Background="Transparent"
                                                HorizontalAlignment="Right" Height="30" Width="30" CornerRadius="15">
                                            <Border BorderThickness="1"
                                                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                                                    Width="30" Height="30" CornerRadius="15" Margin="0" Padding="0"
                                                    Classes="card">
                                                <PathIcon Margin="0,0,0,0" Width="10" Height="10"
                                                          Data="{DynamicResource play_right}">
                                                </PathIcon>
                                            </Border>

                                        </Button>
                                    </Grid>
                                </Border>
                                <ItemsControl HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="5" Orientation="Horizontal"></StackPanel>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Items>
                                        <PathIcon VerticalAlignment="Center" Width="7" Data="{DynamicResource dot}"></PathIcon>
                                        <PathIcon VerticalAlignment="Center" Width="10"
                                                  Data="{DynamicResource selectedDot}">
                                        </PathIcon>
                                        <PathIcon VerticalAlignment="Center" Width="7" Data="{DynamicResource dot}"></PathIcon>
                                        <PathIcon Width="7" Data="{DynamicResource dot}"></PathIcon>
                                    </ItemsControl.Items>
                                </ItemsControl>
                                <mdxaml:MarkdownScrollViewer Markdown="{Binding ElementName=md,Path=Text}">

                                                </mdxaml:MarkdownScrollViewer>
                            </StackPanel>
                        </ScrollViewer>
                        
                    </TabItem>
                    <TabItem FontSize="15" FontWeight="SemiBold" Header="Info">
                        <ContentControl></ContentControl>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Border>
        
        <Grid Width="350" Column="2" RowDefinitions="*,10,Auto">
            <ScrollViewer Margin="0,10,0,0" Padding="10,0" MaxHeight="500" IsScrollInertiaEnabled="True">
                  <StackPanel Orientation="Vertical" Spacing="10">

                <StackPanel Spacing="8">
                    <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold"></TextBlock>
                    <TextBox Text="{Binding Name}" VerticalContentAlignment="Center"></TextBox>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold"></TextBlock>
                    <TextBox Text="{Binding Description}" VerticalContentAlignment="Center"></TextBox>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Author" FontSize="12" FontWeight="SemiBold"></TextBlock>
                    <TextBox Text="{Binding Author}" VerticalContentAlignment="Center"></TextBox>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Version" FontSize="12" FontWeight="SemiBold"></TextBlock>
                    <TextBox Text="{Binding Version}" VerticalContentAlignment="Center"></TextBox>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Thumbnail" FontSize="12" FontWeight="SemiBold"></TextBlock>
                    <TextBox Text="{Binding Thumbnail}" VerticalContentAlignment="Center">
                        <TextBox.InnerRightContent>
                            <Button Command="{Binding  OpenThumbnailPickerCommand}" Margin="5" Padding="5,2" Content="Browse..."></Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Screenshots" FontSize="12" FontWeight="SemiBold"></TextBlock>
                    <TextBox VerticalContentAlignment="Center">
                        <TextBox.InnerRightContent>
                            <Button Command="{Binding OpenScreenShotsPickerCommand}" Margin="5" Padding="5,2" Content="Browse..."></Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Markdown description" FontSize="12" FontWeight="SemiBold"></TextBlock>
                    <TextBox x:Name="md" Text="{Binding MDText}" AcceptsReturn="True" VerticalContentAlignment="Center">

                    </TextBox>
                </StackPanel>
                      <StackPanel Spacing="8">
                          <TextBlock Text="Tags [separate with a comma, no space]" FontSize="12" FontWeight="SemiBold"></TextBlock>
                          <TextBox Text="{Binding Tags}" AcceptsReturn="True" VerticalContentAlignment="Center">

                          </TextBox>
                      </StackPanel>
            </StackPanel>
            </ScrollViewer>
          
            <StackPanel Grid.Row="2" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal"
                        Spacing="10">
                <Button Classes="icon-button" Content="Cancel"></Button>
                <Button Command="{Binding ExportItemLocallyCommand}" Padding="7,5" VerticalContentAlignment="Center">
                    <Grid ColumnDefinitions="Auto,8,*">
                        <PathIcon Data="{DynamicResource upload_file}"></PathIcon>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Export locally" FontSize="13"
                                   FontWeight="SemiBold">
                        </TextBlock>
                    </Grid>
                </Button>
                <Button Command="{Binding ExportItemForServerCommand}" Classes="accent" Padding="7,5" VerticalContentAlignment="Center">
                    <Grid ColumnDefinitions="Auto,8,*">
                        <PathIcon Data="{DynamicResource send_email__mail_send_email_paper_airplane}"></PathIcon>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Export" FontSize="13"
                                   FontWeight="SemiBold">
                        </TextBlock>
                    </Grid>
                </Button>

            </StackPanel>
        </Grid>
    </Grid>
</Window>