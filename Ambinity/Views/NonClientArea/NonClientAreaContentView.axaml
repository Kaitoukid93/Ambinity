<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="40"
             xmlns:local = "clr-namespace:Ambinity.Views.NonClientArea"
             x:DataType="local:NonClientAreaContentViewModel"
             x:Class="Ambinity.Views.NonClientArea.NonClientAreaContentView">
   <Grid IsVisible="{Binding ShowIconAndAppName}" ColumnDefinitions="Auto,Auto,Auto,*">
       <Grid>
           <Image RenderOptions.BitmapInterpolationMode="HighQuality" Margin="15,15,10,10" Height="20" Width="20"            
                     Source="avares://Ambinity/Assets/appicon.ico"/>
       </Grid>
       <Grid Margin="0,2,0,0" Column="1" VerticalAlignment="Center">
           <TextBlock Theme="{StaticResource CaptionTextBlockStyle}" Text="Ambinity"></TextBlock>
       </Grid>
       <!-- <Button Command="{Binding ShowAppTourCommand}" Grid.Column="2" Margin="10,0,0,0" Classes="icon-button" > -->
       <!--     <PathIcon Data="{DynamicResource Boost}"></PathIcon> -->
       <!-- </Button> -->
   </Grid>
</UserControl>
