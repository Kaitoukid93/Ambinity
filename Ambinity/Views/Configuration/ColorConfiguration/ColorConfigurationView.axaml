<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration"
             xmlns:attachedProperties="clr-namespace:Ambinity.AttachedProperties"
             xmlns:param="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
             x:DataType="local:ColorConfigurationViewModelBase"
             x:Class="Ambinity.Views.Configuration.ColorConfiguration.ColorConfigurationView">
    <Grid IsEnabled="{Binding IsEnabled}" MinWidth="300">
        <ItemsControl ItemsSource="{Binding Parameters}">
        </ItemsControl>
    </Grid>
</UserControl>