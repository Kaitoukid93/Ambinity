<UserControl
    x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.GifAnimationThumbnailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gif="clr-namespace:Avalonia.Gif;assembly=Avalonia.Gif"
    xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:GifAnimationThumbnailViewModel"
    mc:Ignorable="d">
    <Grid>
        <gif:GifImage SourceStream="{Binding ThumbnailStream}" Stretch="Uniform" />
    </Grid>
</UserControl>
