<UserControl
    x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.LottieAnimationThumbnailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:LottieAnimationThumbnailViewModel"
    mc:Ignorable="d">
    <Grid>
        <Lottie Margin="5" Path="{Binding ThumbnailPath}" />
    </Grid>
</UserControl>
