<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
             x:DataType="local:AnimationAssetViewModel"
             x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.AnimationAssetView">
    <Button Command="{Binding SelectItemCommand}" MinWidth="270" Margin=" 0,5" HorizontalContentAlignment="Stretch" Padding="0" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="100,10,*" Height="100">
            <Grid>
                <Border Classes="card" BorderThickness="1" Padding="0" Width="90" Height="90" CornerRadius="7">
                    <Lottie Margin="5" Path="{Binding AnimationJsonPath}"></Lottie>
                </Border>
            </Grid>
            <Grid Column="2" RowDefinitions="Auto,30,*,Auto">
                <TextBlock ToolTip.Tip="{Binding Name}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                           MaxWidth="180" Grid.Row="0" Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding Name}">
                </TextBlock>
                <Grid Row="1" RowDefinitions="*,*">
                    <TextBlock FontSize="12" Foreground="{DynamicResource ButtonForegroundDisabled}"
                               Text="{Binding Description }">
                    </TextBlock>
                </Grid>
            </Grid>

        </Grid>
    </Button>
</UserControl>