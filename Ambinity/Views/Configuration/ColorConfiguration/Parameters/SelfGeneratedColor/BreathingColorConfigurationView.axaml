<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="472"
             xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
             x:DataType="local:BreathingColorConfigurationViewModel"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:attachedProperties="clr-namespace:Ambinity.AttachedProperties"
             x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.BreathingColorConfigurationView">
   <Grid RowDefinitions="40,10,5,10,*" Width="300" Height="472">
        <Grid Margin="10,10,20,0" ColumnDefinitions="Auto,10,*">
            <PathIcon Width="25" Height="25" Data="{Binding Icon,Converter={StaticResource ResourceConverter}}"></PathIcon>
            <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Text="{localize:Loc Breathing.TextBlock.Text}">
            </TextBlock>
        </Grid>
        <Separator Margin="10,0" Grid.Row="2"></Separator>
        <ScrollViewer Padding="10,0,10,10" Grid.Row="4" IsScrollInertiaEnabled="True">
          <Grid Margin="10,0">
            <StackPanel Spacing="35">
                <Grid RowDefinitions="Auto,5,Auto">
                    <Grid Row="0" ColumnDefinitions="Auto,*">
                        <TextBlock Margin="0,8" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13"
                                   Text="{localize:Loc HWLightingSpeed.SettingsExpanderItem.Header}">
                        </TextBlock>
                        <Grid Column="1">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <ToggleButton ToolTip.Tip="{localize:Loc SystemSync.ToggleButton.ToolTip}" BorderThickness="0"
                                              Background="Transparent" Width="30" Height="30" Grid.Column="1"
                                              IsChecked="{CompiledBinding IsSystemSync}"
                                              HorizontalAlignment="Right">
                                    <PathIcon Width="15" Margin="0,1,0,0" Data="{DynamicResource 'update'}"></PathIcon>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Row="2" ColumnDefinitions="*,12,Auto">
                        <Grid Column="0">
                            <Slider x:Name="speedSlider"
                                    Width="190"
                                    Value="{CompiledBinding BreathingSpeed}"
                                    SmallChange="1"
                                    LargeChange="5"
                                    Minimum="0" Maximum="2000" HorizontalAlignment="Left">
                            </Slider>
                        </Grid>
                        <Grid Column="2">
                            <Grid>
                                <TextBox
                                    HorizontalAlignment="Left"
                                    Height="20"
                                    HorizontalContentAlignment="Right"
                                    BorderThickness="0"
                                    Width="40"
                                    Text="{Binding BreathingSpeed,StringFormat={}{0:F0}}">
                                </TextBox>
                            </Grid>
                        </Grid>
                </Grid>
                </Grid>
                
            </StackPanel>

        </Grid>
        </ScrollViewer>
      
    </Grid>
</UserControl>