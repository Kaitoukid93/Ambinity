<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
             x:DataType="local:ColorBehaviorParameterViewModel"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:attachedProperties="clr-namespace:Ambinity.AttachedProperties"
             x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.ColorBehaviorParameterView">
    <UserControl.Resources>
        <MenuFlyout x:Key="IntensityValueFlyout" 
                    Placement="Bottom">
            <MenuItem Command="{CompiledBinding SetQuickResolutionCommand}"
                CommandParameter="0.25"
                Header="25%">
            </MenuItem>
            <MenuItem  Command="{CompiledBinding SetQuickResolutionCommand}"
                       CommandParameter="0.5"
                       Header="50%">
            </MenuItem>
            <MenuItem  Command="{CompiledBinding SetQuickResolutionCommand}"
                       CommandParameter="0.75"
                       Header="75%">
            </MenuItem>
            <MenuItem  Command="{CompiledBinding SetQuickResolutionCommand}"
                       Foreground="{DynamicResource SystemAccentColor}"
                       CommandParameter="1.0"
                       Header="100%">
            </MenuItem>
            <MenuItem  Command="{CompiledBinding SetQuickResolutionCommand}"
                       CommandParameter="1.25"
                       Header="125%">
            </MenuItem>
            <MenuItem  Command="{CompiledBinding SetQuickResolutionCommand}"
                       CommandParameter="1.5"
                       Header="150%">
            </MenuItem>
            <MenuItem  Command="{CompiledBinding SetQuickResolutionCommand}"
                       CommandParameter="1.75"
                       Header="175%">
            </MenuItem>
            <MenuItem  Command="{CompiledBinding SetQuickResolutionCommand}"
                       CommandParameter="2.0"
                       Header="200%">
            </MenuItem>
        </MenuFlyout>
    
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*,*">
        <Grid Row="0" ColumnDefinitions="Auto,*">
            <TextBlock Margin="0,8" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13"
                       Text="Colors behavior">
            </TextBlock>
            <Grid Column="1">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5">
                    <ToggleButton ToolTip.Tip="Reverse direction" BorderThickness="0" IsChecked="{Binding IsReverse}"
                                  Background="Transparent" Width="30" Height="30" Grid.Column="1"
                                  HorizontalAlignment="Right">
                        <PathIcon Width="16" Margin="0,0,0,0" Data="{DynamicResource 'flip_horizontal'}"></PathIcon>
                    </ToggleButton>
                    <ToggleButton ToolTip.Tip="System sync" BorderThickness="0"
                                  Background="Transparent" Width="30" Height="30" Grid.Column="1"
                                  HorizontalAlignment="Right">
                        <PathIcon Width="16" Margin="0,0,0,0" Data="{DynamicResource 'time_sync'}"></PathIcon>
                    </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsColorMoving}" BorderThickness="0"
                                      ToolTip.Tip="Cycle colors" Padding="1"
                                      Background="Transparent" Width="30" Height="30">
                            <PathIcon Width="16" Margin="0,0,0,0"
                                      Data="{DynamicResource cycle}">
                            </PathIcon>
                        </ToggleButton>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="10">
            <Grid RowDefinitions="auto,*">
                <Grid>
                    <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Blend mode"></TextBlock>
                </Grid>
                <Grid Margin="0,8" Row="1" ColumnDefinitions="*,12,32,6,Auto">
                    <ui:FAComboBox x:Name="blendModeCombobox" SelectedIndex="{Binding BlendMode}"
                                   HorizontalAlignment="Stretch">
                        <ui:FAComboBoxItem>No blend</ui:FAComboBoxItem>
                        <ui:FAComboBoxItem>Linear Blend</ui:FAComboBoxItem>

                    </ui:FAComboBox>
                    <!-- <PathIcon IsVisible="{Binding ShowBlendValue}" Foreground="{DynamicResource ButtonForegroundDisabled}" -->
                    <!--           Data="{DynamicResource contrast}" Width="20" Grid.Column="2"> -->
                    <!-- </PathIcon> -->
                    <Grid Width="65" Column="4">

                    </Grid>
                    <!-- <TextBox MaxWidth="65" IsVisible="{Binding ShowBlendValue}" -->
                    <!--          attachedProperties:TextBoxAssist.SuffixText="st" -->
                    <!--          HorizontalContentAlignment="Right" -->
                    <!--          BorderThickness="0" Grid.Column="4" Text="{Binding BlendValue}" Height="20" -->
                    <!--          Margin="0,0,0,0"> -->
                    <!-- </TextBox> -->

                </Grid>


            </Grid>
            <Grid RowDefinitions="Auto,*">
                <Grid>
                    <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Color Resolution"></TextBlock>
                </Grid>
                <Grid Row="1" ColumnDefinitions="*,12,Auto">
                    <Grid Column="0">
                        <Slider  x:Name="intensitySlider"
                                 
                                Value="{CompiledBinding Resolution }"
                                Width="190"
                                SmallChange="0.1"
                                LargeChange="0.5"
                                Minimum="0" Maximum="200" HorizontalAlignment="Left">
                        </Slider>
                    </Grid>
                    <Grid Column="2">
                        <SplitButton HorizontalContentAlignment="Stretch" ToolTip.Tip="Quick select"
                                     Padding="0"
                                     Width="100"
                                     VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1"
                                     Height="20"
                                     Margin="0,0,0,0"
                                     Flyout="{StaticResource IntensityValueFlyout}">
                            <Grid>
                                <TextBox CornerRadius="4,0,0,4" Background="Transparent"
                                         HorizontalAlignment="Left"
                                         HorizontalContentAlignment="Right"
                                         attachedProperties:TextBoxAssist.SuffixText="%"
                                         BorderThickness="0"
                                         Text="{Binding ElementName=intensitySlider,Path=Value, StringFormat=N1}">
                                </TextBox>
                            </Grid>

                        </SplitButton>
                    </Grid>
                </Grid>

                <!--<Grid Column="4">
                <Button ToolTip.Tip="Setting" Background="Transparent" Width="30" Height="30" Classes="icon-button" >
                    <PathIcon Width="15" Data="{DynamicResource Zone_layer_icon}"></PathIcon>
                </Button>
            </Grid>-->
            </Grid>
            <Grid IsVisible="{Binding IsColorMoving}" RowDefinitions="Auto,*">
                <Grid Row="0" ColumnDefinitions="Auto,*">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                               Foreground="{DynamicResource ButtonForegroundDisabled}"
                               Text="Speed">
                    </TextBlock>
                </Grid>
                <Grid Row="1" ColumnDefinitions="*,12,Auto">
                    <Grid Column="0">
                        <Slider x:Name="speedSlider"
                                Value="{Binding Speed}"
                                Width="190"
                                SmallChange="0.1"
                                LargeChange="0.5"
                                Minimum="0.1" Maximum="50" HorizontalAlignment="Left">
                        </Slider>
                    </Grid>
                    <Grid Column="2">
                            <Grid>
                                <TextBox
                                         HorizontalAlignment="Left"
                                         Height="20"
                                         HorizontalContentAlignment="Right"
                                         attachedProperties:TextBoxAssist.SuffixText="rpm"
                                         BorderThickness="0"
                                         Width="100"
                                         Text="{Binding ElementName=speedSlider,Path=Value,StringFormat=N1}">
                                </TextBox>
                            </Grid>
                    </Grid>
                    <!--<Grid Column="4">
                <Button ToolTip.Tip="Setting" Background="Transparent" Width="30" Height="30" Classes="icon-button" >
                    <PathIcon Width="15" Data="{DynamicResource Zone_layer_icon}"></PathIcon>
                </Button>
            </Grid>-->
                </Grid>

            </Grid>
        </StackPanel>


    </Grid>
</UserControl>