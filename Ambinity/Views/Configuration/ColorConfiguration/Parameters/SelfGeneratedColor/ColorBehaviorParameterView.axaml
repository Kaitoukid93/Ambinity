<UserControl
    x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.ColorBehaviorParameterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="clr-namespace:Ambinity.AttachedProperties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:ColorBehaviorParameterViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <MenuFlyout x:Key="IntensityValueFlyout" Placement="Bottom">
            <MenuItem
                Command="{CompiledBinding SetQuickResolutionCommand}"
                CommandParameter="0.25"
                Header="25%" />
            <MenuItem
                Command="{CompiledBinding SetQuickResolutionCommand}"
                CommandParameter="0.5"
                Header="50%" />
            <MenuItem
                Command="{CompiledBinding SetQuickResolutionCommand}"
                CommandParameter="0.75"
                Header="75%" />
            <MenuItem
                Command="{CompiledBinding SetQuickResolutionCommand}"
                CommandParameter="1.0"
                Foreground="{DynamicResource SystemAccentColor}"
                Header="100%" />
            <MenuItem
                Command="{CompiledBinding SetQuickResolutionCommand}"
                CommandParameter="1.25"
                Header="125%" />
            <MenuItem
                Command="{CompiledBinding SetQuickResolutionCommand}"
                CommandParameter="1.5"
                Header="150%" />
            <MenuItem
                Command="{CompiledBinding SetQuickResolutionCommand}"
                CommandParameter="1.75"
                Header="175%" />
            <MenuItem
                Command="{CompiledBinding SetQuickResolutionCommand}"
                CommandParameter="2.0"
                Header="200%" />
        </MenuFlyout>

    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*,*">
        <Grid ColumnDefinitions="Auto,*" Row="0">
            <TextBlock
                Margin="0,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="13"
                Text="Colors behavior" />
            <Grid Column="1">
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="5">
                    <ToggleButton
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{Binding IsReverse}"
                        ToolTip.Tip="Reverse direction">
                        <PathIcon
                            Width="16"
                            Margin="0,0,0,0"
                            Data="{DynamicResource 'flip_horizontal'}" />
                    </ToggleButton>
                    <ToggleButton
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip.Tip="System sync">
                        <PathIcon
                            Width="16"
                            Margin="0,0,0,0"
                            Data="{DynamicResource 'time_sync'}" />
                    </ToggleButton>
                    <ToggleButton
                        Width="30"
                        Height="30"
                        Padding="1"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{Binding IsColorMoving}"
                        ToolTip.Tip="Cycle colors">
                        <PathIcon
                            Width="16"
                            Margin="0,0,0,0"
                            Data="{DynamicResource cycle}" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="10">
            <Grid RowDefinitions="auto,*">
                <Grid>
                    <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Blend mode" />
                </Grid>
                <Grid
                    Margin="0,8"
                    ColumnDefinitions="*,12,32,6,Auto"
                    Row="1">
                    <ui:FAComboBox
                        x:Name="blendModeCombobox"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{Binding BlendMode}">
                        <ui:FAComboBoxItem>No blend</ui:FAComboBoxItem>
                        <ui:FAComboBoxItem>Linear Blend</ui:FAComboBoxItem>

                    </ui:FAComboBox>
                    <!--  <PathIcon IsVisible="{Binding ShowBlendValue}" Foreground="{DynamicResource ButtonForegroundDisabled}"  -->
                    <!--  Data="{DynamicResource contrast}" Width="20" Grid.Column="2">  -->
                    <!-- </PathIcon> -->
                    <Grid Width="65" Column="4" />
                    <!--  <TextBox MaxWidth="65" IsVisible="{Binding ShowBlendValue}"  -->
                    <!--  attachedProperties:TextBoxAssist.SuffixText="st"  -->
                    <!--  HorizontalContentAlignment="Right"  -->
                    <!--  BorderThickness="0" Grid.Column="4" Text="{Binding BlendValue}" Height="20"  -->
                    <!--  Margin="0,0,0,0">  -->
                    <!-- </TextBox> -->

                </Grid>


            </Grid>
            <Grid RowDefinitions="Auto,*">
                <Grid>
                    <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Color Resolution" />
                </Grid>
                <Grid ColumnDefinitions="*,12,Auto" Row="1">
                    <Grid Column="0">
                        <Slider
                            x:Name="intensitySlider"
                            Width="190"
                            HorizontalAlignment="Left"
                            LargeChange="0.5"
                            Maximum="200"
                            Minimum="0"
                            SmallChange="0.1"
                            Value="{CompiledBinding Resolution}" />
                    </Grid>
                    <Grid Column="2">
                        <SplitButton
                            Width="100"
                            Margin="0,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            BorderThickness="1"
                            Flyout="{StaticResource IntensityValueFlyout}"
                            ToolTip.Tip="Quick select">
                            <Grid>
                                <ui:NumberBox
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4,0,0,4"
                                    Maximum="200"
                                    Minimum="0"
                                    SimpleNumberFormat="F2"
                                    Theme="{DynamicResource borderlessNumberBox}"
                                    Value="{Binding ElementName=intensitySlider, Path=Value}" />
                            </Grid>

                        </SplitButton>
                    </Grid>
                </Grid>

                <!--<Grid Column="4">
                <Button ToolTip.Tip="Setting" Background="Transparent" Width="30" Height="30" Classes="icon-button" >
                    <PathIcon Width="15" Data="{DynamicResource Zone_layer_icon}"></PathIcon>
                </Button>
            </Grid>-->
            </Grid>
            <Grid IsVisible="{Binding IsColorMoving}" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,*" Row="0">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ButtonForegroundDisabled}"
                        Text="Speed" />
                </Grid>
                <Grid ColumnDefinitions="*,12,Auto" Row="1">
                    <Grid Column="0">
                        <Slider
                            x:Name="speedSlider"
                            Width="190"
                            HorizontalAlignment="Left"
                            LargeChange="0.5"
                            Maximum="50"
                            Minimum="0.1"
                            SmallChange="0.1"
                            Value="{Binding Speed}" />
                    </Grid>
                    <Grid Column="2">
                        <Grid>
                            <ui:NumberBox
                                Width="100"
                                HorizontalAlignment="Left"
                                BorderThickness="0"
                                SimpleNumberFormat="F2"
                                Theme="{DynamicResource borderlessNumberBox}"
                                Value="{Binding ElementName=speedSlider, Path=Value}" />
                        </Grid>
                    </Grid>
                    <!--<Grid Column="4">
                <Button ToolTip.Tip="Setting" Background="Transparent" Width="30" Height="30" Classes="icon-button" >
                    <PathIcon Width="15" Data="{DynamicResource Zone_layer_icon}"></PathIcon>
                </Button>
            </Grid>-->
                </Grid>

            </Grid>
        </StackPanel>


    </Grid>
</UserControl>
