<UserControl
    x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.MusicReactiveConfigurationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
    xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:MusicReactiveConfigurationViewModel"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid
        Width="300"
        Height="472"
        RowDefinitions="40,10,5,10,*">
        <Grid Margin="10,10,20,0" ColumnDefinitions="Auto,10,*">
            <PathIcon
                Width="25"
                Height="25"
                Data="{Binding Icon, Converter={StaticResource ResourceConverter}}" />
            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="Music Reactive" />
        </Grid>
        <Separator Grid.Row="2" Margin="10,0" />
        <ScrollViewer
            Grid.Row="4"
            Padding="10,0,10,10"
            IsScrollInertiaEnabled="True">
            <Grid Margin="10,0">
                <StackPanel Spacing="35">
                    <Grid RowDefinitions="Auto,10,Auto">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="Audio device" />
                            <CheckBox
                                x:Name="isDefaultCheckBox"
                                HorizontalAlignment="Right"
                                Content="Use default"
                                IsChecked="{Binding IsDefault}" />
                        </Grid>

                        <ui:FAComboBox
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding ElementName=isDefaultCheckBox, Path=!IsChecked}"
                            ItemsSource="{Binding AvailableAudioDevices}"
                            SelectedItem="{Binding SelectedAudioDevice}">
                            <ui:FAComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ui:FAComboBox.ItemTemplate>
                        </ui:FAComboBox>
                    </Grid>
                    <Grid RowDefinitions="Auto,10,Auto">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="Frequency range" />
                                <!-- <Grid>
                                    <Button Click="InfoButton_OnClick" x:Name="infoButton" Background="Transparent"
                                            BorderThickness="0" Classes="icon-button-small" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Margin="0,8">
                                        <PathIcon Width="15" Height="15" Data="{DynamicResource infoCircle}"></PathIcon>
                                    </Button>
                                    <ui:TeachingTip x:Name="infoTip"
                                                    IsLightDismissEnabled="True"
                                                    Target="{Binding #infoButton}"
                                                    Title="Frequencies"
                                                    Subtitle="Use the range slider below to select frequencies">
                                    </ui:TeachingTip>
                                </Grid>-->
                            </StackPanel>


                        </Grid>

                        <Grid Row="2" RowDefinitions="70,10,Auto">
                            <ItemsControl ItemsSource="{Binding Frequencies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="32" Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ProgressBar
                                            MinHeight="60"
                                            HorizontalAlignment="Stretch"
                                            Background="Transparent"
                                            Maximum="255"
                                            Orientation="Vertical"
                                            Value="{Binding Value}">
                                            <ProgressBar.Foreground>
                                                <SolidColorBrush Color="{Binding ForeGround}" />
                                            </ProgressBar.Foreground>
                                        </ProgressBar>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:RangeSlider
                                Grid.Row="2"
                                Maximum="31"
                                Minimum="0"
                                MinimumRange="1"
                                RangeEnd="{Binding StopFrequency}"
                                RangeStart="{Binding StartFrequency}" />
                        </Grid>
                    </Grid>
                    <Grid RowDefinitions="Auto,10,Auto">
                        <TextBlock VerticalAlignment="Center" Text="Visualizer style" />
                        <Grid ColumnDefinitions="*,Auto,Auto" Row="2">
                            <ui:FAComboBox
                                Name="visualStyleBox"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding AvailableVisualStyles}"
                                SelectedItem="{Binding VisualizerStyle}">
                                <ui:FAComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ui:FAComboBox.ItemTemplate>

                            </ui:FAComboBox>
                            <Grid
                                Width="10"
                                Column="1"
                                IsVisible="{Binding ElementName=visualStyleBox, Path=SelectedIndex}" />
                            <Grid Column="2" IsVisible="{Binding ElementName=visualStyleBox, Path=SelectedIndex}">
                                <Border
                                    Padding="0"
                                    BorderThickness="1"
                                    Classes="card"
                                    CornerRadius="7">
                                    <ListBox
                                        Margin="0,0,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        ItemContainerTheme="{DynamicResource _optionsListboxItem}"
                                        ItemsSource="{Binding VUModes}"
                                        SelectedIndex="{Binding VuMode}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="1" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <PathIcon
                                                    Width="18"
                                                    Height="18"
                                                    Data="{Binding ., Converter={StaticResource ResourceConverter}}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                            </Grid>
                        </Grid>

                    </Grid>

                    <Grid RowDefinitions="Auto,10,Auto">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="No sound behavior" />
                                <!-- <Grid>
                                    <Button Click="NoSoundTeachingButton_OnClick" x:Name="nosoundTeaching"
                                            Background="Transparent" BorderThickness="0" Classes="icon-button-small"
                                            HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <PathIcon Width="15" Height="15" Data="{DynamicResource infoCircle}"></PathIcon>
                                    </Button>
                                    <ui:TeachingTip IsLightDismissEnabled="True" x:Name="nosoundTip"
                                                    HeroContentPlacement="Auto"
                                                    Target="{Binding ElementName=nosoundTeaching}">
                                        <ui:TeachingTip.HeroContent>
                                            <Border CornerRadius="7,7,0,0"  Background="{Binding #nosoundTip.Background}" Padding="10">
                                                <mdxaml:MarkdownScrollViewer xml:space="preserve">
##### **How the LEDs behavior when there is no sound captured for the period of time**

 * **Keep LEDs off** : The LEDs will stay off as there is no sound present
 * **Return to normal lighting** : The LEDs will show full brightness and will react to music when the sound data is available in the buffer

Learn more at [Ambino](https://ambino.vn)
                                                </mdxaml:MarkdownScrollViewer>
                                            </Border>
                                        </ui:TeachingTip.HeroContent>
                                    </ui:TeachingTip>
                                </Grid>-->

                            </StackPanel>


                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" Row="2">
                            <ui:FAComboBox
                                Name="behaviorBox"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                SelectedIndex="{Binding NoSoundBehavior}">
                                <ui:FAComboBoxItem>
                                    <TextBlock Text="Keep LEDs off" />
                                </ui:FAComboBoxItem>
                                <ui:FAComboBoxItem>
                                    <TextBlock Text="Return to normal lighting" />
                                </ui:FAComboBoxItem>
                            </ui:FAComboBox>
                        </Grid>
                    </Grid>
                </StackPanel>

            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
