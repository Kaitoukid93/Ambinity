<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
             x:DataType="local:ColorAppearanceParameterViewModel"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:attachedProperties="clr-namespace:Ambinity.AttachedProperties"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.ColorAppearanceParameterView">
    <Grid RowDefinitions="Auto,*,*">
        <Grid Row="0" ColumnDefinitions="Auto,*">
            <TextBlock Margin="0,8" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13"
                       Text="Appearance">
            </TextBlock>
            <Grid Column="1">
                <Button HorizontalContentAlignment="Right" Click="ApearanceGuide_OnClick" x:Name="nosoundTeaching"
                        Background="Transparent" Classes=" icon-button icon-button-small"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                    <PathIcon Width="15" Height="15" Data="{DynamicResource infoCircle}"></PathIcon>
                </Button>
                <ui:TeachingTip Padding="10" IsLightDismissEnabled="True" x:Name="apperanceGuide"
                                HeroContentPlacement="Auto"
                                Target="{Binding ElementName=nosoundTeaching}">
                    <ui:TeachingTip.HeroContent>
                        <Border CornerRadius="7,7,0,0" Background="{Binding #apperanceGuide.Background}" Padding="10">
                            <mdxaml:MarkdownScrollViewer xml:space="preserve">
##### **Color appearance quick guide**

 * **Fill entire zone** : All LEDs that covered by this zone will be activated
 * **Apply stroke only** : Only the area define by stroke value ( in pixel) will be activated. Stroke value should be lower than 5px and consider using **Fill entire zone** when the desired stroke is greater than 10
 
Learn more at [Ambino](https://ambino.vn)
                                                </mdxaml:MarkdownScrollViewer>
                        </Border>
                    </ui:TeachingTip.HeroContent>
                </ui:TeachingTip>
            </Grid>
        </Grid>
        <Grid Margin="0,8" Row="2" ColumnDefinitions="*,12,32,6,Auto">
            <ui:FAComboBox x:Name="appearanceCombobox" ItemsSource="{CompiledBinding AppearanceModes}"
                           SelectedItem="{CompiledBinding Appearance}" HorizontalAlignment="Stretch">
                <ui:FAComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding }"></TextBlock>
                    </DataTemplate>
                </ui:FAComboBox.ItemTemplate>

            </ui:FAComboBox>
            <PathIcon Foreground="{DynamicResource ButtonForegroundDisabled}"
                      Data="{Binding Icon,Converter={StaticResource ResourceConverter}}" Width="20" Grid.Column="2">
            </PathIcon>
            <TextBox HorizontalContentAlignment="Right"
                     attachedProperties:TextBoxAssist.SuffixText="{Binding ValueSuffix}"
                     BorderThickness="0" Grid.Column="4" Text="{Binding AppearanceValue}" Height="20"
                     Margin="0,0,0,0">
            </TextBox>
        </Grid>

    </Grid>
</UserControl>