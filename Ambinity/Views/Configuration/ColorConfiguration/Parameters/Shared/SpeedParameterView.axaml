<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:attachedProperties="clr-namespace:Ambinity.AttachedProperties"
             x:DataType="local:SpeedParameterViewModel"
             x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.SpeedParameterView">
   <UserControl.Resources>
        <MenuFlyout x:Key="SpeedValueFlyout"
                    Placement="Bottom">
            <MenuItem
                CommandParameter="0.25"
                Header="20%">
            </MenuItem>
            <MenuItem
                CommandParameter="0.5"
                Header="40%">
            </MenuItem>
            <MenuItem
                CommandParameter="0.75"
                Header="60%">
            </MenuItem>
            <MenuItem
                CommandParameter="1"
                Header="80%">
            </MenuItem>
        </MenuFlyout>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid Row="0" ColumnDefinitions="Auto,*">
            <TextBlock Margin="0,8" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13"
                       Text="Speed">
            </TextBlock>
            <ToggleButton CornerRadius="5" ToolTip.Tip="System sync" BorderThickness="0" Background="Transparent" Width="30" Height="30" Grid.Column="1" HorizontalAlignment="Right">
                <PathIcon Width="15" Margin="0,1,0,0" Data="{DynamicResource 'update'}"></PathIcon>
            </ToggleButton>
        </Grid>
        <Grid Row="1" ColumnDefinitions="Auto,12,*">
            <Grid Column="0">
                <Slider TickFrequency="1" IsSnapToTickEnabled="True" x:Name="speedSlider" Value="10" Width="200"
                        Minimum="0" Maximum="100" HorizontalAlignment="Stretch">
                </Slider>
            </Grid>
            <Grid Column="2">
                <SplitButton HorizontalContentAlignment="Stretch" ToolTip.Tip="Quick select"
                             Padding="0"
                             VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" Height="20"
                             Margin="0,0,0,0"
                             Flyout="{StaticResource SpeedValueFlyout}">
                    <Grid>
                        <TextBox CornerRadius="4,0,0,4" Background="Transparent"
                                 HorizontalAlignment="Left"
                                 HorizontalContentAlignment="Right"
                                 attachedProperties:TextBoxAssist.SuffixText="rpm"
                                 BorderThickness="0" 
                                 Text="{Binding ElementName=speedSlider,Path=Value}">
                        </TextBox>
                    </Grid>

                </SplitButton>
            </Grid>
            <!--<Grid Column="4">
                <Button ToolTip.Tip="Setting" Background="Transparent" Width="30" Height="30" Classes="icon-button" >
                    <PathIcon Width="15" Data="{DynamicResource Zone_layer_icon}"></PathIcon>
                </Button>
            </Grid>-->
        </Grid>

    </Grid>
</UserControl>
