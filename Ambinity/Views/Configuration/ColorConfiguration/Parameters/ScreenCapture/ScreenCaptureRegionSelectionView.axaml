<Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
             xmlns:attachedProperties="clr-namespace:Ambinity.AttachedProperties"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia.Tight"
             Background="Transparent"
             ExtendClientAreaToDecorationsHint="True"
             x:DataType="local:ScreenCaptureRegionSelectionViewModel"
             WindowState="FullScreen"
             x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.ScreenCaptureRegionSelectionView">
    <Border Margin="0" CornerRadius="0">
        <Border.Background>
            <SolidColorBrush Color="Black" Opacity="0.75"></SolidColorBrush>
        </Border.Background>
        <Grid>
            <ContentControl Content="{Binding CanvasViewModel}"></ContentControl>
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Background="#2c2c2c" CornerRadius="7" Margin="10" Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button CornerRadius="4" Classes="icon-button" ToolTip.Tip="Reset"
                            Background="Transparent" Width="40" Height="40"
                            BorderThickness="0"
                            Padding="0" Margin="5,5">
                        <PathIcon Width="18" Height="18"
                                  Data="{DynamicResource scale}">
                        </PathIcon>
                    </Button>
                    <Button CornerRadius="4" Classes="icon-button" ToolTip.Tip="Save"
                            Background="Transparent" Width="40" Height="40"
                            BorderThickness="0"
                            Padding="0" Margin="5,5">
                        <PathIcon Width="18" Height="18"
                                  Data="{DynamicResource apply}">
                        </PathIcon>
                    </Button>
                    <Separator Width="1" Height="35" Margin="5"></Separator>
                    <Button CornerRadius="4" Classes="icon-button" ToolTip.Tip="Cancel"
                            Background="Transparent" Width="40" Height="40"
                            Command="{Binding CloseCommand}"
                            BorderThickness="0"
                            Padding="0" Margin="5,5">
                        <PathIcon Width="15" Height="15"
                                  Data="{DynamicResource remove}">
                        </PathIcon>
                    </Button>
                </StackPanel>
                
            </Border>
        </Grid>
       
     
            
      
    </Border>
</Window>
