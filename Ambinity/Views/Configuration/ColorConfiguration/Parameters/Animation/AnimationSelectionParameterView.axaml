<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration.Parameters"
             xmlns:attachedProperties="clr-namespace:Ambinity.AttachedProperties"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:DataType="local:AnimationSelectionParameterViewModel"
             x:Class="Ambinity.Views.Configuration.ColorConfiguration.Parameters.AnimationSelectionParameterView">
    <UserControl.Styles>
         <Style Selector="DataValidationErrors">
           <Setter Property="Template">
               <ControlTemplate>
                   <DockPanel LastChildFill="True">
                       <ContentControl DockPanel.Dock="Right"
                                       ContentTemplate="{TemplateBinding ErrorTemplate}"
                                       DataContext="{TemplateBinding Owner}"
                                       Content="{Binding (DataValidationErrors.Errors)}"
                                       IsVisible="{Binding (DataValidationErrors.HasErrors)}"/>
                       <ContentPresenter Name="PART_ContentPresenter"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         ContentTemplate="{TemplateBinding ContentTemplate}"
                                         Content="{TemplateBinding Content}"
                                         Padding="{TemplateBinding Padding}"/>
                   </DockPanel>
               </ControlTemplate>
           </Setter>
           <Setter Property="ErrorTemplate">
               <DataTemplate x:DataType="{x:Type x:Object}">
                   <Canvas Width="3" Height="30" Margin="5 0 1 0" 
                           Background="Transparent">
                       <Canvas.Styles>
                           <Style Selector="ToolTip">
                               <Setter Property="Background" Value="IndianRed"/>
                               <Setter Property="BorderBrush" Value="Red"/>
                           </Style>
                       </Canvas.Styles>
                       <ToolTip.Tip>
                           <ItemsControl ItemsSource="{Binding}"/>
                       </ToolTip.Tip>
                       <Rectangle Canvas.Left="0" Canvas.Top="1" Height="28" RadiusX="3" RadiusY="3" Width="3" Fill="Red"></Rectangle>
                   </Canvas>
               </DataTemplate>
           </Setter>
       </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,10,*">
        <Grid Row="0" ColumnDefinitions="Auto,*">
            <TextBlock Margin="0,8" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13"
                       Text="Animations settings">
            </TextBlock>
            <Grid Column="1">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5">
                    <Grid>
                        <Button Width="30" Height="30" Command="{Binding ImportAnimationCommand}"
                                Background="Transparent" HorizontalAlignment="Right" ToolTip.Tip="Import animation"
                                Classes="icon-button">
                            <PathIcon Width="16" Data="{DynamicResource Import}"></PathIcon>
                        </Button>
                    </Grid>
                    <Grid>
                        <Button Width="30" Height="30" Command="{Binding ExportAnimationCommand}"
                                Background="Transparent" HorizontalAlignment="Right" ToolTip.Tip="Export this animation"
                                Classes="icon-button">
                            <PathIcon Width="16" Data="{DynamicResource Export}"></PathIcon>
                        </Button>
                    </Grid>
                   
                    <Grid>
                        <Button ToolTip.Tip="Show library" Command="{Binding OpenLibraryCommand}" Padding="1"
                                Background="Transparent" Width="30" Height="30"
                                Classes="icon-button">
                            <PathIcon Width="16" Data="{DynamicResource collection}"></PathIcon>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Row="2">
            <StackPanel Grid.Column="1" Spacing="5">
                <Grid RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Speed"></TextBlock>
                    </Grid>
                    <Grid Row="1" ColumnDefinitions="*,12,Auto">
                        <Grid Column="0">
                            <Slider x:Name="sensitivitySlider"
                                    Width="190"
                                    SmallChange="0.1"
                                    LargeChange="0.5"
                                    Value="{Binding FrameRate}"
                                    Minimum="1" Maximum="5" HorizontalAlignment="Left">
                            </Slider>

                        </Grid>
                        <Grid Column="2">
                            <ui:NumberBox  Theme="{DynamicResource borderlessNumberBox}"  BorderThickness="0" Minimum="1" Maximum="5"  SpinButtonPlacementMode="Compact" VerticalAlignment="Center" Value="{Binding FrameRate}">
                               
                            </ui:NumberBox>


                        </Grid>
                    </Grid>
                </Grid>
                <Grid RowDefinitions="Auto,10,*">
                    <Grid>
                        <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Animation details"></TextBlock>
                    </Grid>
                    <Grid Row="2" ColumnDefinitions="Auto,10,*">
                        <Grid>
                            <Border Classes="card" BorderThickness="1" Padding="0" Width="100" Height="100" CornerRadius="7">
                                <Lottie Margin="5" Path="{Binding AnimationFilePath}"></Lottie>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Duration: "></TextBlock>
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Grid.Column="1"
                                           Text="{Binding SelectedAnimation.SkottieAnimation.Duration}">
                                </TextBlock>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Fps: "></TextBlock>
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Grid.Column="1"
                                           Text="{Binding SelectedAnimation.SkottieAnimation.Fps}">
                                </TextBlock>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Version: "></TextBlock>
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Grid.Column="1"
                                           Text="{Binding SelectedAnimation.SkottieAnimation.Version}">
                                </TextBlock>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Text="Size: "></TextBlock>
                                <TextBlock Foreground="{DynamicResource ButtonForegroundDisabled}" Grid.Column="1"
                                           Text="{Binding SelectedAnimation.SkottieAnimation.Size}">
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>