<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Configuration.PositionConfiguration"
             xmlns:attachedProperties="clr-namespace:Ambinity.AttachedProperties"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:DataType="local:PositionConfigurationViewModel"
             x:Class="Ambinity.Views.Configuration.PositionConfiguration.PositionConfigurationView">
    <UserControl.Resources>
        <MenuFlyout x:Key="ScaleMenuFlyout"
                    Placement="Bottom">
            <MenuItem Command="{CompiledBinding SetItemScaleCommand}"
                      CommandParameter="0.25"
                      Header="0.25">
            </MenuItem>
            <MenuItem Command="{CompiledBinding SetItemScaleCommand}"
                      CommandParameter="0.5"
                      Header="0.5">
            </MenuItem>
            <MenuItem Command="{CompiledBinding SetItemScaleCommand}"
                      CommandParameter="0.75"
                      Header="0.75">
            </MenuItem>
            <MenuItem Command="{CompiledBinding SetItemScaleCommand}"
                      CommandParameter="1"
                      Header="1">
            </MenuItem>
        </MenuFlyout>
    </UserControl.Resources>
    <Grid IsEnabled="{Binding IsEnabled}" MinWidth="300" RowDefinitions="Auto,*">
        <Grid>
            <StackPanel Margin="0,8" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="5">
                <TextBlock  VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13"
                           Text="Dimensions">
                </TextBlock>
                <Grid>
                    <Button Click="InfoButton_OnClick"  x:Name="infoButton" Background="Transparent" BorderThickness="0" Classes="icon-button-small" >
                        <PathIcon Width="15" Height="15" Data="{DynamicResource infoCircle}"></PathIcon>
                    </Button>
                    <ui:TeachingTip x:Name="infoTip" 
                                    Target="{Binding #infoButton}"
                                    Title="Dimension"
                                    Subtitle="Only device can have scale and rotation property">
                    </ui:TeachingTip>
                </Grid>
            </StackPanel>
           
         
        </Grid>
        <Grid Row="1" ColumnDefinitions="*,20,*">
            <Grid MaxWidth="120" Column="0" RowDefinitions="*,*,*">
                <Grid IsEnabled="{CompiledBinding CanResize}" Margin="0,7" ColumnDefinitions="20,*">
                    <TextBlock Foreground="{DynamicResource TextControlForegroundDisabled}" VerticalAlignment="Center"
                               Text="W">
                    </TextBlock>
                    <ui:NumberBox LostFocus="InputElement_OnLostFocus" SimpleNumberFormat="F2" Width="100" Theme="{DynamicResource borderlessNumberBox}"
                                  BorderThickness="0" BorderBrush="Transparent" Grid.Column="1" Value="{Binding WidthProperty}"
                             Margin="5,0">
                    </ui:NumberBox>
                </Grid>
                <Grid Margin="0,7" Row="1" ColumnDefinitions="20,*">
                    <TextBlock Foreground="{DynamicResource TextControlForegroundDisabled}" VerticalAlignment="Center"
                               Text="X">
                    </TextBlock>
                    <ui:NumberBox LostFocus="InputElement_OnLostFocus" SimpleNumberFormat="F2" Width="100" Theme="{DynamicResource borderlessNumberBox}"
                                  BorderThickness="0" BorderBrush="Transparent" Grid.Column="1" Value="{Binding XProperty}" 
                                  Margin="5,0">
                    </ui:NumberBox>
                </Grid>
                <Grid IsVisible="{CompiledBinding CanRotate}" Margin="0,7" Row="2" ColumnDefinitions="20,*">
                    <PathIcon  HorizontalAlignment="Left" Foreground="{DynamicResource ButtonForegroundDisabled}" Width="20" Height="20" Data="{DynamicResource Rotate_value}"></PathIcon>
                    <ui:NumberBox LostFocus="InputElement_OnLostFocus" SimpleNumberFormat="F2" Width="100" Theme="{DynamicResource borderlessNumberBox}"
                                  BorderThickness="0" BorderBrush="Transparent" Grid.Column="1" Value="{Binding RotationProperty}" 
                                  Margin="5,0">
                    </ui:NumberBox>
                </Grid>
            </Grid>
            <Grid MaxWidth="120" Column="2" RowDefinitions="*,*,*">
                <Grid IsEnabled="{CompiledBinding CanResize}" Margin="0,7" ColumnDefinitions="20,*">
                    <TextBlock Foreground="{DynamicResource TextControlForegroundDisabled}" VerticalAlignment="Center"
                               Text="H">
                    </TextBlock>
                    <ui:NumberBox LostFocus="InputElement_OnLostFocus" Width="100" SimpleNumberFormat="F2" Theme="{DynamicResource borderlessNumberBox}"
                                  BorderThickness="0" BorderBrush="Transparent" Grid.Column="1" Value="{Binding HeightProperty}" 
                                  Margin="5,0">
                    </ui:NumberBox>
                </Grid>
                <Grid Margin="0,7" Row="1" ColumnDefinitions="20,*">
                    <TextBlock Foreground="{DynamicResource TextControlForegroundDisabled}" VerticalAlignment="Center"
                               Text="Y">
                    </TextBlock>
                    <ui:NumberBox LostFocus="InputElement_OnLostFocus" Width="100" SimpleNumberFormat="F2" Theme="{DynamicResource borderlessNumberBox}"
                                  BorderThickness="0" BorderBrush="Transparent" Grid.Column="1" Value="{Binding YProperty}" 
                                  Margin="5,0">
                    </ui:NumberBox>
                </Grid>
                <Grid IsVisible="{CompiledBinding CanScale}" ColumnDefinitions="20,*" Margin="0,7" Row="2">
                    <PathIcon HorizontalAlignment="Left" Foreground="{DynamicResource ButtonForegroundDisabled}" Width="15" Height="15" Data="{DynamicResource scale}"></PathIcon>
                    <SplitButton BorderThickness="0" Grid.Column="1" Margin="5,0,0,0" Padding="0" Width="100"
                                 Flyout="{StaticResource ScaleMenuFlyout}">
                        <ui:NumberBox LostFocus="InputElement_OnLostFocus" Background="Transparent" SpinButtonPlacementMode="Hidden" SimpleNumberFormat="F2"  Minimum="0.2" Maximum="2"  Theme="{DynamicResource borderlessNumberBox}"
                                      BorderThickness="0" BorderBrush="Transparent" CornerRadius="4,0,0,4" Value="{Binding ScaleProperty}">
                        </ui:NumberBox>
                    </SplitButton>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>