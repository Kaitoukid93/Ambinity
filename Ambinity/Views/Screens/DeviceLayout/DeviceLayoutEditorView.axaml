<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local ="clr-namespace:Ambinity.Views.Screens.DeviceLayout"
             x:DataType="local:DeviceLayoutEditorViewModel"
             x:Class="Ambinity.Views.Screens.DeviceLayout.DeviceLayoutEditorView">
    <Grid Margin="0,10,0,0" RowDefinitions="auto,5,*">
        <TextBlock Margin="5" Text="Layout" FontSize="25" FontWeight="SemiBold"></TextBlock>
        <Grid Row="2" ColumnDefinitions="*, auto">
            <Border Padding="10" Classes="card" Margin="0,10,10,10">
                <ContentControl Content="{CompiledBinding LayoutViewModel}"></ContentControl>
            </Border>
        
            <Grid HorizontalAlignment="Right"  Grid.Column="1">
                <Border Padding="0" Classes="card" Margin="0,10,10,10" Grid.Row="0">
                    <ContentControl Content="{CompiledBinding RightPanelViewModel}"></ContentControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
   
</UserControl>
