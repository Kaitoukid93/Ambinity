<UserControl
    x:Class="Ambinity.Views.Screens.DeviceLayout.DeviceLayoutEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.Views.Screens.DeviceLayout"
    xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:DeviceLayoutEditorViewModel"
    mc:Ignorable="d">
    <Grid Margin="0,10,0,0" RowDefinitions="auto,5,*">
        <TextBlock
            Margin="5"
            FontSize="25"
            FontWeight="SemiBold"
            Text="{localize:Loc Layout.Page.Header}" />
        <Grid ColumnDefinitions="*, auto" Row="2">
            <Border
                Margin="0,10,10,10"
                Padding="10"
                Classes="card">
                <ContentControl Content="{CompiledBinding CanvasViewModel}" />
            </Border>

            <Grid Grid.Column="1" HorizontalAlignment="Right">
                <Border
                    Grid.Row="0"
                    Margin="0,10,10,10"
                    Padding="0"
                    Classes="card">
                    <ContentControl Content="{CompiledBinding RightPanelViewModel}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
