<UserControl
    x:Class="Ambinity.Views.Screens.DeviceLayout.DevicePropertiesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.Views.Screens.DeviceLayout"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:DevicePropertiesViewModel"
    mc:Ignorable="d">
    <Grid Margin="18,0,18,10" RowDefinitions="50,10,*">
        <Grid>
            <ContentControl Content="{Binding Header}" />
        </Grid>
        <Separator
            Grid.Row="1"
            Height="1"
            Margin="0" />
        <Grid Row="2">
            <ContentControl Content="{Binding PositionConfiguration}" IsEnabled="{Binding EnablePositionEdit}" />
        </Grid>

    </Grid>
</UserControl>
