<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local = "clr-namespace:Ambinity.Views.Screens.DeviceLayout"
             x:DataType="local:DevicePropertiesViewModel"
             x:Class="Ambinity.Views.Screens.DeviceLayout.DevicePropertiesView">
    <Grid Margin="18,0,18,10" RowDefinitions="50,10,*">
        <Grid>
           <ContentControl Content="{Binding Header}"></ContentControl>
        </Grid>
        <Separator Margin="0" Grid.Row="1" Height="1"></Separator>
        <Grid Row="2">
            <StackPanel>
                <ContentControl Content="{Binding PositionConfiguration}"></ContentControl>
                <Separator Margin="0,10"></Separator>
                <ContentControl>
                    <!-- device layout selector -->
                </ContentControl>
            </StackPanel>
        </Grid>
        
    </Grid>
</UserControl>
