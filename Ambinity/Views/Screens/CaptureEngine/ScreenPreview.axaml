<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:captureEngines="clr-namespace:Ambinity.Views.Screens.CaptureEngine"
             x:DataType="captureEngines:ScreenPreviewViewModel"
             x:Class="Ambinity.Views.Screens.CaptureEngine.ScreenPreview">
        <Border ClipToBounds="True" CornerRadius="0 8 8 0">
            <Image Name="DisplayPreviewImage"
                   Height="500"
                   Source="{Binding PreviewImage}"
                   RenderOptions.BitmapInterpolationMode="LowQuality"
                   Stretch="Uniform" />
        </Border>
</UserControl>