<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:captureEngines="clr-namespace:Ambinity.Views.Screens.CaptureEngine"
             x:DataType="captureEngines:ScreenCapturingViewModel"
             x:Class="Ambinity.Views.Screens.CaptureEngine.ScreenCapturingView">
    <Panel>
        <ItemsControl ItemsSource="{Binding AvailableScreen}">
         <ItemsControl.ItemTemplate>
             <DataTemplate>
               <captureEngines:ScreenPreview></captureEngines:ScreenPreview>
             </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        
    </Panel>
</UserControl>
