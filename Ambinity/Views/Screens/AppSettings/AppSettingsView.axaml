<UserControl
    x:Class="Ambinity.Views.Screens.AppSettings.AppSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.Views.Screens.AppSettings"
    xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DesignHeight="450"
    d:DesignWidth="1500"
    x:DataType="local:AppSettingsViewModel"
    mc:Ignorable="d">
    <ScrollViewer IsScrollInertiaEnabled="True">
        <Grid
            MaxWidth="1000"
            Margin="40,15,50,20"
            RowDefinitions="auto,5,*">
            <TextBlock
                Margin="0,0,0,10"
                FontSize="25"
                FontWeight="SemiBold"
                Text="{localize:Loc Settings.Button.ToolTip}" />
            <StackPanel Grid.Row="2" Spacing="30">
                <Grid>
                    <Border Margin="0,0,0,10" Classes="card">
                        <TextBlock Text="{Binding BuildInfo}" />
                    </Border>
                </Grid>
                <Grid RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Classes="smallBold" Text="{localize:Loc GeneralSettings.Section.Header}"/>
                    </Grid>
                    <Grid Margin="0,10,0,0" Row="1">
                        <!--  <ui:InfoBar Severity="{localize:Loc Error.InforBar.Title}" Title="{localize:Loc Warning.InforBar.Title}" IsOpen="True"  -->
                        <!--  IsIconVisible="True"  -->
                        <!--  IsClosable="False"  -->
                        <!--  Message="Hardware settings for this device is not available at the moment">  -->
                        <!-- </ui:InfoBar> -->
                        <Grid>
                            <StackPanel Spacing="2">
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc autorun.SettingsExpander.Description}"
                                    Header="{localize:Loc autorun.SettingsExpander.Header}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource button_power_1__power_button_on_off}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch x:Name="Switch" IsChecked="{Binding RunAtStartup}" />
                                    </ui:SettingsExpander.Footer>
                                    <ui:SettingsExpanderItem
                                        MinWidth="500"
                                        Content="{localize:Loc Minimized.SettingsExpanderItem.Header}"
                                        Description="{localize:Loc Minimized.SettingsExpanderItem.Description}"
                                        IsClickEnabled="False"
                                        IsEnabled="{Binding ElementName=Switch, Path=IsChecked}">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ToggleSwitch Margin="40,0" IsChecked="{Binding StartMinimized}" />
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                    <ui:SettingsExpanderItem
                                        MinWidth="500"
                                        Content="{localize:Loc StartupDelay.SettingsExpanderItem.Header}"
                                        Description="{localize:Loc StartupDelay.SettingsExpanderItem.Description}"
                                        IsClickEnabled="False"
                                        IsEnabled="{Binding ElementName=Switch, Path=IsChecked}">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ui:NumberBox
                                                Margin="40,0"
                                                Maximum="20"
                                                Minimum="1"
                                                Theme="{DynamicResource borderlessNumberBox}"
                                                Value="{Binding StartupDelay}" />
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc EnableMica.SettingsExpander.Description}"
                                    Header="{localize:Loc EnableMica.SettingsExpander.Header}">
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch Margin="40,0" IsChecked="{Binding EnableMica}" />
                                    </ui:SettingsExpander.Footer>
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource enable_mica}" />
                                    </ui:SettingsExpander.IconSource>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc Theme.SettingsExpander.Description}"
                                    Header="{localize:Loc Theme.SettingsExpander.Header}">
                                    <ui:SettingsExpander.Footer>
                                        <ui:FAComboBox
                                            x:Name="customTheme"
                                            VerticalContentAlignment="Center"
                                            FontFamily="{StaticResource NunitoFont}"
                                            SelectedIndex="{Binding !UseSystemTheme}">
                                            <ui:FAComboBoxItem>Use system theme</ui:FAComboBoxItem>
                                            <ui:FAComboBoxItem>Custom</ui:FAComboBoxItem>
                                        </ui:FAComboBox>
                                    </ui:SettingsExpander.Footer>
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource themeSettings}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpanderItem
                                        MinWidth="500"
                                        Content="{localize:Loc ThemeAccentColor.SettingsExpanderItem.Header}"
                                        Description="{localize:Loc ThemeAccentColor.SettingsExpanderItem.Description}"
                                        IsClickEnabled="False"
                                        IsEnabled="{Binding ElementName=customTheme, Path=SelectedIndex}">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ui:ColorPickerButton Margin="40,0" Color="{Binding CurrentAppAccentColor}" />
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                    <ui:SettingsExpanderItem
                                        MinWidth="500"
                                        Content="{localize:Loc ThemeMode.SettingsExpanderItem.Header}"
                                        Description="{localize:Loc ThemeMode.SettingsExpanderItem.Description}"
                                        IsClickEnabled="False"
                                        IsEnabled="{Binding ElementName=customTheme, Path=SelectedIndex}">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ui:FAComboBox
                                                Margin="40,0"
                                                FontFamily="{StaticResource NunitoFont}"
                                                ItemsSource="{Binding AvailableAppThemes}"
                                                SelectedItem="{Binding CurrentAppTheme}" />
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc Language.SettingsExpanderItem.Description}"
                                    Header="{localize:Loc Language.SettingsExpanderItem.Header}">
                                    <ui:SettingsExpander.Footer>
                                        <ui:FAComboBox
                                            VerticalContentAlignment="Center"
                                            FontFamily="{StaticResource NunitoFont}"
                                            SelectedIndex="{Binding !UseSystemTheme}">
                                            <ui:FAComboBoxItem>En</ui:FAComboBoxItem>
                                            <ui:FAComboBoxItem>Vi</ui:FAComboBoxItem>
                                        </ui:FAComboBox>
                                    </ui:SettingsExpander.Footer>
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource languageIcon}" />
                                    </ui:SettingsExpander.IconSource>
                                </ui:SettingsExpander>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Classes="smallBold" Text="{localize:Loc PluginsSettings.Section.Header}" />
                    </Grid>
                    <Grid Margin="0,10,0,0" Row="1">
                        <!--  <ui:InfoBar Severity="{localize:Loc Error.InforBar.Title}" Title="{localize:Loc Warning.InforBar.Title}" IsOpen="True"  -->
                        <!--  IsIconVisible="True"  -->
                        <!--  IsClosable="False"  -->
                        <!--  Message="Hardware settings for this device is not available at the moment">  -->
                        <!-- </ui:InfoBar> -->
                        <Grid>
                            <StackPanel Spacing="2">
                                <ui:InfoBar
                                    Title="{localize:Loc SettingsChanged.InforBar.Header}"
                                    IsOpen="{Binding ShowPluginInfoBar, Mode=TwoWay}"
                                    Message="{localize:Loc SettingsChanged.InforBar.Message}"
                                    Severity="Warning">
                                    <Button
                                        Margin="0,0,0,10"
                                        Command="{Binding RequestRestartApplicationCommand}"
                                        Content="{localize:Loc RestartApp.Button.Content}" />
                                </ui:InfoBar>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc ScreenCapturePlugin.SettingsExpander.Description}"
                                    Header="{localize:Loc ScreenCapturePlugin.SettingsExpander.Header}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource desktopCapture}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch x:Name="ambilightEnable" IsChecked="{Binding GeneralSettings.EnableScreenCapture}" />
                                    </ui:SettingsExpander.Footer>
                                    <ui:SettingsExpanderItem
                                        MinWidth="500"
                                        Content="{localize:Loc CaptureScalingFactor.SettingsExpanderItem.Header}"
                                        Description="{localize:Loc CaptureScalingFactor.SettingsExpanderItem.Description}"
                                        IsClickEnabled="False"
                                        IsEnabled="{Binding ElementName=ambilightEnable, Path=IsChecked}">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ui:FAComboBox Margin="40,0" FontFamily="{StaticResource NunitoFont}">
                                                <ui:FAComboBoxItem>0</ui:FAComboBoxItem>
                                                <ui:FAComboBoxItem>1</ui:FAComboBoxItem>
                                                <ui:FAComboBoxItem>2</ui:FAComboBoxItem>
                                                <ui:FAComboBoxItem>3</ui:FAComboBoxItem>
                                                <ui:FAComboBoxItem>4</ui:FAComboBoxItem>
                                            </ui:FAComboBox>
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                    <ui:SettingsExpanderItem
                                        MinWidth="500"
                                        Content="{localize:Loc CaptureRate.SettingsExpanderItem.Header}"
                                        Description="{localize:Loc CaptureRate.SettingsExpanderItem.Description}"
                                        IsClickEnabled="False"
                                        IsEnabled="{Binding ElementName=ambilightEnable, Path=IsChecked}">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ui:NumberBox
                                                Margin="40,0"
                                                Maximum="60"
                                                Minimum="15"
                                                Theme="{DynamicResource borderlessNumberBox}" />
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc AudioCapturePlugin.SettingsExpander.Description}"
                                    Header="{localize:Loc AudioCapturePlugin.SettingsExpander.Header}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource audioCapture}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch
                                            x:Name="audioEnable"
                                            Margin="40,0"
                                            IsChecked="{Binding GeneralSettings.EnableAudioCapture}" />
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc HardwareMonitorPlugin.SettingsExpander.Description}"
                                    Header="{localize:Loc HardwareMonitorPlugin.SettingsExpander.Header}"
                                    IsVisible="{Binding HWMonitorSettingVisible}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource wave_signal__heart_line_beat_square_graph_stats}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch
                                            x:Name="hwMonitorEnable"
                                            Margin="40,0"
                                            IsChecked="{Binding GeneralSettings.EnableHWMonitor}" />
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc OpenRGBPlugin.SettingsExpander.Description}"
                                    Header="{localize:Loc OpenRGBPlugin.SettingsExpander.Header}"
                                    IsVisible="{Binding OpenRGBSettingVisible}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource plugin}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch
                                            x:Name="ORGBoutline"
                                            Margin="40,0"
                                            IsChecked="{Binding GeneralSettings.EnableOpenRGB}" />
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>

                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Classes="smallBold" Text="{localize:Loc RenderingSettings.Section.Header}" />
                    </Grid>
                    <Grid Margin="0,10,0,0" Row="1">
                        <!--  <ui:InfoBar Severity="{localize:Loc Error.InforBar.Title}" Title="{localize:Loc Warning.InforBar.Title}" IsOpen="True"  -->
                        <!--  IsIconVisible="True"  -->
                        <!--  IsClosable="False"  -->
                        <!--  Message="Hardware settings for this device is not available at the moment">  -->
                        <!-- </ui:InfoBar> -->
                        <Grid>
                            <StackPanel Spacing="2">
                                <ui:InfoBar
                                    Title="{localize:Loc SettingsChanged.InforBar.Header}"
                                    IsOpen="{Binding ShowRenderingInfoBar, Mode=TwoWay}"
                                    Message="{localize:Loc SettingsChanged.InforBar.Message}"
                                    Severity="Warning">
                                    <Button
                                        Margin="0,0,0,10"
                                        Command="{Binding RequestRestartApplicationCommand}"
                                        Content="{localize:Loc RestartApp.Button.Content}" />
                                </ui:InfoBar>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc RenderingFrameRate.SettingsExpander.Description}"
                                    Header="{localize:Loc RenderingFrameRate.SettingsExpander.Header}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource flash}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ui:FAComboBox
                                            Margin="40,0"
                                            FontFamily="{StaticResource NunitoFont}"
                                            ItemsSource="{Binding AvailableFrameRates}"
                                            SelectedItem="{Binding TargetFramerate}" />
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc RenderingBitmapSize.SettingsExpander.Description}"
                                    Header="{localize:Loc RenderingBitmapSize.SettingsExpander.Header}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource bitmapSize}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ui:FAComboBox
                                            Margin="40,0"
                                            FontFamily="{StaticResource NunitoFont}"
                                            ItemsSource="{Binding AvailableBitmapSize}"
                                            SelectedItem="{Binding TargetBitmapSize}" />
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Classes="smallBold" Text="{localize:Loc DeviceSettings.Section.Header}" />
                    </Grid>
                    <Grid Margin="0,10,0,0" Row="1">
                        <!--  <ui:InfoBar Severity="{localize:Loc Error.InforBar.Title}" Title="{localize:Loc Warning.InforBar.Title}" IsOpen="True"  -->
                        <!--  IsIconVisible="True"  -->
                        <!--  IsClosable="False"  -->
                        <!--  Message="Hardware settings for this device is not available at the moment">  -->
                        <!-- </ui:InfoBar> -->
                        <Grid>
                            <StackPanel Spacing="2">
                                <ui:InfoBar
                                    Title="{localize:Loc SettingsChanged.InforBar.Header}"
                                    IsOpen="{Binding ShowDevicesInfoBar, Mode=TwoWay}"
                                    Message="{localize:Loc SettingsChanged.InforBar.Message}"
                                    Severity="Warning">
                                    <Button
                                        Margin="0,0,0,10"
                                        Command="{Binding RequestRestartApplicationCommand}"
                                        Content="{localize:Loc RestartApp.Button.Content}" />
                                </ui:InfoBar>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc AutoScanNewDevices.SettingsExpander.Description}"
                                    Header="{localize:Loc AutoScanNewDevices.SettingsExpander.Header}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource search_visual}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding AutoScanNewDevices}" />
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Classes="smallBold" Text="{localize:Loc DebugSettings.Section.Header}" />
                    </Grid>
                    <Grid Margin="0,10,0,0" Row="1">
                        <!--  <ui:InfoBar Severity="{localize:Loc Error.InforBar.Title}" Title="{localize:Loc Warning.InforBar.Title}" IsOpen="True"  -->
                        <!--  IsIconVisible="True"  -->
                        <!--  IsClosable="False"  -->
                        <!--  Message="Hardware settings for this device is not available at the moment">  -->
                        <!-- </ui:InfoBar> -->
                        <Grid>
                            <StackPanel Spacing="2">
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc ShowDebugLog.SettingsExpander.Description}"
                                    Header="{localize:Loc ShowDebugLog.SettingsExpander.Header}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource debug_window}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <Button
                                            Margin="40,0"
                                            Command="{Binding ShowDebugLogCommand}"
                                            Content="{localize:Loc Show.Button.Content}"
                                            FontFamily="{StaticResource NunitoFont}" />
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc RemoveDevice.SettingsExpander.Description}"
                                    Header="{localize:Loc RemoveDevice.SettingsExpander.Header}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource device_data}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <Button
                                            Margin="40,0"
                                            Command="{Binding RemoveAllDevicesCommand}"
                                            Content="{localize:Loc Remove.Button.Content}"
                                            FontFamily="{StaticResource NunitoFont}" />
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{localize:Loc RemoveDownloadData.SettingsExpander.Description}"
                                    Header="{localize:Loc RemoveDownloadData.SettingsExpander.Header}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource download_data}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <Button
                                            Margin="40,0"
                                            Command="{Binding RemoveDownloadedDatasCommand}"
                                            Content="{localize:Loc Remove.Button.Content}"
                                            FontFamily="{StaticResource NunitoFont}" />
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid IsVisible="{Binding EnableInAppUpdate}" RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Classes="smallBold" Text="Update" />
                    </Grid>
                    <Grid Margin="0,10,0,0" Row="1">
                        <StackPanel Spacing="2">
                            <Grid Margin="0,10,0,0">
                                <!-- <Image Width="50" Source="/Assets/Images/uptodate.png"></Image> -->
                                <!-- <Grid Column="2"> -->
                                <!--     <StackPanel Margin="10,0" Spacing="10"> -->
                                <!--         <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding CurrentReleaseInformation.Version}"></TextBlock> -->
                                <!--         <Grid> -->
                                <!--             <StackPanel Orientation="Horizontal" Spacing="2"> -->
                                <!--  <TextBlock  Classes="smallSecondary"  -->
                                <!--  Text="Last checked: ">  -->
                                <!--                 </TextBlock> -->
                                <!--  <TextBlock  Classes="smallSecondary"  -->
                                <!--  Text="{Binding CurrentReleaseInformation.ReleaseDate}">  -->
                                <!--                 </TextBlock> -->
                                <!--             </StackPanel> -->
                                <!--    -->
                                <!--         </Grid> -->
                                <!--         <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCheckingForUpdate}"></ProgressBar> -->
                                <!--     </StackPanel> -->
                                <!--    -->
                                <!-- </Grid> -->
                                <!-- <Grid Column="3"> -->
                                <!--  <Button IsEnabled="True"  -->
                                <!--  Command="{Binding CheckForAppUpdateCommand}"  -->
                                <!--  Content="{localize:Loc UpdateCheck.Button.Content}" Classes="accent">  -->
                                <!--     </Button> -->
                                <!-- </Grid> -->
                                <ui:SettingsExpander
                                    MinWidth="500"
                                    Description="{Binding CurrentReleaseInformation.ReleaseDate}"
                                    Header="{Binding CurrentReleaseInformation.Version}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource app_update}" />
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <StackPanel
                                            Margin="40,0"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                            <ui:ProgressRing
                                                Width="32"
                                                Height="32"
                                                IsIndeterminate="True"
                                                IsVisible="{Binding IsCheckingForUpdate}" />
                                            <Button
                                                Command="{Binding CheckForAppUpdateCommand}"
                                                Content="Check for updates"
                                                IsEnabled="True" />
                                        </StackPanel>

                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                            </Grid>

                            <ui:InfoBar
                                Title="{localize:Loc UpdateAvailable.InforBar.Title}"
                                IsClosable="False"
                                IsIconVisible="True"
                                IsOpen="{Binding UpdateAvailable}"
                                Message="{Binding UpdateInformation.Version}"
                                Severity="Success">
                                <ui:InfoBar.IconSource>
                                    <ui:PathIconSource Data="{DynamicResource Import}" Foreground="{DynamicResource AccentButtonBackground}" />
                                </ui:InfoBar.IconSource>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            Margin="0,0,0,20"
                                            Command="{Binding InstallUpdateCommand}"
                                            Content="Install now" />
                                        <ProgressBar
                                            Margin="0,0,0,20"
                                            IsIndeterminate="False"
                                            IsVisible="{Binding IsUpdating}"
                                            Value="{Binding CurrentUpdateProgress}" />
                                        <TextBlock
                                            Margin="0,0,0,20"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsUpdating}"
                                            Text="{Binding CurrentUpdatingStatus}" />
                                    </StackPanel>

                                </Grid>
                            </ui:InfoBar>

                        </StackPanel>
                    </Grid>
                </Grid>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
