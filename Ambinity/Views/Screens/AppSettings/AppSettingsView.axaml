<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Screens.AppSettings"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:DataType="local:AppSettingsViewModel"
             x:Class="Ambinity.Views.Screens.AppSettings.AppSettingsView">
    <ScrollViewer IsScrollInertiaEnabled="True">
        <Grid Margin="40,0,50,20" MaxWidth="1000" RowDefinitions="auto,5,*">
            <TextBlock Margin="0,0,0,10" Text="Settings" FontSize="25" FontWeight="SemiBold"></TextBlock>
            <StackPanel Grid.Row="2" Spacing="30">
                <Grid RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Classes="smallBold" Text="General"></TextBlock>
                    </Grid>
                    <Grid Margin="0,10,0,0" Row="1">
                        <!-- <ui:InfoBar Severity="Error" Title="Warning" IsOpen="True" -->
                        <!--             IsIconVisible="True" -->
                        <!--             IsClosable="False" -->
                        <!--             Message="Hardware settings for this device is not available at the moment"> -->
                        <!-- </ui:InfoBar> -->
                        <Grid>
                            <StackPanel Spacing="2">
                                <ui:SettingsExpander MinWidth="500" Header="Auto-run on startup"
                                                     Description="Personalize device lighting when application is not running, click for more settings.">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource button_power_1__power_button_on_off}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding RunAtStartup}" x:Name="Switch"></ToggleSwitch>
                                    </ui:SettingsExpander.Footer>
                                    <ui:SettingsExpanderItem MinWidth="500" Content="Start minimized"
                                                             IsEnabled="{Binding ElementName=Switch,Path=IsChecked}"
                                                             Description="The app will run in silent on Window's startup."
                                                             IsClickEnabled="False">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ToggleSwitch IsChecked="{Binding StartMinimized}" Margin="40,0"></ToggleSwitch>
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                    <ui:SettingsExpanderItem MinWidth="500" Content="Startup delay"
                                                             IsEnabled="{Binding ElementName=Switch,Path=IsChecked}"
                                                             Description="Set the delay time in second. If some of your apps is blocked by Ambinity, try increasing this value."
                                                             IsClickEnabled="False">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ui:NumberBox Theme="{DynamicResource borderlessNumberBox}" Margin="40,0"
                                                          Minimum="1"
                                                          Value="{Binding StartupDelay}"
                                                          Maximum="20">
                                            </ui:NumberBox>
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander MinWidth="500" Header="Enable Mica"
                                                     Description="Mica is an opaque, dynamic material that incorporates theme and desktop wallpaper to paint the background">
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding EnableMica}" Margin="40,0"></ToggleSwitch>
                                    </ui:SettingsExpander.Footer>
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource enable_mica}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander MinWidth="500" Header="Theme"
                                                     Description="Change accent color and theme settings">
                                    <ui:SettingsExpander.Footer>
                                        <ui:FAComboBox SelectedIndex="{Binding !UseSystemTheme}" x:Name="customTheme">
                                            <ui:FAComboBoxItem> Use system theme</ui:FAComboBoxItem>
                                            <ui:FAComboBoxItem> Custom</ui:FAComboBoxItem>
                                        </ui:FAComboBox>
                                    </ui:SettingsExpander.Footer>
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource themeSettings}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpanderItem MinWidth="500" Content="Accent color"
                                                             IsEnabled="{Binding ElementName=customTheme,Path=SelectedIndex}"
                                                             Description="Choose primary color"
                                                             IsClickEnabled="False">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ui:ColorPickerButton Color="{Binding CurrentAppAccentColor}" Margin="40,0"></ui:ColorPickerButton>
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                    <ui:SettingsExpanderItem MinWidth="500" Content="Mode"
                                                             IsEnabled="{Binding ElementName=customTheme,Path=SelectedIndex}"
                                                             Description="Choose between dark and light mode "
                                                             IsClickEnabled="False">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ui:FAComboBox SelectedItem="{Binding CurrentAppTheme}"
                                                           ItemsSource="{Binding AvailableAppThemes}" Margin="40,0">
                                            </ui:FAComboBox>
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                </ui:SettingsExpander>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Classes="smallBold" Text="Plugins"></TextBlock>
                    </Grid>
                    <Grid Margin="0,10,0,0" Row="1">
                        <!-- <ui:InfoBar Severity="Error" Title="Warning" IsOpen="True" -->
                        <!--             IsIconVisible="True" -->
                        <!--             IsClosable="False" -->
                        <!--             Message="Hardware settings for this device is not available at the moment"> -->
                        <!-- </ui:InfoBar> -->
                        <Grid>
                            <StackPanel Spacing="2">
                                <ui:InfoBar IsOpen="{Binding ShowPluginInfoBar,Mode=TwoWay}" Severity="Warning"
                                            Message="Restart is require for changes to take effect"
                                            Title="Settings changed">
                                    <Button Command="{Binding RequestRestartApplicationCommand}" Margin="0,0,0,10"
                                            Content="Restart now">
                                    </Button>
                                </ui:InfoBar>
                                <ui:SettingsExpander MinWidth="500" Header="Screen capture"
                                                     Description="Enable screen capture plugin. This plugin is required for ambilight effect.">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource desktopCapture}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding GeneralSettings.EnableScreenCapture}"
                                                      x:Name="ambilightEnable">
                                        </ToggleSwitch>
                                    </ui:SettingsExpander.Footer>
                                    <ui:SettingsExpanderItem MinWidth="500" Content="Scaling factor"
                                                             IsEnabled="{Binding ElementName=ambilightEnable,Path=IsChecked}"
                                                             Description="Try to increase this value if your computer is struggling when turn on ambilight effect."
                                                             IsClickEnabled="False">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ui:FAComboBox Margin="40,0">
                                                <ui:FAComboBoxItem>0</ui:FAComboBoxItem>
                                                <ui:FAComboBoxItem>1</ui:FAComboBoxItem>
                                                <ui:FAComboBoxItem>2</ui:FAComboBoxItem>
                                                <ui:FAComboBoxItem>3</ui:FAComboBoxItem>
                                                <ui:FAComboBoxItem>4</ui:FAComboBoxItem>
                                            </ui:FAComboBox>
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                    <ui:SettingsExpanderItem MinWidth="500" Content="Capture rate"
                                                             IsEnabled="{Binding ElementName=ambilightEnable,Path=IsChecked}"
                                                             Description="Adjust frames per second"
                                                             IsClickEnabled="False">
                                        <ui:SettingsExpanderItem.Footer>
                                            <ui:NumberBox Theme="{DynamicResource borderlessNumberBox}" Margin="40,0"
                                                          Minimum="15"
                                                          Maximum="60">
                                            </ui:NumberBox>
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander MinWidth="500" Header="Audio capture"
                                                     Description="Enable Audio capture plugin. This plugin is required for music reactive effect.">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource audioCapture}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding GeneralSettings.EnableAudioCapture}"
                                                      Margin="40,0" x:Name="audioEnable">
                                        </ToggleSwitch>
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander MinWidth="500" Header="Hardware monitor"
                                                     Description="Enable Hardware monitor plugin. This plugin is required for adaptive fan control mode.">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource
                                            Data="{DynamicResource wave_signal__heart_line_beat_square_graph_stats}">
                                        </ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding GeneralSettings.EnableHWMonitor}"
                                                      Margin="40,0" x:Name="hwMonitorEnable">
                                        </ToggleSwitch>
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander MinWidth="500" Header="OpenRGB"
                                                     Description="Enable OpenRGB plugin. This plugin is required for controlling 3rd party devices">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource plugin}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding GeneralSettings.EnableOpenRGB}" Margin="40,0" x:Name="ORGBoutline"></ToggleSwitch>
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>

                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Classes="smallBold" Text="Rendering"></TextBlock>
                    </Grid>
                    <Grid Margin="0,10,0,0" Row="1">
                        <!-- <ui:InfoBar Severity="Error" Title="Warning" IsOpen="True" -->
                        <!--             IsIconVisible="True" -->
                        <!--             IsClosable="False" -->
                        <!--             Message="Hardware settings for this device is not available at the moment"> -->
                        <!-- </ui:InfoBar> -->
                        <Grid>
                            <StackPanel Spacing="2">
                                <ui:InfoBar IsOpen="{Binding ShowRenderingInfoBar,Mode=TwoWay}" Severity="Warning"
                                            Message="Restart is require for changes to take effect"
                                            Title="Settings changed">
                                    <Button Command="{Binding RequestRestartApplicationCommand}" Margin="0,0,0,10"
                                            Content="Restart now">
                                    </Button>
                                </ui:InfoBar>
                                <ui:SettingsExpander MinWidth="500" Header="Target frame rate"
                                                     Description="Change the frame rate that of the bitmap rendering method">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource flash}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ui:FAComboBox ItemsSource="{Binding AvailableFrameRates}"
                                                       SelectedItem="{Binding TargetFramerate}" Margin="40,0">

                                        </ui:FAComboBox>
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander MinWidth="500" Header="Target bitmap size"
                                                     Description="Change size of the target bitmap if you find the default value is too small for your device layout">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource bitmapSize}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ui:FAComboBox ItemsSource="{Binding AvailableBitmapSize}"
                                                       SelectedItem="{Binding TargetBitmapSize}" Margin="40,0">

                                        </ui:FAComboBox>
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid RowDefinitions="Auto,*">
                    <Grid>
                        <TextBlock Classes="smallBold" Text="Update"></TextBlock>
                    </Grid>
                    <Grid Margin="0,10,0,0" Row="1">
                        <StackPanel Spacing="2">
                            <Grid Margin="0,10,0,0">
                                <!-- <Image Width="50" Source="/Assets/Images/uptodate.png"></Image> -->
                                <!-- <Grid Column="2"> -->
                                <!--     <StackPanel Margin="10,0" Spacing="10"> -->
                                <!--         <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding CurrentReleaseInformation.Version}"></TextBlock> -->
                                <!--         <Grid> -->
                                <!--             <StackPanel Orientation="Horizontal" Spacing="2"> -->
                                <!--                 <TextBlock  Classes="smallSecondary" -->
                                <!--                             Text="Last checked: "> -->
                                <!--                 </TextBlock> -->
                                <!--                 <TextBlock  Classes="smallSecondary" -->
                                <!--                             Text="{Binding CurrentReleaseInformation.ReleaseDate}"> -->
                                <!--                 </TextBlock> -->
                                <!--             </StackPanel> -->
                                <!--             -->
                                <!--         </Grid> -->
                                <!--         <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCheckingForUpdate}"></ProgressBar> -->
                                <!--     </StackPanel> -->
                                <!-- -->
                                <!-- </Grid> -->
                                <!-- <Grid Column="3"> -->
                                <!--     <Button IsEnabled="True" -->
                                <!--             Command="{Binding CheckForAppUpdateCommand}" -->
                                <!--             Content="Check for update" Classes="accent"> -->
                                <!--     </Button> -->
                                <!-- </Grid> -->
                                <ui:SettingsExpander MinWidth="500"
                                                     Header="{Binding CurrentReleaseInformation.Version}"
                                                     Description="{Binding CurrentReleaseInformation.ReleaseDate}">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource app_update}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <StackPanel Margin="40,0" Orientation="Horizontal" Spacing="10">
                                            <ui:ProgressRing IsIndeterminate="True"
                                                             IsVisible="{Binding IsCheckingForUpdate}"
                                                             Width="32" Height="32">
                                            </ui:ProgressRing>
                                            <Button IsEnabled="True"
                                                    Command="{Binding CheckForAppUpdateCommand}"
                                                    Content="Check for updates">
                                            </Button>
                                        </StackPanel>

                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                            </Grid>

                            <ui:InfoBar Title="Update available" Severity="Success"
                                        IsOpen="{Binding UpdateAvailable}" IsIconVisible="True"
                                        IsClosable="False"
                                        Message="{Binding UpdateInformation.Version}">
                                <ui:InfoBar.IconSource>
                                    <ui:PathIconSource
                                        Foreground="{DynamicResource AccentButtonBackground}"
                                        Data="{DynamicResource Import}">
                                    </ui:PathIconSource>
                                </ui:InfoBar.IconSource>
                                <Grid>
                                    <StackPanel Spacing="10" Orientation="Horizontal">
                                        <Button Command="{Binding InstallUpdateCommand}"
                                                Margin="0,0,0,20"
                                                Content="Install now">
                                        </Button>
                                        <ProgressBar IsVisible="{Binding IsUpdating}"
                                                     IsIndeterminate="False"
                                                     Value="{Binding CurrentUpdateProgress}"
                                                     Margin="0,0,0,20">
                                        </ProgressBar>
                                        <TextBlock VerticalAlignment="Center"
                                                   IsVisible="{Binding IsUpdating}"
                                                   Text="{Binding CurrentUpdatingStatus}" Margin="0,0,0,20">
                                        </TextBlock>
                                    </StackPanel>

                                </Grid>
                            </ui:InfoBar>
                            
                        </StackPanel>
                    </Grid>
                </Grid>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>