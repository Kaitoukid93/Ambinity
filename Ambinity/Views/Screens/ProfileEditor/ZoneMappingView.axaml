<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Ambinity.Views.Screens.ProfileEditor"
             xmlns:draw2Dcanvas = "clr-namespace:Ambinity.Views.Draw2DCanvas"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="local:ZoneMappingViewModel"
             x:Class="Ambinity.Views.Screens.ProfileEditor.ZoneMappingView">
    <Grid ColumnDefinitions="Auto,*">
        <local:ZoneMappingToolsView DataContext="{CompiledBinding ToolsViewModel}"></local:ZoneMappingToolsView>
        <draw2Dcanvas:Draw2DCanvasView Grid.Column="1" DataContext="{CompiledBinding CanvasViewModel}"></draw2Dcanvas:Draw2DCanvasView>
    </Grid>
</UserControl>
