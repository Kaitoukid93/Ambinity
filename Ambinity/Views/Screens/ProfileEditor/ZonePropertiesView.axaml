<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Screens.ProfileEditor"
             xmlns:positionConfiguration= "clr-namespace:Ambinity.Views.Configuration.PositionConfiguration"
             xmlns:colorConfiguration= "clr-namespace:Ambinity.Views.Configuration.ColorConfiguration"
             x:DataType="local:ZonePropertiesViewModel"
             x:Class="Ambinity.Views.Screens.ProfileEditor.ZonePropertiesView">
    <Grid RowDefinitions="50,10,*">
        <Grid Margin="18,0,18,0">
         <ContentControl Content="{Binding Header}"></ContentControl>
        </Grid>
        <Separator  Margin="18,0,18,10" Grid.Row="1" Height="1"></Separator>
        <Grid  Row="2">
            <ScrollViewer IsScrollInertiaEnabled="True">
            <StackPanel Margin="18,0,18,10">
                <positionConfiguration:PositionConfigurationView DataContext="{CompiledBinding PositionConfiguration}"></positionConfiguration:PositionConfigurationView>
                <Separator Margin="0,10"></Separator>
                <colorConfiguration:ColorConfigurationView DataContext="{CompiledBinding ColorConfiguration}"></colorConfiguration:ColorConfigurationView>
            </StackPanel>
            </ScrollViewer>
        </Grid>
        
    </Grid>
</UserControl>