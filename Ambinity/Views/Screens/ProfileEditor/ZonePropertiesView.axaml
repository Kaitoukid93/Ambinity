<UserControl
    x:Class="Ambinity.Views.Screens.ProfileEditor.ZonePropertiesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:colorConfiguration="clr-namespace:Ambinity.Views.Configuration.ColorConfiguration"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.Views.Screens.ProfileEditor"
    xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:positionConfiguration="clr-namespace:Ambinity.Views.Configuration.PositionConfiguration"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:ZonePropertiesViewModel"
    mc:Ignorable="d">
    <Grid RowDefinitions="50,10,*">
        <Grid Margin="18,0,18,0">
            <ContentControl Content="{Binding Header}" />
        </Grid>
        <Separator
            Grid.Row="1"
            Height="1"
            Margin="18,0,18,10" />
        <Grid Row="2">
            <ScrollViewer IsScrollInertiaEnabled="True">
                <StackPanel Margin="18,0,18,10">
                    <ContentControl
                        Content="{Binding PositionConfiguration}"
                        IsEnabled="{Binding EnablePositionEdit}"
                        IsVisible="{Binding EnablePositionEdit}" />
                    <Separator Margin="0,10" />
                    <colorConfiguration:ColorConfigurationView DataContext="{Binding ColorConfiguration}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
