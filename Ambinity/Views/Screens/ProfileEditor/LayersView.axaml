<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local = "clr-namespace:Ambinity.Views.Screens.ProfileEditor"
             x:DataType="local:LayersViewModel"
             x:Class="Ambinity.Views.Screens.ProfileEditor.LayersView">
  
    <ListBox ItemsSource="{Binding Layers}">
    <ListBox.DataTemplates>
        <DataTemplate DataType="{x:Type local:ZoneLayerViewModel}">
                <local:ZoneLayerView></local:ZoneLayerView>
        </DataTemplate>
    </ListBox.DataTemplates>
</ListBox>
</UserControl>
