<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Screens.ProfileEditor.Library"
             x:DataType="local:LightingZonesLibraryViewModel"
             x:Class="Ambinity.Views.Screens.ProfileEditor.Library.LightingZonesLibraryView">
    <Grid Background="Transparent" Width="300" Height="472">
        <ContentControl Content="{Binding AssetsViewModel}"></ContentControl>
    </Grid>
</UserControl>
