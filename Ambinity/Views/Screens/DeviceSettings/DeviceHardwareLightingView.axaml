<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Screens.DeviceSettings"
             x:DataType="local:DeviceHardwareLightingViewModel"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:Class="Ambinity.Views.Screens.DeviceSettings.DeviceHardwareLightingView">
    <Grid>
        <StackPanel Spacing="30">
            <Grid RowDefinitions="Auto,*">
                <Grid>
                    <TextBlock Classes="smallBold" Text="Hardware settings"></TextBlock>
                </Grid>
                <Grid Margin="0,10,0,0" Row="1">
                    <ui:InfoBar Foreground="OrangeRed" Title="Warning" IsOpen="{Binding !IsAvailable}"
                                IsIconVisible="True"
                                IsClosable="False"
                                Message="Hardware settings for this device is not available at the moment">
                        <ui:InfoBar.IconSource>
                            <ui:PathIconSource Data="{DynamicResource disable}"></ui:PathIconSource>
                        </ui:InfoBar.IconSource>
                        <ui:InfoBar.Background>
                            <SolidColorBrush Color="OrangeRed" Opacity="0.1"></SolidColorBrush>
                        </ui:InfoBar.Background>
                    </ui:InfoBar>
                    <Grid>
                        <StackPanel Spacing="2">
                            <ui:SettingsExpander MinWidth="500" Header="Hardware lighting"
                                                 IsExpanded="True"
                                                 IsVisible="{Binding IsAvailable}"
                                                 Description="Personalize device lighting when application is not running, click for more settings."
                                                 Name="SettingsExpander3">
                                <ui:SettingsExpander.IconSource>
                                    <ui:PathIconSource Data="{DynamicResource brightness}"></ui:PathIconSource>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ui:FAComboBox SelectedItem="{Binding SelectedHWLMode}"
                                                   ItemsSource="{Binding AvailableHWLModes}">

                                    </ui:FAComboBox>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem MinWidth="500" Content="Delay time"
                                                         IsEnabled="{Binding EnableHWLExpand}"
                                                         Description="Return to Hardware Lighting after the selected amount of seconds"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <ui:NumberBox Margin="40,0" Minimum="1"
                                                      Value="{Binding LedHardwareSettings.HWL_returnafter}"
                                                      Maximum="10">
                                        </ui:NumberBox>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Brightness"
                                                         IsEnabled="{Binding EnableHWLExpand}"
                                                         Description="Brightness of hardware lighting effect"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Margin="40,0">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,20,2"
                                                       Text="{Binding ElementName=brightness,Path=Value}">
                                            </TextBlock>
                                            <Slider IsSnapToTickEnabled="True" TickFrequency="1" x:Name="brightness"
                                                    Margin="0" Width="160"
                                                    Value="{Binding LedHardwareSettings.HWL_brightness}"
                                                    Minimum="20" Maximum="255">
                                            </Slider>
                                        </StackPanel>

                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Colors"
                                                         IsVisible="{Binding !EnableColorPalette}"
                                                         IsEnabled="{Binding EnableHWLExpand}"
                                                         Description="Chose color for selected effect"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <ui:ColorPickerButton Height="32" Margin="40,0"></ui:ColorPickerButton>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Palettes"
                                                         IsVisible="{Binding EnableColorPalette}"
                                                         IsEnabled="{Binding EnableHWLExpand}"
                                                         Description="Chose palette for selected effect"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <Grid ColumnDefinitions="150,15,auto" Margin="40,0">
                                            <Border CornerRadius="2" Background="Transparent" ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding SelectedPalette.Colors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1"
                                                                         Columns="{Binding SelectedPalette.Colors.Count}">
                                                            </UniformGrid>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border HorizontalAlignment="Stretch" Height="30">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{Binding }"></SolidColorBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <Button Grid.Column="2" x:Name="colorPaletteButton"
                                                    ToolTip.Tip="Show library"
                                                    Command="{Binding OpenColorPaletteLibraryCommand}" Padding="1"
                                                    Background="Transparent" Width="30" Height="30"
                                                    Classes="icon-button">
                                                <FlyoutBase.AttachedFlyout>
                                                    <Flyout Closing="PopupFlyoutBase_OnClosing"
                                                            FlyoutPresenterClasses="DefaultFlyout"
                                                            HorizontalOffset="-326" VerticalOffset="-473">
                                                        <Grid>
                                                            <ContentControl Focusable="True"
                                                                            Content="{CompiledBinding CurrentFlyoutViewModel}">
                                                            </ContentControl>
                                                            <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
                                                                <StackPanel HorizontalAlignment="Right"
                                                                            Orientation="Horizontal"
                                                                            Margin="10" Spacing="5">
                                                                    <!-- <Grid> -->
                                                                    <!--     <Button ToolTip.Tip="Add to Library" Padding="1" Background="Transparent" Width="30" Height="30" -->
                                                                    <!--             Classes="icon-button"> -->
                                                                    <!--         <PathIcon Width="15" Data="{DynamicResource plus}"></PathIcon> -->
                                                                    <!--     </Button> -->
                                                                    <!-- </Grid> -->
                                                                    <Grid>
                                                                        <Button ToolTip.Tip="Close" Padding="1"
                                                                            Click="Button_OnClick"
                                                                            Background="Transparent" Width="30"
                                                                            Height="30"
                                                                            Classes="icon-button">
                                                                            <PathIcon Margin="1,1,0,0" Width="17"
                                                                                Data="{DynamicResource plus}">
                                                                                <PathIcon.RenderTransform>
                                                                                    <RotateTransform Angle="45"></RotateTransform>
                                                                                </PathIcon.RenderTransform>
                                                                            </PathIcon>
                                                                        </Button>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>

                                                    </Flyout>
                                                </FlyoutBase.AttachedFlyout>
                                                <PathIcon Width="15" Data="{DynamicResource collection}"></PathIcon>
                                            </Button>
                                        </Grid>


                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Speed"
                                                         IsVisible="{Binding EnableColorSpeed}"
                                                         IsEnabled="{Binding EnableHWLExpand}"
                                                         Description="Speed of hardware lighting effect"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Margin="40,0">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,20,2"
                                                       Text="{Binding ElementName=speed,Path=Value}">
                                            </TextBlock>
                                            <Slider IsSnapToTickEnabled="True" TickFrequency="1" x:Name="speed"
                                                    Margin="0" Width="160"
                                                    Value="{Binding LedHardwareSettings.HWL_effectSpeed}"
                                                    Minimum="1" Maximum="20">
                                            </Slider>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Intensity"
                                                         IsVisible="{Binding EnableColorIntensity}"
                                                         IsEnabled="{Binding EnableHWLExpand}"
                                                         Description="Color intensity of hardware lighting effect"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Margin="40,0">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,20,2"
                                                       Text="{Binding ElementName=intensity,Path=Value}">
                                            </TextBlock>
                                            <Slider IsSnapToTickEnabled="True" TickFrequency="1" x:Name="intensity"
                                                    Margin="0" Width="160"
                                                    Value="{Binding LedHardwareSettings.HWL_effectIntensity}"
                                                    Minimum="16" Maximum="64">
                                            </Slider>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Apply these settings"
                                                         Description="Settings will be saved to device's memory and will not be erased after updating firmware"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <Button Command="{Binding ApplyHardwareSettingsCommand}" Margin="40,0"
                                                Content="Apply">
                                        </Button>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>
                            <ui:SettingsExpander IsVisible="{Binding HasFanControl}" Header="Hardware fan control"
                                                 Description="Speed of all fan when application is not running."
                                                 IsExpanded="True"
                                                 Name="SettingsExpander2">
                                <ui:SettingsExpander.IconSource>
                                    <ui:PathIconSource Data="{DynamicResource fanSpeedController}"></ui:PathIconSource>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem Content="PWM zone 1"
                                                         Description="Ambino single zone PWM controller"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <Slider Margin="40,0" Minimum="0" Maximum="255" Value="{Binding FanHardwareSettings.HW_FanSpeed}"
                                                Width="160" />
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Apply this setting"
                                                         Description="Settings will be saved to device's memory and will not be erased after updating firmware"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <Button Command="{Binding ApplyHardwareSettingsCommand}" Margin="40,0"
                                                Content="Apply">
                                        </Button>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>
                        </StackPanel>
                    </Grid>

                </Grid>

            </Grid>
        </StackPanel>
    </Grid>


</UserControl>