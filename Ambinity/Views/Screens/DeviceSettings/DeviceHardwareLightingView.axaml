<UserControl
    x:Class="Ambinity.Views.Screens.DeviceSettings.DeviceHardwareLightingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ambinity.Views.Screens.DeviceSettings"
    xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:DeviceHardwareLightingViewModel"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Spacing="30">
            <Grid RowDefinitions="Auto,*">
                <Grid>
                    <TextBlock Classes="smallBold" Text="Hardware settings" />
                </Grid>
                <Grid Margin="0,10,0,0" Row="1">
                    <ui:InfoBar
                        Title="Warning"
                        IsClosable="False"
                        IsIconVisible="True"
                        IsOpen="{Binding !IsAvailable}"
                        Message="Hardware settings for this device is not available at the moment"
                        Severity="Error" />
                    <Grid>
                        <StackPanel Spacing="2">
                            <ui:SettingsExpander
                                Name="SettingsExpander3"
                                MinWidth="500"
                                Description="Personalize device lighting when application is not running, click for more settings."
                                Header="Hardware lighting"
                                IsExpanded="True"
                                IsVisible="{Binding IsAvailable}">
                                <ui:SettingsExpander.IconSource>
                                    <ui:PathIconSource Data="{DynamicResource brightness}" />
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ui:FAComboBox ItemsSource="{Binding AvailableHWLModes}" SelectedItem="{Binding SelectedHWLMode}" />
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem
                                    MinWidth="500"
                                    Content="Max LED Support"
                                    Description="Maximum number of LEDs this hardware support for each output. Some hardware might only support up to 80 LEDs."
                                    IsClickEnabled="False"
                                    IsEnabled="{Binding EnableHWLExpand}">
                                    <ui:SettingsExpanderItem.Footer>
                                        <ui:NumberBox
                                            Margin="40,0"
                                            Maximum="200"
                                            Minimum="1"
                                            Value="{Binding LedHardwareSettings.HWL_MaxLEDPerOutput}" />
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem
                                    MinWidth="500"
                                    Content="Delay time"
                                    Description="Return to Hardware Lighting after the selected amount of seconds"
                                    IsClickEnabled="False"
                                    IsEnabled="{Binding EnableHWLExpand}">
                                    <ui:SettingsExpanderItem.Footer>
                                        <ui:NumberBox
                                            Margin="40,0"
                                            Maximum="10"
                                            Minimum="1"
                                            Value="{Binding LedHardwareSettings.HWL_returnafter}" />
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem
                                    Content="Brightness"
                                    Description="Brightness of hardware lighting effect"
                                    IsClickEnabled="False"
                                    IsEnabled="{Binding EnableHWLExpand}">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Margin="40,0" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,20,2"
                                                VerticalAlignment="Center"
                                                Text="{Binding ElementName=brightness, Path=Value}" />
                                            <Slider
                                                x:Name="brightness"
                                                Width="160"
                                                Margin="0"
                                                IsSnapToTickEnabled="True"
                                                Maximum="255"
                                                Minimum="20"
                                                TickFrequency="1"
                                                Value="{Binding LedHardwareSettings.HWL_brightness}" />
                                        </StackPanel>

                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem
                                    Content="Colors"
                                    Description="Chose color for selected effect"
                                    IsClickEnabled="False"
                                    IsEnabled="{Binding EnableHWLExpand}"
                                    IsVisible="{Binding !EnableColorPalette}">
                                    <ui:SettingsExpanderItem.Footer>
                                        <ui:ColorPickerButton
                                            Height="32"
                                            Margin="40,0"
                                            Color="{Binding SelectedColor}" />
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem
                                    Content="Palettes"
                                    Description="Chose palette for selected effect"
                                    IsClickEnabled="False"
                                    IsEnabled="{Binding EnableHWLExpand}"
                                    IsVisible="{Binding EnableColorPalette}">
                                    <ui:SettingsExpanderItem.Footer>
                                        <Grid Margin="40,0" ColumnDefinitions="150,15,auto">
                                            <Border
                                                Background="Transparent"
                                                ClipToBounds="True"
                                                CornerRadius="2">
                                                <ItemsControl ItemsSource="{Binding SelectedPalette.Colors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="{Binding SelectedPalette.Colors.Count}" Rows="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="30" HorizontalAlignment="Stretch">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{Binding}" />
                                                                </Border.Background>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <Button
                                                x:Name="colorPaletteButton"
                                                Grid.Column="2"
                                                Width="30"
                                                Height="30"
                                                Padding="1"
                                                Background="Transparent"
                                                Classes="icon-button"
                                                Command="{Binding OpenColorPaletteLibraryCommand}"
                                                ToolTip.Tip="Show library">
                                                <FlyoutBase.AttachedFlyout>
                                                    <Flyout
                                                        Closing="PopupFlyoutBase_OnClosing"
                                                        FlyoutPresenterClasses="DefaultFlyout"
                                                        HorizontalOffset="-180"
                                                        Placement="LeftEdgeAlignedBottom">
                                                        <Grid>
                                                            <ContentControl Content="{CompiledBinding CurrentFlyoutViewModel}" Focusable="True" />
                                                            <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
                                                                <StackPanel
                                                                    Margin="10"
                                                                    HorizontalAlignment="Right"
                                                                    Orientation="Horizontal"
                                                                    Spacing="5">
                                                                    <!-- <Grid> -->
                                                                    <!--  <Button ToolTip.Tip="Add to Library" Padding="1" Background="Transparent" Width="30" Height="30"  -->
                                                                    <!--  Classes="icon-button">  -->
                                                                    <!--         <PathIcon Width="15" Data="{DynamicResource plus}"></PathIcon> -->
                                                                    <!--     </Button> -->
                                                                    <!-- </Grid> -->
                                                                    <Grid>
                                                                        <Button
                                                                            Width="30"
                                                                            Height="30"
                                                                            Padding="1"
                                                                            Background="Transparent"
                                                                            Classes="icon-button"
                                                                            Click="Button_OnClick"
                                                                            ToolTip.Tip="Close">
                                                                            <PathIcon
                                                                                Width="17"
                                                                                Margin="1,1,0,0"
                                                                                Data="{DynamicResource plus}">
                                                                                <PathIcon.RenderTransform>
                                                                                    <RotateTransform Angle="45" />
                                                                                </PathIcon.RenderTransform>
                                                                            </PathIcon>
                                                                        </Button>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>

                                                    </Flyout>
                                                </FlyoutBase.AttachedFlyout>
                                                <PathIcon Width="15" Data="{DynamicResource collection}" />
                                            </Button>
                                        </Grid>


                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem
                                    Content="Speed"
                                    Description="Speed of hardware lighting effect"
                                    IsClickEnabled="False"
                                    IsEnabled="{Binding EnableHWLExpand}"
                                    IsVisible="{Binding EnableColorSpeed}">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Margin="40,0" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,20,2"
                                                VerticalAlignment="Center"
                                                Text="{Binding ElementName=speed, Path=Value}" />
                                            <Slider
                                                x:Name="speed"
                                                Width="160"
                                                Margin="0"
                                                IsSnapToTickEnabled="True"
                                                Maximum="20"
                                                Minimum="1"
                                                TickFrequency="1"
                                                Value="{Binding LedHardwareSettings.HWL_effectSpeed}" />
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem
                                    Content="Intensity"
                                    Description="Color intensity of hardware lighting effect"
                                    IsClickEnabled="False"
                                    IsEnabled="{Binding EnableHWLExpand}"
                                    IsVisible="{Binding EnableColorIntensity}">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Margin="40,0" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,20,2"
                                                VerticalAlignment="Center"
                                                Text="{Binding ElementName=intensity, Path=Value}" />
                                            <Slider
                                                x:Name="intensity"
                                                Width="160"
                                                Margin="0"
                                                IsSnapToTickEnabled="True"
                                                Maximum="64"
                                                Minimum="16"
                                                TickFrequency="1"
                                                Value="{Binding LedHardwareSettings.HWL_effectIntensity}" />
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem
                                    Content="Apply these settings"
                                    Description="Settings will be saved to device's memory and will not be erased after updating firmware"
                                    IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <Button
                                            Margin="40,0"
                                            Command="{Binding ApplyHardwareSettingsCommand}"
                                            Content="Apply" />
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>
                            <ui:SettingsExpander
                                Name="SettingsExpander2"
                                Description="Speed of all fan when application is not running."
                                Header="Hardware fan control"
                                IsExpanded="True"
                                IsVisible="{Binding HasFanControl}">
                                <ui:SettingsExpander.IconSource>
                                    <ui:PathIconSource Data="{DynamicResource fanSpeedController}" />
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem
                                    Content="PWM zone 1"
                                    Description="Ambino single zone PWM controller"
                                    IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <Slider
                                            Width="160"
                                            Margin="40,0"
                                            Maximum="255"
                                            Minimum="0"
                                            Value="{Binding FanHardwareSettings.HW_FanSpeed}" />
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem
                                    Content="Apply this setting"
                                    Description="Settings will be saved to device's memory and will not be erased after updating firmware"
                                    IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <Button
                                            Margin="40,0"
                                            Command="{Binding ApplyHardwareSettingsCommand}"
                                            Content="Apply" />
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>
                        </StackPanel>
                    </Grid>

                </Grid>

            </Grid>
        </StackPanel>
    </Grid>


</UserControl>
