<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Screens.DeviceSettings"
             x:DataType="local:AmbinityDeviceDetailViewModel"
             x:Class="Ambinity.Views.Screens.DeviceSettings.AmbinityDeviceDetailView">
        <Grid ColumnDefinitions="Auto,10,*,Auto" Height="100">
            <Image Width="100" Height="100" HorizontalAlignment="Left"
                   Source="{Binding GetThumbnail^,FallbackValue=null}" VerticalAlignment="Center" Stretch="Uniform">
            </Image>

            <Grid Column="2">
                <StackPanel Margin="10,0" Spacing="2">
                    <TextBlock ToolTip.Tip="{Binding Name}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                               MaxWidth="180" FontWeight="SemiBold" Text="{Binding Name}">
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Left" FontSize="12"
                               Foreground="{DynamicResource ButtonForegroundDisabled}"
                               Text="{Binding LEDsCount  }">
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Left" FontSize="12" ToolTip.Tip="{Binding FilePath}"
                               TextTrimming="CharacterEllipsis" MaxWidth="200"
                               Foreground="{DynamicResource ButtonForegroundDisabled}"
                               Text="{Binding FilePath  }">
                    </TextBlock>
                </StackPanel>


            </Grid>
            <Grid Column="3">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top" Spacing="5">
                    <Grid>
                        <Button ToolTip.Tip="Show library" Command="{Binding OpenLibraryCommand}" Padding="1"
                                Background="Transparent" Width="30" Height="30"
                                Classes="icon-button">
                            <PathIcon Width="15" Data="{DynamicResource collection}"></PathIcon>
                        </Button>
                    </Grid>


                </StackPanel>
            </Grid>
        </Grid>
</UserControl>