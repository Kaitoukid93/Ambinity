<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="872"
             xmlns:local="clr-namespace:Ambinity.Views.Screens.DeviceSettings"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:DataType="local:DeviceSettingsViewModel"
             x:Class="Ambinity.Views.Screens.DeviceSettings.DeviceSettingsView">
    <ScrollViewer>
        <Grid HorizontalAlignment="Stretch" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="Auto,*">
                <Button Command="{Binding BackToDashboardCommand}" Margin="10" Classes="icon-button">
                    <PathIcon Width="15" Height="15" Data="{DynamicResource back}"></PathIcon>
                </Button>
                <Grid ColumnDefinitions="Auto,*" Column="1">
                    <Grid>
                        <Image Margin="10" Height="90" Stretch="Uniform"
                               Source="{Binding Controller.Thumbnail}">
                        </Image>
                    </Grid>
                    <Grid Column="1">
                        <StackPanel>
                            <TextBlock FontSize="15" Margin="10,10,10,5" FontWeight="SemiBold" Text="Ambino FanHUB"></TextBlock>
                            <TextBlock FontSize="13" Margin="10,0,10,5"
                                       Foreground="{DynamicResource ButtonForegroundDisabled}" Text="AFR3g">
                            </TextBlock>

                            <HyperlinkButton Margin="5,0" Height="25" Padding="5,2,5,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontSize="13" Text="More info"></TextBlock>
                                    <PathIcon Margin="5,0,0,1" Grid.Column="1" Height="15" Width="15"
                                              Data="{DynamicResource link}">
                                    </PathIcon>
                                </Grid>
                            </HyperlinkButton>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <Grid  Margin="0"  Row="1">
                <StackPanel   Margin="60,10,10,10">
                   
                    <Grid Margin="0,0,25,0" RowDefinitions="Auto,*">
                        <Grid>
                            <TextBlock Text="Connection"></TextBlock>
                        </Grid>
                        <Grid Margin="0,10,0,0" Row="1">
                            <StackPanel>
                                <ui:SettingsExpander MinWidth="500" Margin="0,2" Grid.Row="1" Header="Auto Connect"

                                                     Description="Auto connect to device when available"
                                                     IsClickEnabled="False">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource link}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ToggleSwitch></ToggleSwitch>
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                                <ui:SettingsExpander MinWidth="500" Margin="0,2" Grid.Row="1" Header="COM Port"
                                                     Description="Serial Port of the device"
                                                     IsClickEnabled="False">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource usb_port}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <ui:FAComboBox>
                                            <ui:FAComboBoxItem>
                                                COM1
                                            </ui:FAComboBoxItem>
                                            <ui:FAComboBoxItem>
                                                COM2
                                            </ui:FAComboBoxItem>
                                            <ui:FAComboBoxItem>
                                                COM3
                                            </ui:FAComboBoxItem>
                                        </ui:FAComboBox>
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                            </StackPanel>
                        </Grid>

                    </Grid>
                    <Grid Margin="0,30,25,0" RowDefinitions="Auto,*">
                        <Grid>
                            <TextBlock Text="Hardware Lighting"></TextBlock>
                        </Grid>
                        <Grid Margin="0,10,0,0" Row="1">
                            <ui:SettingsExpander MinWidth="500" Header="Mode"
                                                 Description="Personalize device lighting when application is not running"
                                                 Name="SettingsExpander3">
                                <ui:SettingsExpander.IconSource>
                                    <ui:PathIconSource Data="{DynamicResource brightness}"></ui:PathIconSource>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ui:FAComboBox>
                                        <ui:FAComboBoxItem>
                                            Static Color
                                        </ui:FAComboBoxItem>
                                        <ui:FAComboBoxItem>
                                            Color Palette
                                        </ui:FAComboBoxItem>
                                        <ui:FAComboBoxItem>
                                            Disable
                                        </ui:FAComboBoxItem>
                                    </ui:FAComboBox>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem MinWidth="500" Content="Delay time"
                                                         Description="Return to Hardware Lighting after the selected amount of seconds"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <ui:NumberBox Margin="40,0" Minimum="1" Maximum="10"></ui:NumberBox>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem  Content="Brightness"
                                                         Description="Brightness of hardware lighting effect"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Margin="40,0">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,20,2"
                                                       Text="{Binding ElementName=brightness,Path=Value}">
                                            </TextBlock>
                                            <Slider IsSnapToTickEnabled="True" TickFrequency="1" x:Name="brightness"
                                                    Margin="0" Width="160" Value="50" Minimum="0" Maximum="100">
                                            </Slider>
                                        </StackPanel>

                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Colors"
                                                         Description="Chose color for selected effect"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <ui:ColorPickerButton Height="32" Margin="40,0"></ui:ColorPickerButton>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Speed"
                                                         Description="Speed of hardware lighting effect"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Margin="40,0">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,20,2"
                                                       Text="{Binding ElementName=speed,Path=Value}">
                                            </TextBlock>
                                            <Slider IsSnapToTickEnabled="True" TickFrequency="1" x:Name="speed"
                                                    Margin="0" Width="160" Value="50" Minimum="0" Maximum="100">
                                            </Slider>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Intensity"
                                                         Description="Color intensity of hardware lighting effect"
                                                         IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Margin="40,0">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,20,2"
                                                       Text="{Binding ElementName=intensity,Path=Value}">
                                            </TextBlock>
                                            <Slider IsSnapToTickEnabled="True" TickFrequency="1" x:Name="intensity"
                                                    Margin="0" Width="160" Value="50" Minimum="0" Maximum="100">
                                            </Slider>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem IsClickEnabled="False">
                                    <ui:SettingsExpanderItem.Footer>
                                        <Button Margin="40,0" Content="Apply"></Button>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,30,25,0" RowDefinitions="Auto,*">
                        <Grid>
                            <TextBlock Text="Firmware"></TextBlock>
                        </Grid>
                        <Grid Margin="0,10,0,0" Row="1">
                            <StackPanel>

                                <ui:InfoBar Foreground="{DynamicResource SystemAccentColor}" Title="Update available"
                                            IsOpen="True" IsIconVisible="True" IsClosable="True"
                                            Message="Firmware version 1.0.9">
                                    <ui:InfoBar.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource infoCircle}"></ui:PathIconSource>
                                    </ui:InfoBar.IconSource>
                                    <ui:InfoBar.Background>
                                        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.1"></SolidColorBrush>
                                    </ui:InfoBar.Background>
                                </ui:InfoBar>
                                <ui:SettingsExpander MinWidth="500" Margin="0,2" Grid.Row="1" Header="Current Firmware"
                                                     Description="Current version of the firmware"
                                                     IsClickEnabled="False">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource update}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>
                                    <ui:SettingsExpander.Footer>
                                        <Button Content="Check for update"></Button>
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>

                                <ui:InfoBar  Foreground="Orange" Title="Warning" IsOpen="True"
                                            IsIconVisible="True"
                                            IsClosable="True"
                                            Message="Upgrade custom firmware could brick your device, use at your own risk !!!">
                                    <ui:InfoBar.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource warning_Fill}"></ui:PathIconSource>
                                    </ui:InfoBar.IconSource>
                                    <ui:InfoBar.Background>
                                       <SolidColorBrush Color="Orange" Opacity="0.1"></SolidColorBrush>
                                    </ui:InfoBar.Background>
                                </ui:InfoBar>
                                <ui:SettingsExpander MinWidth="500" Margin="0,2" Grid.Row="1" Header="Custom firmware"
                                                     Description="Load custom firmware"
                                                     IsClickEnabled="False">
                                    <ui:SettingsExpander.IconSource>
                                        <ui:PathIconSource Data="{DynamicResource custom_firmware}"></ui:PathIconSource>
                                    </ui:SettingsExpander.IconSource>

                                    <ui:SettingsExpanderItem Content="Delay time"
                                                             Description="Return to Hardware Lighting after the selected amount of seconds"
                                                             IsClickEnabled="False">
                                        <ui:SettingsExpanderItem.Footer>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox BorderThickness="0" Text="123"></TextBox>
                                                <Button Margin="40,0" Content="Browse firmware"></Button>
                                            </StackPanel>

                                        </ui:SettingsExpanderItem.Footer>

                                    </ui:SettingsExpanderItem>

                                    <ui:SettingsExpanderItem IsClickEnabled="False">
                                        <ui:SettingsExpanderItem.Footer>
                                            <Button Margin="40,0" Content="Apply"></Button>
                                        </ui:SettingsExpanderItem.Footer>
                                    </ui:SettingsExpanderItem>
                                </ui:SettingsExpander>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>