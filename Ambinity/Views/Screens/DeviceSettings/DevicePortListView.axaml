<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Screens.DeviceSettings"
             x:DataType="local:DevicePortViewModel"
             x:Class="Ambinity.Views.Screens.DeviceSettings.DevicePortListView">
    <Grid PointerPressed="ContainerGrid_OnPointerPressed" PointerExited="ContainerGrid_OnPointerExited"
          PointerEntered="ContainerGrid_OnPointerEntered" Margin="0,0,0,0" x:Name="ContainerGrid">
        <Border IsVisible="{Binding IsSelected}"
                Height="35" Background="{DynamicResource ListViewItemBackgroundPointerOver}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                CornerRadius="4" Margin="0,5,0,5">
        </Border>
        <Border IsVisible="{Binding IsMouseOver}"
                Height="35" Background="{DynamicResource ListViewItemBackgroundPointerOver}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                CornerRadius="4" Margin="0,5,0,5">
        </Border>
        <Grid Height="35" Margin="0,5,0,5" Background="Transparent" ColumnDefinitions="Auto,*,Auto,Auto">
            <PathIcon Margin="10,0,10,0" Data="{Binding Icon,Converter={StaticResource ResourceConverter}}"></PathIcon>
            <TextBlock Grid.Column="1" Padding="0 5"
                       FontWeight="SemiBold"
                       PointerPressed="InputElement_OnPointerPressed"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       HorizontalAlignment="Left" Text="{Binding Content}">
            </TextBlock>
            <!-- <Button IsVisible="{Binding ShowButtons}" Grid.Column="2" Margin="0,0,2,0" -->
            <!--         Classes="icon-button icon-button-small"> -->
            <!--     <PathIcon Width="13" Height="13" Data="{DynamicResource 'Eye Open'}"></PathIcon> -->
            <!-- </Button> -->
            <!-- <Button IsVisible="{Binding ShowButtons}" Margin="0,0,6,0" Grid.Column="3" -->
            <!--         Classes=" icon-button icon-button-small"> -->
            <!-- -->
            <!--     <PathIcon Width="13" Height="13" Data="{DynamicResource 'delete'}"></PathIcon> -->
            <!-- </Button> -->

        </Grid>

    </Grid>

</UserControl>