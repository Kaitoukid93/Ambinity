<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:Ambinity.Views.Screens.DeviceSettings"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="local:DeviceCoolingSettingsViewModel"
             x:Class="Ambinity.Views.Screens.DeviceSettings.DeviceCoolingSettingsView">
    <Grid RowDefinitions="Auto,*">
        <Grid>
            <TextBlock Classes="smallBold" Text="{localize:Loc CoolingControl.Section.Header}"></TextBlock>
        </Grid>
        <Grid Margin="0,10,0,0" Row="1">
            <StackPanel Spacing="2">
                <ui:SettingsExpander Header="{localize:Loc FanControl.SettingsExpander.Header}"
                                     ItemsSource="{Binding Items}"
                                     Description="{localize:Loc FanControl.SettingsExpander.Description}"
                                     Tag="{Binding HWmonitorAvailable}"
                                     IsExpanded="True">
                    <ui:SettingsExpander.IconSource>
                        <ui:PathIconSource Data="{DynamicResource fanSpeedController}"></ui:PathIconSource>
                    </ui:SettingsExpander.IconSource>
                    <ui:SettingsExpander.DataTemplates>
                        <DataTemplate DataType="{x:Type local:FanPortViewModel}">
                            <ui:SettingsExpanderItem Height="70" Content="{Binding Name}" Description="{Binding Description}" IsClickEnabled="False">
                                <ui:SettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="10" >
                                        <Slider Value="{Binding FixedSpeed}" VerticalAlignment="Center" IsVisible="{Binding ElementName=cbx,Path=!SelectedIndex}" Width="200"></Slider>
                                        <ui:RangeSlider StepFrequency="1" MinimumRange="20" VerticalAlignment="Center" IsVisible="{Binding ElementName=cbx,Path=SelectedIndex}" Width="200" Minimum="0" Maximum="100"></ui:RangeSlider>
                                        <ui:FAComboBox Width="140" IsEnabled="{Binding HWMonitorAvailable}" SelectedItem="{Binding SelectedControlMode}" VerticalAlignment="Center" x:Name="cbx" Margin="40,0" ItemsSource="{Binding AvailableControlMode }">
                                        </ui:FAComboBox>
                                    </StackPanel>
                                </ui:SettingsExpanderItem.Footer>
                            </ui:SettingsExpanderItem>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:HWMonitorChartViewModel}">
                            <ui:SettingsExpanderItem IsEnabled="False" Content="{Binding Sensor.Name}" Description="{Binding Sensor.SensorType}" IsClickEnabled="False">
                                <ui:SettingsExpanderItem.Footer>
                                    <lvc:CartesianChart TooltipBackgroundPaint="{Binding ToolTipPaint}" TooltipTextSize="12" TooltipTextPaint="{Binding ToolTipTextPaint}"  Margin="10,0" Height="40" Width="200"
                                                        SyncContext="{Binding Sync}"
                                                        Series="{Binding Series}"
                                                        XAxes="{Binding XAxis}"
                                                        YAxes="{Binding YAxis}">
                                        </lvc:CartesianChart>
                                </ui:SettingsExpanderItem.Footer>
                            </ui:SettingsExpanderItem>
                        </DataTemplate>
                    </ui:SettingsExpander.DataTemplates>
                </ui:SettingsExpander>
                <ui:InfoBar IsVisible="{Binding HWmonitorAvailable}" Severity="Informational" Title="{localize:Loc FanControlMode.InforBar.Title}" IsOpen="True"
                            IsIconVisible="True"
                            IsClosable="False"
                            Message="{localize:Loc FanControlMode.InforBar.Message}">
                    <!-- <ui:InfoBar.IconSource> -->
                    <!--     <ui:PathIconSource Data="{DynamicResource infoCircle}"></ui:PathIconSource> -->
                    <!-- </ui:InfoBar.IconSource> -->

                </ui:InfoBar>
                <ui:InfoBar IsVisible="{Binding !HWmonitorAvailable}" Severity="{localize:Loc Error.InforBar.Title}" Title="{localize:Loc Error.InforBar.Title}" IsOpen="True"
                            IsIconVisible="True"
                            IsClosable="False"
                            Message="Can not read Motherboard Hardware information">
                    <!-- <ui:InfoBar.IconSource> -->
                    <!--     <ui:PathIconSource Data="{DynamicResource infoCircle}"></ui:PathIconSource> -->
                    <!-- </ui:InfoBar.IconSource> -->

                </ui:InfoBar>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
