<UserControl
    x:Class="Ambinity.Windows.NewDeviceDialogContent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
    xmlns:local="clr-namespace:Ambinity.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:NewDeviceDialogContentViewModel"
    mc:Ignorable="d">
    <Grid>
        <StackPanel MinWidth="400" Spacing="10">
            <TextBlock Text="Select device type you want to add"></TextBlock>
            <ListBox
                ItemContainerTheme="{DynamicResource _striplessListboxItem}"
                ItemsSource="{Binding DeviceCards}"
                SelectedItem="{Binding SelectedDeviceCard}"
                Theme="{DynamicResource _striplessListbox}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="70" ColumnDefinitions="100,5,*">
                            <Image
                                Margin="5"
                                HorizontalAlignment="Left"
                                Source="{Binding Thumbnail}" />
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource ButtonForegroundDisabled}"
                                    Text="{Binding Description}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Height="20" />
            <TextBlock Text="COM Port"></TextBlock>
            <Grid ColumnDefinitions="*,10,Auto">
                <ui:FAComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding AvailablePorts}"
                    SelectedItem="{Binding SelectedPort}">
                    <ui:FAComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding PortAddres}" />
                                <TextBlock Text="-" />
                                <TextBlock Text="{Binding VID}" />
                                <TextBlock Text="-" />
                                <TextBlock Text="{Binding PID}" />
                            </StackPanel>
                        </DataTemplate>
                    </ui:FAComboBox.ItemTemplate>
                </ui:FAComboBox>
                <Button
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Classes="iconButton"
                    Command="{Binding RefreshPortsCommand}">
                    <PathIcon Data="{DynamicResource cycle}" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
