<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local = "clr-namespace:Ambinity.Windows"
             x:DataType="local:LoadingDialogViewModel"
             x:Class="Ambinity.Windows.LoadingDialogContent">
    <Grid>
        <ProgressBar IsVisible="{Binding ProgressbarVissible}" IsIndeterminate="True"></ProgressBar>
        <TextBlock IsVisible="{Binding ErrorMessageVissible}" Foreground="OrangeRed" Text="{Binding ErrorMessage}"></TextBlock>
        <TextBlock IsVisible="{Binding SuccessMessageVissible}" Foreground="{DynamicResource AccentButtonBackground}" Text="{Binding SuccessMessage}"></TextBlock>
    </Grid>
    
</UserControl>
