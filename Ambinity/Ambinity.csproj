<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DefineConstants>$(DefineConstants);ENABLE_XAML_HOT_RELOAD</DefineConstants>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Condition="$(DefineConstants.Contains(ENABLE_XAML_HOT_RELOAD))" Include="Avalonia.Markup.Xaml.Loader" Version="11.1.0-beta1" />
		<PackageReference Condition="$(DefineConstants.Contains(ENABLE_XAML_HOT_RELOAD))" Include="HotAvalonia" Version="1.1.1" />
		<PackageReference Include="HotAvalonia.Extensions" Version="1.1.1" PrivateAssets="All" />
	</ItemGroup>
	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
		<AvaloniaResource Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.1.0-beta1" />
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="11.0.6" />
		<PackageReference Include="Avalonia.Controls.PanAndZoom" Version="11.0.0.3" />
		<PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
		<PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.1.0-beta1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
		<!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
		<PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.0.10" />
		<PackageReference Include="Avalonia.Xaml.Behaviors" Version="11.1.0-beta1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="FluentAvaloniaUI" Version="2.1.0-preview4" />
		<PackageReference Include="HotAvalonia" Version="1.1.1" />
		<PackageReference Include="HotAvalonia.Extensions" Version="1.1.1" />
		<PackageReference Include="Live.Avalonia" Version="1.4.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0-preview.5.24306.7" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="ScreenCapture.NET" Version="2.0.4" />
		<PackageReference Include="ScreenCapture.NET.DX11" Version="2.0.4" />
		<PackageReference Include="Serilog" Version="4.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0-dev-00979" />
		<PackageReference Include="SkiaSharp" Version="3.0.0-preview.3.1" />
		<PackageReference Include="System.Drawing.Common" Version="9.0.0-preview.5.24306.5" />
		<PackageReference Include="System.IO.Ports" Version="9.0.0-preview.5.24306.7" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\AmbinityCore\AmbinityCore.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <UpToDateCheckInput Remove="Styling\ControlsGalleryStyles.axaml" />
	  <UpToDateCheckInput Remove="Styling\Resources.axaml" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Services\" />
	</ItemGroup>

	<ItemGroup>
	  <AdditionalFiles Include="Views\Screens\Dashboard\DashboardDeviceView.axaml" />
	  <AdditionalFiles Include="Views\Screens\Dashboard\DashboardView.axaml" />
	  <AdditionalFiles Include="Views\Screens\DeviceControl\DeviceControlView.axaml" />
	  <AdditionalFiles Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
	  <AvaloniaXaml Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="obj\**" />
	  <Compile Update="Views\Screens\CaptureEngine\ScreenPreview.axaml.cs">
	    <DependentUpon>ScreenPreview.axaml</DependentUpon>
	    <SubType>Code</SubType>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="obj\**" />
	</ItemGroup>
	
</Project>
