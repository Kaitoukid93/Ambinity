<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ambinity.App"
             xmlns:local="using:Ambinity"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:converters ="clr-namespace:AmbinityCore.Converters;assembly=AmbinityCore"
             RequestedThemeVariant="Dark">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.Styles>
            <sty:FluentAvaloniaTheme PreferUserAccentColor="True" />
            <StyleInclude Source="avares://Ambinity/Styles/Ambinity.axaml" />
    </Application.Styles>
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Views/GeometryCollection.axaml" />
                <ResourceInclude Source="/Views/Generic.axaml"></ResourceInclude>
                <ResourceDictionary>
                    <converters:StaticResourceConverter x:Key="ResourceConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>