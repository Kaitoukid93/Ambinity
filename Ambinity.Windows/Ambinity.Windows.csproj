<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
        <AssemblyVersion>6.0.6</AssemblyVersion>
        <FileVersion>6.0.6</FileVersion>
        <InformationalVersion>6.0.6</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
        <AvaloniaResource Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.2.7" />
        <PackageReference Include="Avalonia.Desktop" Version="11.2.7" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.7" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.7" />
        <!--Condition
        below is needed to remove Avalonia.Diagnostics package from build output in Release
        configuration.-->
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics"
            Version="11.2.7" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
        <PackageReference Include="FluentAvaloniaUI" Version="2.2.0" />
        <PackageReference Include="HotAvalonia.Extensions" Version="3.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Live.Avalonia" Version="1.4.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ambinity\Ambinity.csproj" />
    </ItemGroup>

    <ItemGroup>
        <UpToDateCheckInput Remove="Views\MainWindow.axaml" />
        <UpToDateCheckInput Remove="Assets\avalonia-logo.ico" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="scripts\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <Content Include="ExternalLibs\bass.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>bass.dll</Link>
        </Content>
        <Content Include="ExternalLibs\basswasapi.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>basswasapi.dll</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Content Include="obj\Debug\net8.0\Ambinity.B3F1E1E7.Up2Date" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.AssemblyInfoInputs.cache" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.assets.cache" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.csproj.AssemblyReference.cache" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.csproj.CoreCompileInputs.cache" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.csproj.FileListAbsolute.txt" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.genruntimeconfig.cache" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.sourcelink.json" />
        <Content Include="obj\Debug\net8.0\apphost.exe" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="obj\Debug\net8.0\Ambinity.B3F1E1E7.Up2Date" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.csproj.CoreCompileInputs.cache" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.csproj.FileListAbsolute.txt" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.genruntimeconfig.cache" />
        <Content Include="obj\Debug\net8.0\Ambinity.Windows.sourcelink.json" />
        <Content Include="obj\Debug\net8.0\apphost.exe" />
        <Content Include="obj\Debug\net8.0\Avalonia\Ambinity.Windows.dll" />
        <Content Include="obj\Debug\net8.0\Avalonia\Ambinity.Windows.pdb" />
        <Content Include="obj\Debug\net8.0\Avalonia\references" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaXaml Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Services\" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Scripts\update.ps1" />
    </ItemGroup>
</Project>
