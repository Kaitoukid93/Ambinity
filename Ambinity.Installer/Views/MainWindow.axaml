<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ambinity.Installer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        ExtendClientAreaToDecorationsHint="True"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="800"
        Height="450"
        CanResize="False"
        xmlns:viewModels="clr-namespace:Ambinity.Installer.ViewModels"
        x:DataType="viewModels:MainWindowViewModel"
        WindowStartupLocation="CenterScreen"
        x:Class="Ambinity.Installer.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Ambinity Installer">

    <!-- <TextBlock Text="{Binding Header}" FontSize="25" Margin="20" FontWeight="SemiBold" HorizontalAlignment="Left" -->
    <!--            VerticalAlignment="Top" /> -->
    <Grid ColumnDefinitions="Auto,*">
        <ContentControl Content="{Binding AmbinityImage}"></ContentControl>
        <Grid Column="1" RowDefinitions="*,20,Auto">
            <ContentControl Grid.Column="1" Margin="20,40,20,10" Content="{Binding CurrentView}"></ContentControl>
            <Grid Margin="20,0,20,20" Row="2">
 
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button IsVisible="{Binding !CurrentView.CanForward}"
                            Command="{Binding FinishCommand}"
                            Classes="accent"
                            Click="Button_OnClick"
                            Content="Finish">
                    </Button>
                    <Button IsVisible="{Binding CurrentView.CanBack}"
                            Command="{Binding BackCommand}"
                            Classes="accent"
                            Content="Back">
                    </Button>
                    <Button IsVisible="{Binding CurrentView.CanCancel}"
                            Command="{Binding CancelCommand}"
                            Content="Cancel">
                    </Button>
                    <Button Classes="accent" IsVisible="{Binding CurrentView.CanForward}"
                            Background="{DynamicResource AccentButtonBackground}"
                            Command="{Binding NextCommand}"
                            Content="{Binding NextButtonContent}">
                    </Button>

                </StackPanel>

            </Grid>
        </Grid>
    </Grid>

</Window>