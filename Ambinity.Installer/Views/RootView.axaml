<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:Ambinity.Installer.ViewModels"
             x:DataType="vm:RootViewModel"
             x:Class="Ambinity.Installer.Views.RootView">

    <Grid>
        <ContentControl  Content="{Binding CurrentInstallMode}"></ContentControl>
    </Grid>

</UserControl>