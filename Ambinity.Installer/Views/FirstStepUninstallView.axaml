<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:localize="clr-namespace:Ambinity.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:viewModels="clr-namespace:Ambinity.Installer.ViewModels"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:DataType="viewModels:FirstStepUninstallViewModel"
             x:Class="Ambinity.Installer.Views.FirstStepUninstallView">
    <Grid Margin="20,0" RowDefinitions="Auto,20,*">
        <StackPanel Spacing="5">
            <TextBlock Text="{Binding Header}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
            <TextBlock MaxWidth="500" TextWrapping="Wrap" HorizontalAlignment="Left" Text="{Binding SubHeader}"
                       FontSize="13" Foreground="{DynamicResource ButtonForegroundDisabled}">
            </TextBlock>
        </StackPanel>
        <Grid Grid.Row="2">
            <ui:InfoBar HorizontalAlignment="Stretch" Severity="{localize:Loc Warning.InforBar.Title}" Title="{localize:Loc Warning.InforBar.Title}" IsClosable="False"
                Message="You are about to remove Ambinity from your computer, click Next to select uninstall options" IsOpen="True" />

        </Grid>
    </Grid>
</UserControl>
