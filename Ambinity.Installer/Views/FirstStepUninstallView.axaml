<UserControl
    x:Class="Ambinity.Installer.Views.FirstStepUninstallView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localize="clr-namespace:Ambinity.Installer.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:viewModels="clr-namespace:Ambinity.Installer.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="viewModels:FirstStepUninstallViewModel"
    mc:Ignorable="d">
    <Grid Margin="20,0" RowDefinitions="Auto,20,*">
        <StackPanel Spacing="5">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="25"
                FontWeight="SemiBold"
                Text="{Binding Header}" />
            <TextBlock
                MaxWidth="500"
                HorizontalAlignment="Left"
                FontSize="13"
                Foreground="{DynamicResource ButtonForegroundDisabled}"
                Text="{Binding SubHeader}"
                TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="2">
            <ui:InfoBar
                Title="{localize:Loc Warning.InforBar.Title}"
                HorizontalAlignment="Stretch"
                IsClosable="False"
                IsOpen="True"
                Message="You are about to remove Ambinity from your computer, click Next to select uninstall options"
                Severity="Warning" />

        </Grid>
    </Grid>
</UserControl>
